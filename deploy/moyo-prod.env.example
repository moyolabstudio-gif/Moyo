# Example environment file for a service manager/container.
# Spring Boot does NOT automatically load this file by itself.
# Do not place real secrets in Git.

# MOYO production environment example
# Copy values into your server/service environment. Do not commit real values.

SPRING_PROFILES_ACTIVE=prod

MOYO_DB_URL=jdbc:oracle:thin:@//YOUR_DB_HOST:1521/YOUR_SERVICE
MOYO_DB_USERNAME=YOUR_DB_USER
MOYO_DB_PASSWORD=YOUR_DB_PASSWORD

MOYO_MAIL_HOST=smtp.gmail.com
MOYO_MAIL_PORT=587
MOYO_MAIL_USERNAME=YOUR_SMTP_ACCOUNT
MOYO_MAIL_PASSWORD=YOUR_SMTP_APP_PASSWORD
MOYO_MAIL_FROM=YOUR_FROM_ADDRESS

MOYO_HOLIDAY_SERVICE_KEY=YOUR_PUBLIC_DATA_PORTAL_SERVICE_KEY

MOYO_WORKSPACE_UPLOAD_DIR=/opt/moyo/data/workspace
MOYO_CONTENT_FILE_DIR=/opt/moyo/data/content-files
MOYO_LOG_DIR=/opt/moyo/logs

# Usually leave empty because MOYO JSP + API is same-origin.
# If needed, comma-separate exact trusted origins. Never use "*".
MOYO_ALLOWED_ORIGINS=

# Optional tuning
MOYO_CONTENT_FILE_MAX_BYTES=20971520
MOYO_LOGIN_MAX_FAILURES=5
MOYO_LOGIN_LOCK_MINUTES=15
MOYO_LOGIN_IP_WINDOW_MINUTES=10
MOYO_LOGIN_IP_MAX_FAILURES=20
MOYO_LOGIN_IP_BLOCK_MINUTES=10
MOYO_EMAIL_CODE_EXPIRY_MINUTES=5
MOYO_EMAIL_RESEND_COOLDOWN_SECONDS=60
MOYO_EMAIL_MAX_VERIFY_FAILURES=5
MOYO_EMAIL_SEND_WINDOW_MINUTES=30
MOYO_EMAIL_MAX_SENDS_PER_WINDOW=5
MOYO_EMAIL_VERIFIED_VALID_MINUTES=30

MOYO_BOARD_UPLOAD_DIR=/srv/moyo/uploads/board/
MOYO_NOTE_UPLOAD_DIR=/srv/moyo/uploads/note/
MOYO_NOTE_EDITOR_UPLOAD_DIR=/srv/moyo/uploads/note-editor/
MOYO_PHOTO_UPLOAD_DIR=/srv/moyo/uploads/photos/

MOYO_USER_PROFILE_UPLOAD_DIR=/srv/moyo/uploads/users/
MOYO_BOARD_EDITOR_UPLOAD_DIR=/srv/moyo/uploads/board-editor/
MOYO_POLL_UPLOAD_DIR=/srv/moyo/uploads/polls/
