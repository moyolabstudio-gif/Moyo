<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%--
  MOYO 공통 메인 셸
  mainShellMode: WORKSPACE | GROUP_PROJECT | PERSONAL_PROJECT
  화면 골격은 한 벌만 유지하고 모드별 차이는 슬롯과 노출 옵션으로 제어한다.
--%>
<c:if test="${empty mainShellMode}">
    <c:set var="mainShellMode" value="WORKSPACE" />
</c:if>
<c:set var="isWorkspaceShell" value="${mainShellMode eq 'WORKSPACE'}" />
<c:set var="isProjectShell" value="${mainShellMode eq 'GROUP_PROJECT' or mainShellMode eq 'PERSONAL_PROJECT'}" />
<c:set var="renderMainDashboard" value="${(isWorkspaceShell and isWorkspaceMember) or isProjectShell}" />

<div class="${isWorkspaceShell ? 'container' : ''} workspace-community-container moyo-main-shell
            ${isWorkspaceShell ? 'moyo-main-shell--workspace' : 'moyo-main-shell--project'}
            ${mainShellMode eq 'PERSONAL_PROJECT' ? 'moyo-main-shell--personal-project' : ''}
            ${mainShellMode eq 'GROUP_PROJECT' ? 'moyo-main-shell--group-project' : ''}"
     data-main-shell-mode="${mainShellMode}">

    <%@ include file="/WEB-INF/views/common/commonMainHero.jspf" %>

            <c:if test="${isWorkspaceShell and not isWorkspaceMember}">
                <section class="workspace-rejoin-card" aria-label="그룹 참여 안내">
                    <div class="workspace-rejoin-copy">
                        <span class="workspace-rejoin-kicker">그룹 참여</span>
                        <c:choose>
                            <c:when test="${joinRequestStatus eq 'PENDING'}">
                                <h2>참여 요청을 보냈습니다.</h2>
                                <p>관리자의 승인을 기다리고 있습니다.</p>
                            </c:when>
                            <c:when test="${joinRequestStatus eq 'APPROVED'}">
                                <h2>참여 요청이 승인되었습니다.</h2>
                                <p>그룹 프로필 설정을 완료하면 참여가 완료됩니다.</p>
                            </c:when>
                            <c:when test="${workspace.joinType eq 'OPEN'}">
                                <h2><c:out value="${workspace.wsName}"/>에 참여해볼까요?</h2>
                                <p>그룹 프로필을 설정하면 바로 멤버로 참여할 수 있습니다.</p>
                            </c:when>
                            <c:otherwise>
                                <h2><c:out value="${workspace.wsName}"/>에 참여해볼까요?</h2>
                                <p>참여 요청을 보내면 그룹 관리자 승인 후 참여할 수 있습니다.</p>
                            </c:otherwise>
                        </c:choose>
                        <span class="workspace-rejoin-member-count">현재 멤버 <strong><c:out value="${memberCount}"/></strong>명</span>
                    </div>
                    <div class="workspace-rejoin-actions">
                        <c:choose>
                            <c:when test="${joinRequestStatus eq 'PENDING'}">
                                <button type="button" id="workspaceCancelRequestBtn" class="workspace-rejoin-secondary">참여 요청 취소</button>
                            </c:when>
                            <c:when test="${joinRequestStatus eq 'APPROVED'}">
                                <a class="workspace-rejoin-primary" href="${pageContext.request.contextPath}/requests">참여 완료하기</a>
                            </c:when>
                            <c:when test="${workspace.joinType eq 'OPEN'}">
                                <button type="button" id="workspaceOpenJoinBtn" class="workspace-rejoin-primary">참여하기</button>
                            </c:when>
                            <c:otherwise>
                                <button type="button" id="workspaceRequestJoinBtn" class="workspace-rejoin-primary">참여 요청</button>
                            </c:otherwise>
                        </c:choose>
                    </div>
                </section>
            </c:if>



    <c:if test="${isWorkspaceShell and isWorkspaceMember}">
            <c:if test="${isWorkspaceAdmin and empty projectOverview and memberList.size() le 1}">
                <section class="workspace-start-guide" aria-label="그룹 시작 안내">
                    <div class="workspace-start-guide-copy">
                        <span class="workspace-start-guide-icon">✨</span>
                        <div>
                            <strong>그룹을 만들었어요.</strong>
                            <p>멤버를 초대하거나 첫 프로젝트를 만들어 협업을 시작해보세요.</p>
                        </div>
                    </div>
                    <div class="workspace-start-guide-actions">
                        <button type="button" class="workspace-start-btn is-invite" onclick="openInviteModal()">멤버 초대</button>
                        <a class="workspace-start-btn is-project" href="${pageContext.request.contextPath}/project/create?wsId=${workspace.wsId}">프로젝트 만들기</a>
                    </div>
                </section>
            </c:if>

    </c:if>

    <c:if test="${isProjectShell}">
        <%@ include file="/WEB-INF/views/project/projectTimelineMainSlot.jspf" %>
    </c:if>

    <c:if test="${renderMainDashboard}">
        <%--
          본문/사이드바 DOM은 모든 화면에서 동일하게 유지한다.
          기존 화면별 CSS 호환 클래스는 같은 요소에 함께 두고,
          실제 모드 차이는 최상위 moyo-main-shell--* 클래스와 슬롯 조건으로 제어한다.
        --%>
        <div class="moyo-main-shell__body moyo-main-dashboard workspace-dashboard ${isWorkspaceShell ? 'dashboard-container' : ''} ${isProjectShell ? 'project-dashboard-layout' : ''}">
            <main class="moyo-main-shell__main moyo-main-dashboard__main workspace-main-content ${isWorkspaceShell ? 'main-content' : ''} ${isProjectShell ? 'project-main-content' : ''}"
                  aria-label="메인 본문">

                <c:if test="${isWorkspaceShell or showProjectGroupWidgets}">
                    <%@ include file="/WEB-INF/views/common/commonCommunityWidgets.jspf" %>
                </c:if>

                <%@ include file="/WEB-INF/views/common/commonContentWidgets.jspf" %>

                <c:choose>
                    <c:when test="${isWorkspaceShell}">
                    <section class="ws-card workspace-project-shortcut-section workspace-project-quick-widget moyo-dashboard-slot moyo-dashboard-slot--scope moyo-scope-widget moyo-scope-widget--workspace-projects" data-dashboard-widget="workspace-projects">
                        <c:set var="scheduledCount" value="0" />
                        <c:set var="progressCount" value="0" />
                        <c:set var="completedCount" value="0" />
                        <c:forEach var="project" items="${projectOverview}">
                            <c:choose>
                                <c:when test="${project.PROJECT_STATUS eq 'SCHEDULED'}">
                                    <c:set var="scheduledCount" value="${scheduledCount + 1}" />
                                </c:when>
                                <c:when test="${project.PROJECT_STATUS eq 'COMPLETED'}">
                                    <c:set var="completedCount" value="${completedCount + 1}" />
                                </c:when>
                                <c:otherwise>
                                    <c:set var="progressCount" value="${progressCount + 1}" />
                                </c:otherwise>
                            </c:choose>
                        </c:forEach>
                        <c:set var="totalProjectCount" value="${scheduledCount + progressCount + completedCount}" />

                        <div class="workspace-project-quick-head">
                            <div class="workspace-project-quick-heading">
                                <div class="workspace-project-quick-title">
                                    <h3>🧭 프로젝트 바로가기</h3>
                                    <c:if test="${totalProjectCount gt 0}">
                                        <span class="workspace-project-quick-total">${totalProjectCount}</span>
                                    </c:if>
                                </div>
                                <p>진행 중인 프로젝트를 확인하고 바로 입장할 수 있어요.</p>
                            </div>
                            <div class="workspace-project-quick-actions">
                                <a class="workspace-project-quick-more"
                                   href="${pageContext.request.contextPath}/project/list?wsId=${workspace.wsId}">더보기</a>
                            </div>
                        </div>

                        <c:if test="${totalProjectCount gt 0}">
                            <div class="workspace-project-quick-toolbar">
                                <div class="workspace-project-quick-summary" aria-label="프로젝트 상태 요약">
                                    <a class="workspace-project-quick-summary-item is-progress"
                                       href="${pageContext.request.contextPath}/project/list?wsId=${workspace.wsId}&amp;status=IN_PROGRESS">
                                        <span>진행 중</span><strong>${progressCount}</strong>
                                    </a>
                                    <a class="workspace-project-quick-summary-item is-scheduled"
                                       href="${pageContext.request.contextPath}/project/list?wsId=${workspace.wsId}&amp;status=SCHEDULED">
                                        <span>예정</span><strong>${scheduledCount}</strong>
                                    </a>
                                    <a class="workspace-project-quick-summary-item is-completed"
                                       href="${pageContext.request.contextPath}/project/list?wsId=${workspace.wsId}&amp;status=COMPLETED">
                                        <span>완료</span><strong>${completedCount}</strong>
                                    </a>
                                </div>
                                <c:if test="${isWorkspaceAdmin and workspace.status eq 'ACTIVE'}">
                                    <a class="workspace-project-create-btn workspace-project-quick-create"
                                       href="${pageContext.request.contextPath}/project/create?wsId=${workspace.wsId}">+ 프로젝트 생성</a>
                                </c:if>
                            </div>
                        </c:if>

                        <c:choose>
                            <c:when test="${totalProjectCount eq 0}">
                                <div class="workspace-project-empty-start workspace-project-quick-empty">
                                    <div class="workspace-project-empty-icon">🧭</div>
                                    <div class="workspace-project-empty-copy">
                                        <strong>아직 프로젝트가 없습니다.</strong>
                                        <span>첫 프로젝트를 만들면 업무와 일정을 프로젝트 단위로 관리할 수 있습니다.</span>
                                        <c:if test="${isWorkspaceAdmin and workspace.status eq 'ACTIVE'}">
                                            <a class="workspace-feature-empty-action workspace-project-empty-link"
                                               href="${pageContext.request.contextPath}/project/create?wsId=${workspace.wsId}">첫 프로젝트 생성</a>
                                        </c:if>
                                    </div>
                                </div>
                            </c:when>
                            <c:when test="${progressCount eq 0}">
                                <a class="workspace-project-quick-no-progress"
                                   href="${pageContext.request.contextPath}/project/list?wsId=${workspace.wsId}">
                                    <strong>진행 중인 프로젝트가 없습니다.</strong>
                                    <span>예정 및 완료 프로젝트는 전체 목록에서 확인하세요.</span>
                                    <em>프로젝트 목록 보기 →</em>
                                </a>
                            </c:when>
                            <c:otherwise>
                                <div class="workspace-project-quick-list count-${progressCount}">
                                    <c:forEach var="project" items="${projectOverview}">
                                        <c:if test="${project.PROJECT_STATUS ne 'SCHEDULED'
                                                    and project.PROJECT_STATUS ne 'COMPLETED'}">
                                            <a class="workspace-project-quick-card${project.ACCESS_STATE eq 'LOCKED' ? ' is-locked' : ''}${project.ACCESS_STATE eq 'READ_ONLY' ? ' is-read-only' : ''}"
                                               <c:choose>
                                                   <c:when test="${project.ACCESS_STATE eq 'LOCKED'}">aria-disabled="true" tabindex="0"</c:when>
                                                   <c:otherwise>href="${pageContext.request.contextPath}/project/main?projId=${project.PROJ_ID}&amp;wsId=${workspace.wsId}"</c:otherwise>
                                               </c:choose>>
                                                <span class="workspace-project-quick-accent" aria-hidden="true"></span>

                                                <div class="workspace-project-quick-card-main">
                                                <div class="workspace-project-quick-badges">
                                                    <span class="workspace-project-quick-status">진행 중</span>
                                                    <span class="workspace-project-quick-type">
                                                        <i class="fa-solid fa-${empty project.PROJ_ICON ? 'shapes' : project.PROJ_ICON}" aria-hidden="true"></i>
                                                        <c:choose>
                                                            <c:when test="${project.PROJ_TYPE eq 'WORK' or project.PROJ_TYPE eq '업무'}">업무</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'DEVELOPMENT' or project.PROJ_TYPE eq '개발'}">개발</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'PLANNING' or project.PROJ_TYPE eq '기획'}">기획</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'DESIGN' or project.PROJ_TYPE eq '디자인'}">디자인</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'STUDY' or project.PROJ_TYPE eq '스터디' or project.PROJ_TYPE eq '공부'}">스터디</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'EXAM' or project.PROJ_TYPE eq '시험'}">시험</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'TRAVEL' or project.PROJ_TYPE eq '여행'}">여행</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'MEETING' or project.PROJ_TYPE eq '회의'}">회의</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'GATHERING' or project.PROJ_TYPE eq '모임'}">모임</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'EVENT' or project.PROJ_TYPE eq '행사'}">행사</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'EXERCISE' or project.PROJ_TYPE eq '운동'}">운동</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'HOBBY' or project.PROJ_TYPE eq '취미'}">취미</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'LIFE' or project.PROJ_TYPE eq '생활'}">생활</c:when>
                                                            <c:when test="${project.PROJ_TYPE eq 'RECORD' or project.PROJ_TYPE eq '기록'}">기록</c:when>
                                                            <c:otherwise>기타</c:otherwise>
                                                        </c:choose>
                                                    </span>
                                                    <span class="workspace-project-quick-access is-${project.ACCESS_STATE}">
                                                        <c:choose>
                                                            <c:when test="${project.ACCESS_STATE eq 'MANAGE'}">관리</c:when>
                                                            <c:when test="${project.ACCESS_STATE eq 'PARTICIPANT'}">참여 중</c:when>
                                                            <c:when test="${project.ACCESS_STATE eq 'READ_ONLY'}">읽기 전용</c:when>
                                                            <c:otherwise>참여자 전용</c:otherwise>
                                                        </c:choose>
                                                    </span>

                                                    <c:if test="${project.DELETE_STATUS eq 'DELETE_PENDING'}">
                                                        <span class="workspace-project-delete-pending">
                                                            <span class="workspace-project-delete-pending-badge">삭제 예정</span>
                                                            <span class="workspace-project-delete-pending-date">
                                                                <c:out value="${project.DELETE_DEADLINE_DATE}"/>
                                                            </span>
                                                        </span>
                                                    </c:if>

                                                    <span class="workspace-project-quick-open-icon${project.ACCESS_STATE eq 'LOCKED' ? ' is-locked' : ''}" aria-hidden="true">
                                                        <c:choose>
                                                            <c:when test="${project.ACCESS_STATE eq 'LOCKED'}">
                                                                <i class="fa-solid fa-lock"></i>
                                                            </c:when>
                                                            <c:otherwise>
                                                                <i class="fa-solid fa-arrow-right"></i>
                                                            </c:otherwise>
                                                        </c:choose>
                                                    </span>
                                                </div>

                                                <h4>
                                                    <c:choose>
                                                        <c:when test="${not empty project.PROJ_NAME}">${project.PROJ_NAME}</c:when>
                                                        <c:when test="${not empty project.projName}">${project.projName}</c:when>
                                                        <c:otherwise>프로젝트</c:otherwise>
                                                    </c:choose>
                                                </h4>

                                                <c:if test="${not empty project.PROJ_DESC}">
                                                    <p class="workspace-project-quick-desc">${project.PROJ_DESC}</p>
                                                </c:if>

                                                </div>

                                                <div class="workspace-project-quick-card-side">
                                                <dl class="workspace-project-quick-info">
                                                    <div class="workspace-project-quick-period">
                                                        <dt>기간</dt>
                                                        <dd>
                                                            <c:choose>
                                                                <c:when test="${project.PERIOD_ENABLED_YN eq 'Y'}">
                                                                    <span class="workspace-project-quick-period-date">${project.START_DATE} <span>~</span> ${project.END_DATE}</span>
                                                                    <c:if test="${not empty project.DDAY and project.DDAY ge 0}">
                                                                        <span class="workspace-project-quick-dday" aria-label="${project.DDAY eq 0 ? '프로젝트 종료일입니다' : '프로젝트 종료까지 '.concat(project.DDAY).concat('일')}">
                                                                            <c:choose>
                                                                                <c:when test="${project.DDAY eq 0}">D-Day</c:when>
                                                                                <c:otherwise>D-${project.DDAY}</c:otherwise>
                                                                            </c:choose>
                                                                        </span>
                                                                    </c:if>
                                                                </c:when>
                                                                <c:otherwise>기간 없음</c:otherwise>
                                                            </c:choose>
                                                        </dd>
                                                    </div>
                                                    <div>
                                                        <dt>팀장</dt>
                                                        <dd class="workspace-project-quick-leader">
                                                            <c:choose>
                                                                <c:when test="${not empty project.LEADER_NAME}">
                                                                    <span class="workspace-project-quick-leader-avatar${not empty project.LEADER_PROFILE_IMAGE_PATH ? ' has-image' : ' is-default'}" aria-hidden="true">
                                                                        <c:if test="${not empty project.LEADER_PROFILE_IMAGE_PATH}">
                                                                            <img src="<c:out value='${project.LEADER_PROFILE_IMAGE_PATH}'/>" alt=""
                                                                                 onerror="this.parentElement.classList.remove('has-image'); this.parentElement.classList.add('is-default'); this.remove();">
                                                                        </c:if>
                                                                        <span class="workspace-project-quick-leader-initial"><c:out value="${fn:substring(project.LEADER_NAME,0,1)}"/></span>
                                                                    </span>
                                                                    <span class="workspace-project-quick-leader-name"><c:out value="${project.LEADER_NAME}"/></span>
                                                                </c:when>
                                                                <c:otherwise>-</c:otherwise>
                                                            </c:choose>
                                                        </dd>
                                                    </div>
                                                    <div>
                                                        <dt>인원</dt>
                                                        <dd>
                                                            <c:choose>
                                                                <c:when test="${not empty project.MEMBER_COUNT}">${project.MEMBER_COUNT}명</c:when>
                                                                <c:when test="${not empty project.memberCount}">${project.memberCount}명</c:when>
                                                                <c:otherwise>-</c:otherwise>
                                                            </c:choose>
                                                        </dd>
                                                    </div>
                                                </dl>

                                                <div class="workspace-project-quick-progress">
                                                    <div class="workspace-project-quick-progress-head">
                                                        <span>진행률</span>
                                                        <c:choose>
                                                            <c:when test="${project.TASK_TOTAL gt 0}">
                                                                <strong>${project.PROGRESS_PERCENT}%</strong>
                                                            </c:when>
                                                            <c:otherwise>
                                                                <strong class="is-empty">업무 없음</strong>
                                                            </c:otherwise>
                                                        </c:choose>
                                                    </div>
                                                    <c:if test="${project.TASK_TOTAL gt 0}">
                                                        <div class="workspace-project-quick-progress-track" aria-hidden="true">
                                                            <span style="width:${project.PROGRESS_PERCENT}%"></span>
                                                        </div>
                                                    </c:if>
                                                </div>
                                                </div>
                                            </a>
                                        </c:if>
                                    </c:forEach>
                                </div>
                            </c:otherwise>
                        </c:choose>
                    </section>
                    </c:when>
                    <c:when test="${isProjectShell}">
                        <%@ include file="/WEB-INF/views/project/projectTaskMainSlot.jspf" %>
                    </c:when>
                </c:choose>
            </main>

            <aside class="moyo-main-shell__side moyo-main-dashboard__side workspace-side-content ${isWorkspaceShell ? 'side-content' : ''} ${isProjectShell ? 'project-side-content' : ''}"
                   aria-label="메인 사이드 영역">
                <c:if test="${isWorkspaceShell or showProjectMiniCalendar}">
                    <%@ include file="/WEB-INF/views/common/commonMiniCalendar.jspf" %>
                </c:if>

                <%@ include file="/WEB-INF/views/common/commonMemberWidget.jspf" %>
            </aside>
        </div>
    </c:if>
</div>
