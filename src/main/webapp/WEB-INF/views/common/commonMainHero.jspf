<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%--
  MOYO 공통 메인 히어로
  - WORKSPACE / GROUP_PROJECT / PERSONAL_PROJECT 모두 동일한 DOM 구조를 사용한다.
  - 차이는 연결되는 데이터, avatar 내용, 메뉴 항목뿐이다.
--%>

<c:set var="heroIsWorkspace" value="${mainShellMode eq 'WORKSPACE'}" />
<c:set var="heroIsProject" value="${not heroIsWorkspace}" />

<c:choose>
    <c:when test="${heroIsWorkspace}">
        <c:set var="heroTitle" value="${workspace.wsName}" />
        <c:set var="heroDescription" value="${workspace.wsDescription}" />
        <c:set var="heroLinks" value="${workspaceLinks}" />
        <c:set var="heroDeletePending" value="${workspace.status eq 'DELETE_PENDING'}" />
        <c:set var="heroDeleteDeadline" value="${workspace.deleteDeadlineDate}" />
        <c:choose>
            <c:when test="${workspace.wsType eq 'ORGANIZATION'}"><c:set var="heroTypeLabel" value="회사 · 조직" /></c:when>
            <c:when test="${workspace.wsType eq 'TEAM'}"><c:set var="heroTypeLabel" value="팀 · 협업" /></c:when>
            <c:when test="${workspace.wsType eq 'STUDY'}"><c:set var="heroTypeLabel" value="스터디 · 연구" /></c:when>
            <c:when test="${workspace.wsType eq 'CLUB'}"><c:set var="heroTypeLabel" value="동아리 · 취미" /></c:when>
            <c:when test="${workspace.wsType eq 'LIFE'}"><c:set var="heroTypeLabel" value="가족 · 생활" /></c:when>
            <c:when test="${workspace.wsType eq 'ETC'}"><c:set var="heroTypeLabel" value="기타" /></c:when>
            <c:otherwise><c:set var="heroTypeLabel" value="모임 · 커뮤니티" /></c:otherwise>
        </c:choose>
        <c:set var="heroWorkspaceJoinStatusLabel" value="" />
        <c:set var="heroWorkspaceJoinStatusClass" value="" />
        <c:if test="${workspace.joinType eq 'OPEN'}">
            <c:set var="heroWorkspaceJoinStatusLabel" value="자유 참여" />
            <c:set var="heroWorkspaceJoinStatusClass" value="is-open" />
        </c:if>
        <c:if test="${workspace.joinType eq 'INVITE'}">
            <c:set var="heroWorkspaceJoinStatusLabel" value="초대 전용" />
            <c:set var="heroWorkspaceJoinStatusClass" value="is-invite" />
        </c:if>
    </c:when>
    <c:otherwise>
        <c:set var="heroTitle" value="${projectDetail.projName}" />
        <c:set var="heroDescription" value="${projectDetail.projDesc}" />
        <c:set var="heroLinks" value="${projectLinks}" />
        <c:set var="heroDeletePending" value="${projectDetail.status eq 'DELETE_PENDING'}" />
        <c:set var="heroDeleteDeadline" value="${projectDetail.deleteDeadlineDate}" />
        <c:set var="heroTypeLabel" value="${isPersonalProject ? '개인 프로젝트' : '그룹 프로젝트'}" />
        <c:set var="projectMemberCount" value="${fn:length(projectMemberList)}" />
        <c:set var="projectRoleLabel" value="그룹 멤버" />
        <c:choose>
            <c:when test="${isPersonalProject}"><c:set var="projectRoleLabel" value="소유자" /></c:when>
            <c:when test="${currentProjectRole eq 'READ_ONLY'}"><c:set var="projectRoleLabel" value="읽기 전용" /></c:when>
            <c:when test="${currentProjectRole eq 'LEADER' or currentProjectRole eq 'OWNER' or currentProjectRole eq 'PM'}"><c:set var="projectRoleLabel" value="팀장" /></c:when>
            <c:when test="${currentProjectRole eq 'ADMIN'}"><c:set var="projectRoleLabel" value="관리자" /></c:when>
            <c:when test="${currentProjectRole eq 'MEMBER'}"><c:set var="projectRoleLabel" value="멤버" /></c:when>
        </c:choose>

        <%-- 생성/설정과 동일한 15종 프로젝트 유형 체계. 아이콘은 DB의 PROJ_ICON을 우선 사용한다. --%>
        <c:set var="projectTypeKey" value="${empty projectDetail.projType ? projectDetail.projCategory : projectDetail.projType}" />
        <c:set var="projectTypeLabel" value="기타" />
        <c:choose>
            <c:when test="${projectTypeKey eq 'WORK' or projectTypeKey eq '업무'}"><c:set var="projectTypeLabel" value="업무" /></c:when>
            <c:when test="${projectTypeKey eq 'DEVELOPMENT' or projectTypeKey eq '개발'}"><c:set var="projectTypeLabel" value="개발" /></c:when>
            <c:when test="${projectTypeKey eq 'PLANNING' or projectTypeKey eq '기획'}"><c:set var="projectTypeLabel" value="기획" /></c:when>
            <c:when test="${projectTypeKey eq 'DESIGN' or projectTypeKey eq '디자인'}"><c:set var="projectTypeLabel" value="디자인" /></c:when>
            <c:when test="${projectTypeKey eq 'STUDY' or projectTypeKey eq '스터디' or projectTypeKey eq '공부' or projectTypeKey eq '학습·연구' or projectTypeKey eq '학습 · 연구'}"><c:set var="projectTypeLabel" value="스터디" /></c:when>
            <c:when test="${projectTypeKey eq 'EXAM' or projectTypeKey eq '시험'}"><c:set var="projectTypeLabel" value="시험" /></c:when>
            <c:when test="${projectTypeKey eq 'TRAVEL' or projectTypeKey eq '여행'}"><c:set var="projectTypeLabel" value="여행" /></c:when>
            <c:when test="${projectTypeKey eq 'MEETING' or projectTypeKey eq '회의' or projectTypeKey eq '미팅'}"><c:set var="projectTypeLabel" value="회의" /></c:when>
            <c:when test="${projectTypeKey eq 'GATHERING' or projectTypeKey eq '모임'}"><c:set var="projectTypeLabel" value="모임" /></c:when>
            <c:when test="${projectTypeKey eq 'EVENT' or projectTypeKey eq '행사' or projectTypeKey eq '모임·행사' or projectTypeKey eq '모임 · 행사'}"><c:set var="projectTypeLabel" value="행사" /></c:when>
            <c:when test="${projectTypeKey eq 'EXERCISE' or projectTypeKey eq '운동'}"><c:set var="projectTypeLabel" value="운동" /></c:when>
            <c:when test="${projectTypeKey eq 'HOBBY' or projectTypeKey eq '취미' or projectTypeKey eq '취미·창작' or projectTypeKey eq '취미 · 창작'}"><c:set var="projectTypeLabel" value="취미" /></c:when>
            <c:when test="${projectTypeKey eq 'LIFE' or projectTypeKey eq '생활' or projectTypeKey eq '생활·가정' or projectTypeKey eq '생활 · 가정'}"><c:set var="projectTypeLabel" value="생활" /></c:when>
            <c:when test="${projectTypeKey eq 'RECORD' or projectTypeKey eq '기록'}"><c:set var="projectTypeLabel" value="기록" /></c:when>
        </c:choose>
        <%-- 프로젝트 설정에서 저장한 PROJ_ICON을 히어로의 단일 아이콘 소스로 사용한다. --%>
        <c:set var="projectIconKey" value="${projectDetail.projIcon}" />
        <c:if test="${empty projectIconKey}">
            <c:choose>
                <c:when test="${projectTypeKey eq 'WORK'}"><c:set var="projectIconKey" value="briefcase" /></c:when>
                <c:when test="${projectTypeKey eq 'DEVELOPMENT'}"><c:set var="projectIconKey" value="code" /></c:when>
                <c:when test="${projectTypeKey eq 'PLANNING'}"><c:set var="projectIconKey" value="clipboard-list" /></c:when>
                <c:when test="${projectTypeKey eq 'DESIGN'}"><c:set var="projectIconKey" value="palette" /></c:when>
                <c:when test="${projectTypeKey eq 'STUDY'}"><c:set var="projectIconKey" value="book-open" /></c:when>
                <c:when test="${projectTypeKey eq 'EXAM'}"><c:set var="projectIconKey" value="graduation-cap" /></c:when>
                <c:when test="${projectTypeKey eq 'TRAVEL'}"><c:set var="projectIconKey" value="plane" /></c:when>
                <c:when test="${projectTypeKey eq 'MEETING'}"><c:set var="projectIconKey" value="comments" /></c:when>
                <c:when test="${projectTypeKey eq 'GATHERING'}"><c:set var="projectIconKey" value="user-group" /></c:when>
                <c:when test="${projectTypeKey eq 'EVENT'}"><c:set var="projectIconKey" value="calendar-days" /></c:when>
                <c:when test="${projectTypeKey eq 'EXERCISE'}"><c:set var="projectIconKey" value="dumbbell" /></c:when>
                <c:when test="${projectTypeKey eq 'HOBBY'}"><c:set var="projectIconKey" value="puzzle-piece" /></c:when>
                <c:when test="${projectTypeKey eq 'MUSIC'}"><c:set var="projectIconKey" value="music" /></c:when>
                <c:when test="${projectTypeKey eq 'LIFE'}"><c:set var="projectIconKey" value="house" /></c:when>
                <c:when test="${projectTypeKey eq 'RECORD'}"><c:set var="projectIconKey" value="note-sticky" /></c:when>
                <c:otherwise><c:set var="projectIconKey" value="shapes" /></c:otherwise>
            </c:choose>
        </c:if>
        <c:set var="heroTypeLabel" value="${projectTypeLabel}" />

        <c:set var="heroTaskTotal" value="${empty taskSummary.TOTAL ? 0 : taskSummary.TOTAL}" />
        <c:set var="heroTaskDone" value="${empty taskSummary.DONE_CNT ? 0 : taskSummary.DONE_CNT}" />
        <c:set var="heroProgressPercent" value="${heroTaskTotal gt 0 ? (heroTaskDone * 100 / heroTaskTotal) : 0}" />
    </c:otherwise>
</c:choose>
<%-- Hero quick actions reuse the same scope-aware destinations as the header. --%>
<c:choose>
    <c:when test="${heroIsWorkspace}">
        <c:set var="heroCalendarHref" value="${pageContext.request.contextPath}/calendar?scope=WS&amp;calendarContext=GROUP&amp;wsId=${workspace.wsId}" />
        <c:set var="heroNoteHref" value="${pageContext.request.contextPath}/note/list?scope=WS&amp;wsId=${workspace.wsId}" />
        <c:set var="heroPhotoHref" value="${pageContext.request.contextPath}/photo-album?scopeType=WORKSPACE&amp;scopeId=${workspace.wsId}" />
        <c:set var="heroFilesHref" value="${pageContext.request.contextPath}/group/files?wsId=${workspace.wsId}" />
    </c:when>
    <c:otherwise>
        <c:set var="heroCalendarHref" value="${pageContext.request.contextPath}/calendar?scope=PROJ&amp;calendarContext=PROJECT&amp;projectScope=PERSONAL&amp;projId=${projectDetail.projId}" />
        <c:if test="${not isPersonalProject}">
            <c:set var="heroCalendarHref" value="${pageContext.request.contextPath}/calendar?scope=PROJ&amp;calendarContext=PROJECT&amp;projectScope=GROUP&amp;wsId=${projectDetail.wsId}&amp;projId=${projectDetail.projId}" />
        </c:if>
        <c:set var="heroNoteHref" value="${pageContext.request.contextPath}/note/list?scope=PROJ&amp;projId=${projectDetail.projId}" />
        <c:set var="heroFilesHref" value="${pageContext.request.contextPath}/project/files?projId=${projectDetail.projId}" />
        <c:if test="${not empty projectDetail.wsId}">
            <c:set var="heroNoteHref" value="${heroNoteHref}&amp;wsId=${projectDetail.wsId}" />
            <c:set var="heroFilesHref" value="${heroFilesHref}&amp;wsId=${projectDetail.wsId}" />
        </c:if>
        <c:set var="heroPhotoHref" value="${pageContext.request.contextPath}/photo-album?scopeType=PROJECT&amp;scopeId=${projectDetail.projId}" />
    </c:otherwise>
</c:choose>

<div class="moyo-main-shell__hero moyo-main-hero${heroIsWorkspace ? '' : ' moyo-main-hero--project'}">
    <div class="moyo-main-hero__avatar${heroIsWorkspace ? (empty workspace.wsImagePath ? ' is-default' : ' has-image') : ' moyo-main-hero__avatar--project'}">
        <c:choose>
            <c:when test="${heroIsWorkspace}">
                <div class="moyo-main-hero__avatar-visual moyo-main-hero__avatar-visual--workspace${empty workspace.wsImagePath ? ' is-default' : ' has-image'}">
                    <c:if test="${not empty workspace.wsImagePath}">
                        <img src="<c:out value='${workspace.wsImagePath}'/>"
                             alt="<c:out value='${workspace.wsName}'/> 그룹 이미지"
                             onerror="this.hidden=true; this.parentElement.classList.add('is-default'); this.nextElementSibling.hidden=false;">
                    </c:if>
                    <span class="moyo-main-hero__avatar-fallback" aria-hidden="true" ${not empty workspace.wsImagePath ? 'hidden' : ''}>
                        <c:choose>
                            <c:when test="${not empty workspace.wsName}"><c:out value="${fn:toUpperCase(fn:substring(fn:trim(workspace.wsName), 0, 1))}"/></c:when>
                            <c:otherwise>G</c:otherwise>
                        </c:choose>
                    </span>
                </div>
            </c:when>
            <c:otherwise>
                <div class="moyo-main-hero__avatar-visual moyo-main-hero__avatar-visual--project"
                     role="img" aria-label="${projectTypeLabel} 프로젝트">
                    <span class="moyo-main-hero__avatar-icon"><i class="fa-solid fa-${projectIconKey}" aria-hidden="true"></i></span>
                </div>
            </c:otherwise>
        </c:choose>
    </div>

    <div class="moyo-main-hero__info">
        <div class="moyo-main-hero__eyebrow" aria-label="기본 정보">
            <span class="moyo-main-hero__type"><c:out value="${heroTypeLabel}"/></span>
            <span class="moyo-main-hero__divider" aria-hidden="true">·</span>
            <c:choose>
                <c:when test="${heroIsWorkspace}">
                    <span class="moyo-main-hero__meta-text">멤버 <c:out value="${memberCount}"/></span>
                    <c:if test="${not empty heroWorkspaceJoinStatusLabel}">
                        <span class="moyo-main-hero__divider" aria-hidden="true">·</span>
                        <span class="moyo-main-hero__status ${heroWorkspaceJoinStatusClass}"><c:out value="${heroWorkspaceJoinStatusLabel}"/></span>
                    </c:if>
                </c:when>
                <c:otherwise>
                    <span class="moyo-main-hero__meta-text"><c:out value="${isPersonalProject ? '개인 프로젝트' : '그룹 프로젝트'}"/></span>
                    <span class="moyo-main-hero__divider" aria-hidden="true">·</span>
                    <c:if test="${not isPersonalProject}">
                        <span class="moyo-main-hero__meta-text">멤버 <c:out value="${projectMemberCount}"/></span>
                        <span class="moyo-main-hero__divider" aria-hidden="true">·</span>
                    </c:if>
                    <span class="moyo-main-hero__meta-text moyo-main-hero__meta-text--strong"><c:out value="${projectRoleLabel}"/></span>
                </c:otherwise>
            </c:choose>
        </div>

        <h1 class="moyo-main-hero__title" title="<c:out value='${heroTitle}'/>"><c:out value="${heroTitle}"/></h1>

        <c:if test="${not empty fn:trim(heroDescription)}">
            <p class="moyo-main-hero__description"><c:out value="${heroDescription}"/></p>
        </c:if>

        <c:if test="${not empty heroLinks}">
            <div class="moyo-main-hero__content-line">
                <div class="moyo-main-hero__links" aria-label="외부 링크">
                    <c:forEach var="link" items="${heroLinks}">
                        <a href="<c:out value='${link.LINK_URL}'/>" target="_blank" rel="noopener noreferrer"
                           class="moyo-main-hero__link" title="<c:out value='${link.LINK_NAME}'/>">
                            <span class="moyo-main-hero__link-icon" aria-hidden="true">🔗</span>
                            <span class="moyo-main-hero__link-label"><c:out value="${link.LINK_NAME}"/></span>
                            <span class="moyo-main-hero__link-arrow" aria-hidden="true">↗</span>
                        </a>
                    </c:forEach>
                </div>
            </div>
        </c:if>

        <c:if test="${heroIsProject and currentProjectRole eq 'READ_ONLY'}">
            <div class="moyo-main-hero__project-summary" aria-label="프로젝트 상태">
                <span class="moyo-main-hero__project-summary-item is-read-only">
                    <i class="fa-regular fa-eye" aria-hidden="true"></i> 읽기 전용
                </span>
            </div>
        </c:if>
    </div>

    <div class="moyo-main-hero__side">
        <div class="moyo-main-hero__actions" aria-label="히어로 바로가기">
            <div class="moyo-main-hero__content-quick-wrap">
                <button type="button" class="moyo-main-hero__quick-action moyo-main-hero__content-trigger"
                        id="moyoHeroContentQuickTrigger" aria-label="콘텐츠 바로가기" title="콘텐츠 바로가기"
                        aria-haspopup="true" aria-expanded="false" aria-controls="moyoHeroContentQuickMenu"
                        onclick="toggleMoyoHeroContentQuickMenu(event)">
                    <span class="moyo-main-hero__four-grid-icon" aria-hidden="true">
                        <span></span><span></span><span></span><span></span>
                    </span>
                </button>
                <div class="moyo-main-hero__content-quick-menu" id="moyoHeroContentQuickMenu" role="menu" aria-label="콘텐츠 바로가기" hidden>
                    <a href="${heroCalendarHref}" class="moyo-main-hero__content-quick-item" role="menuitem" aria-label="캘린더" title="캘린더">
                        <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
                    </a>
                    <a href="${heroNoteHref}" class="moyo-main-hero__content-quick-item" role="menuitem" aria-label="노트" title="노트">
                        <i class="fa-regular fa-note-sticky" aria-hidden="true"></i>
                    </a>
                    <a href="${heroPhotoHref}" class="moyo-main-hero__content-quick-item" role="menuitem" aria-label="사진" title="사진">
                        <i class="fa-regular fa-images" aria-hidden="true"></i>
                    </a>
                    <a href="${heroFilesHref}" class="moyo-main-hero__content-quick-item" role="menuitem" aria-label="자료실" title="자료실">
                        <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                    </a>
                </div>
            </div>

            <c:choose>
                <c:when test="${heroIsWorkspace}">
                    <c:if test="${isWorkspaceAdmin}">
                        <div class="workspace-group-menu-wrap">
                            <button type="button" class="moyo-main-hero__quick-action moyo-main-hero__menu-trigger" id="workspaceGroupMenuTrigger"
                                    aria-label="그룹 설정 및 관리" title="설정" aria-haspopup="true" aria-expanded="false">
                                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                            </button>
                            <div class="workspace-group-menu" id="workspaceGroupMenu" hidden>
                                <a class="workspace-group-menu-item" href="${pageContext.request.contextPath}/workspace/settings?wsId=${workspace.wsId}">그룹 설정</a>
                                <a class="workspace-group-menu-item" href="${pageContext.request.contextPath}/workspace/settings?wsId=${workspace.wsId}&amp;tab=members">멤버 관리</a>
                                <button type="button" class="workspace-group-menu-item" onclick="openMyWorkspaceProfileFromMenu()">내 그룹 프로필</button>
                                <c:if test="${currentUserIsOwner}">
                                    <button type="button" class="workspace-group-menu-item" onclick="goToOwnerTransfer()">그룹장 권한 위임</button>
                                </c:if>
                                <button type="button" class="workspace-group-menu-item is-danger" onclick="leaveWorkspace()">그룹 탈퇴</button>
                            </div>
                        </div>
                    </c:if>
                </c:when>
                <c:otherwise>
                    <c:if test="${canManageProject}">
                        <div class="project-main-more">
                            <button type="button" id="projectMainMoreButton" class="moyo-main-hero__quick-action moyo-main-hero__menu-trigger"
                                    aria-label="프로젝트 설정 및 관리" title="설정" aria-expanded="false" aria-controls="projectMainMoreMenu"
                                    onclick="toggleProjectMainMoreMenu(event)">
                                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                            </button>
                            <div id="projectMainMoreMenu" class="project-main-more-menu" role="menu" hidden>
                                <button type="button" class="project-main-more-item" role="menuitem" onclick="goProjectSettings('basic')">프로젝트 설정</button>
                                <c:if test="${showProjectMembers}">
                                    <button type="button" class="project-main-more-item" role="menuitem" onclick="goProjectSettings('members')">멤버 관리</button>
                                </c:if>
                                <button type="button" class="project-main-more-item" role="menuitem" onclick="goProjectList()">프로젝트 목록</button>
                            </div>
                        </div>
                    </c:if>
                </c:otherwise>
            </c:choose>
        </div>

        <c:if test="${heroDeletePending}">
            <div class="moyo-main-hero__pending" role="status">
                <span class="moyo-main-hero__pending-badge">삭제 예정</span>
                <strong><c:out value="${heroDeleteDeadline}"/></strong>
            </div>
        </c:if>
    </div>
</div>

<script>
(function () {
    if (window.__moyoHeroContentQuickBound) return;
    window.__moyoHeroContentQuickBound = true;

    window.toggleMoyoHeroContentQuickMenu = function (event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        var trigger = document.getElementById('moyoHeroContentQuickTrigger');
        var menu = document.getElementById('moyoHeroContentQuickMenu');
        if (!trigger || !menu) return;

        var willOpen = menu.hidden;

        // The content launcher and the settings/management menu are mutually exclusive.
        // The launcher stops propagation so the legacy document click handlers cannot
        // close an already-open settings menu for us; close it explicitly here.
        if (willOpen) {
            if (typeof window.closeProjectMainMoreMenu === 'function') {
                window.closeProjectMainMoreMenu();
            }
            if (typeof window.setWorkspaceGroupMenuOpen === 'function') {
                window.setWorkspaceGroupMenuOpen(false);
            }
        }

        menu.hidden = !willOpen;
        trigger.setAttribute('aria-expanded', willOpen ? 'true' : 'false');

        if (willOpen) {
            window.requestAnimationFrame(function () {
                var rect = trigger.getBoundingClientRect();
                var menuRect = menu.getBoundingClientRect();
                var viewportPadding = 10;
                var gap = 8;
                var left = rect.right - menuRect.width;
                var top = rect.bottom + gap;

                if (left < viewportPadding) left = viewportPadding;
                if (left + menuRect.width > window.innerWidth - viewportPadding) {
                    left = window.innerWidth - menuRect.width - viewportPadding;
                }
                if (top + menuRect.height > window.innerHeight - viewportPadding) {
                    top = rect.top - menuRect.height - gap;
                }
                if (top < viewportPadding) top = viewportPadding;

                menu.style.setProperty('left', left + 'px', 'important');
                menu.style.setProperty('top', top + 'px', 'important');
                menu.style.setProperty('right', 'auto', 'important');
            });
        }
    };

    function closeMoyoHeroContentQuickMenu() {
        var trigger = document.getElementById('moyoHeroContentQuickTrigger');
        var menu = document.getElementById('moyoHeroContentQuickMenu');
        if (!trigger || !menu || menu.hidden) return;
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
    }
    window.closeMoyoHeroContentQuickMenu = closeMoyoHeroContentQuickMenu;

    // Capture the settings trigger before its legacy handler stops propagation.
    // This guarantees the two hero popovers never remain open at the same time.
    document.addEventListener('click', function (event) {
        if (event.target.closest('#projectMainMoreButton, #workspaceGroupMenuTrigger')) {
            closeMoyoHeroContentQuickMenu();
        }
    }, true);

    document.addEventListener('click', function (event) {
        var wrap = document.querySelector('.moyo-main-hero__content-quick-wrap');
        var trigger = document.getElementById('moyoHeroContentQuickTrigger');
        var menu = document.getElementById('moyoHeroContentQuickMenu');
        if (!wrap || !trigger || !menu || menu.hidden) return;
        if (!wrap.contains(event.target)) {
            closeMoyoHeroContentQuickMenu();
        }
    });

    window.addEventListener('resize', function () {
        var trigger = document.getElementById('moyoHeroContentQuickTrigger');
        var menu = document.getElementById('moyoHeroContentQuickMenu');
        if (!trigger || !menu || menu.hidden) return;
        closeMoyoHeroContentQuickMenu();
    });

    document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        var trigger = document.getElementById('moyoHeroContentQuickTrigger');
        var menu = document.getElementById('moyoHeroContentQuickMenu');
        if (!trigger || !menu || menu.hidden) return;
        closeMoyoHeroContentQuickMenu();
        trigger.focus();
    });
})();
</script>