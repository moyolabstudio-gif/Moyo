<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<c:choose>
    <c:when test="${mainShellMode eq 'WORKSPACE'}">
        <section class="moyo-member-widget workspace-side-card workspace-member-panel moyo-dashboard-slot"
                 data-member-scope="WORKSPACE" data-dashboard-widget="members" aria-labelledby="commonWorkspaceMemberTitle">
            <div class="moyo-member-widget__head moyo-widget-head project-member-head workspace-member-head">
                <div class="moyo-member-widget__title moyo-widget-title project-member-title workspace-member-title">
                    <span aria-hidden="true">👥</span>
                    <strong id="commonWorkspaceMemberTitle">그룹 멤버</strong>
                    <span id="workspaceMemberCount" class="moyo-member-widget__count moyo-widget-count project-member-count workspace-member-count">${memberList.size()}</span>
                </div>
                <div class="moyo-member-widget__actions workspace-member-head-actions">
                    <button type="button" class="moyo-member-widget__all-button"
                            data-workspace-member-all-button
                            aria-haspopup="dialog">전체 보기</button>
                    <c:if test="${isWorkspaceAdmin}">
                        <a href="${pageContext.request.contextPath}/workspace/settings?wsId=${workspace.wsId}&amp;tab=members"
                           class="workspace-member-manage-btn">관리</a>
                        <button type="button" class="moyo-member-widget__primary-action workspace-member-invite-btn" onclick="openInviteModal()">초대</button>
                    </c:if>
                </div>
            </div>
            <div id="workspaceMemberList" class="moyo-member-widget__list project-member-list workspace-member-list" aria-live="polite">
                <div class="moyo-member-widget__state">멤버 정보를 불러오는 중입니다.</div>
            </div>
        </section>
    </c:when>

    <c:when test="${mainShellMode eq 'GROUP_PROJECT' and showProjectMembers}">
        <section class="moyo-member-widget project-member-panel moyo-dashboard-slot" data-member-scope="PROJECT" data-dashboard-widget="members"
                 aria-labelledby="commonProjectMemberTitle">
            <div class="moyo-member-widget__head moyo-widget-head project-member-head">
                <div class="moyo-member-widget__title moyo-widget-title project-member-title">
                    <span aria-hidden="true">👥</span>
                    <strong id="commonProjectMemberTitle">프로젝트 멤버</strong>
                    <span id="projectMemberCount" class="moyo-member-widget__count moyo-widget-count project-member-count">0</span>
                </div>
                <div class="moyo-member-widget__actions project-member-head-actions">
                    <button type="button" class="moyo-member-widget__all-button"
                            data-project-member-all-button
                            aria-haspopup="dialog"
                            onclick="openProjectMemberAllModal()">전체 보기</button>
                    <c:if test="${canManageProject}">
                        <a href="${pageContext.request.contextPath}/project/settings?projId=${projId}&amp;wsId=${wsId}&amp;tab=members"
                           class="project-member-manage-btn">관리</a>
                        <button type="button" class="moyo-member-widget__primary-action project-member-invite-btn" onclick="openAssignModal()">추가</button>
                    </c:if>
                </div>
            </div>
            <div id="projectMemberList" class="moyo-member-widget__list project-member-list" aria-live="polite">
                <div class="moyo-member-widget__state project-member-empty">멤버 정보를 불러오는 중입니다.</div>
            </div>
        </section>
    </c:when>

    <c:when test="${mainShellMode eq 'PERSONAL_PROJECT' and showProjectOwnerCard}">
        <c:set var="projectOwnerImage" value="${sessionScope.user.profileImagePath}" />
        <c:if test="${empty projectOwnerImage}"><c:set var="projectOwnerImage" value="${sessionScope.user.PROFILE_IMAGE_PATH}" /></c:if>
        <c:set var="projectOwnerName" value="${empty sessionScope.user.userName ? '사용자' : sessionScope.user.userName}" />
        <section class="moyo-member-widget project-owner-panel moyo-dashboard-slot" data-member-scope="OWNER" data-dashboard-widget="owner"
                 aria-labelledby="projectOwnerTitle">
            <div class="moyo-member-widget__head moyo-widget-head project-owner-head">
                <div class="moyo-member-widget__title moyo-widget-title project-owner-title">
                    <span aria-hidden="true">👤</span>
                    <strong id="projectOwnerTitle">프로젝트 소유자</strong>
                </div>
            </div>
            <button type="button"
                    class="moyo-member-card project-owner-card"
                    onclick="openProjectMemberProfile('${sessionScope.user.userId}')"
                    aria-label="내 프로젝트 프로필 보기">
                <span class="moyo-member-top">
                    <span class="moyo-member-avatar is-person-avatar project-owner-avatar ${empty projectOwnerImage ? 'is-default-profile' : 'has-image'}" data-avatar-kind="person">
                        <c:if test="${not empty projectOwnerImage}">
                            <img src="<c:out value='${projectOwnerImage}'/>" alt="<c:out value='${projectOwnerName}'/> 프로필"
                                 loading="lazy" decoding="async"
                                 onload="CommonMemberWidget.applyAvatarImagePolicy(this)"
                                 onerror="CommonMemberWidget.handleAvatarError(this)">
                        </c:if>
                        <span class="moyo-member-avatar-fallback project-owner-avatar-fallback"><c:out value="${projectOwnerName.substring(0,1)}"/></span>
                    </span>
                    <span class="moyo-member-main project-owner-info">
                        <span class="moyo-member-name-line">
                            <span class="moyo-member-name"><c:out value="${projectOwnerName}"/></span>
                        </span>
                        <c:if test="${not empty sessionScope.user.email}">
                            <span class="moyo-member-position"><c:out value="${sessionScope.user.email}"/></span>
                        </c:if>
                    </span>
                </span>
                <span class="moyo-member-stats project-owner-stats" aria-label="내 업무 통계">
                    <span class="moyo-member-stat total moyo-task-status moyo-task-status--all">전체 <strong id="projectOwnerTotalCount">0</strong></span>
                    <span class="moyo-member-stat todo moyo-task-status moyo-task-status--todo">할 일 <strong id="projectOwnerTodoCount">0</strong></span>
                    <span class="moyo-member-stat progress moyo-task-status moyo-task-status--progress">진행 <strong id="projectOwnerProgressCount">0</strong></span>
                    <span class="moyo-member-stat done moyo-task-status moyo-task-status--done">완료 <strong id="projectOwnerDoneCount">0</strong></span>
                    <span class="moyo-member-stat delay moyo-task-status moyo-task-status--delayed">지연 <strong id="projectOwnerDelayCount">0</strong></span>
                </span>
            </button>
        </section>
    </c:when>
</c:choose>
