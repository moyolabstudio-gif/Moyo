  <div id="pollFormModal" class="poll-modal" aria-hidden="true" inert>
    <div class="poll-modal-backdrop" onclick="closePollFormModal()"></div>
    <div class="poll-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="pollFormTitle">
      <div class="poll-modal-body">
        <div class="poll-modal-header"><h3 id="pollFormTitle">&#xD22C;&#xD45C; &#xB9CC;&#xB4E4;&#xAE30;</h3><button type="button" class="poll-modal-close" onclick="closePollFormModal()" aria-label="&#xB2EB;&#xAE30;">&#xD7;</button></div>
        <div class="poll-form-row"><label>&#xC9C8;&#xBB38;</label><input id="pollQuestionInput" class="poll-input" placeholder="&#xC608;: &#xD68C;&#xC758; &#xC2DC;&#xAC04;&#xC740; &#xC5B8;&#xC81C;&#xAC00; &#xC88B;&#xC744;&#xAE4C;&#xC694;?"></div>
        <div class="poll-form-row"><label>&#xD22C;&#xD45C; &#xB9C8;&#xAC10;</label>
          <div class="poll-deadline-grid poll-deadline-grid--moyo">
            <div class="poll-date-control moyo-quick-date-field">
              <input id="pollEndDateInput" type="text" class="poll-date-raw moyo-quick-date-input" inputmode="numeric" autocomplete="off" placeholder="YYYY-MM-DD" data-poll-quick-date hidden>
              <input id="pollEndDateDisplay" type="text" class="poll-input poll-date-display" readonly aria-label="&#xB9C8;&#xAC10; &#xB0A0;&#xC9DC;" tabindex="0">
              <button type="button" class="moyo-quick-date-trigger poll-date-trigger" data-poll-date-target="pollEndDateInput" aria-label="&#xB9C8;&#xAC10; &#xB0A0;&#xC9DC; &#xC120;&#xD0DD;">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M8 3.8v3.4M16 3.8v3.4M4 9.2h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </button>
            </div>
            <div class="poll-time-control moyo-quick-time-field">
              <span id="pollEndTimeMeridiem" class="moyo-quick-time-meridiem is-pm">&#xC624;&#xD6C4;</span>
              <input id="pollEndTimeDisplay" type="text" class="poll-input moyo-quick-time-text poll-time-display" readonly value="06:00" aria-label="&#xB9C8;&#xAC10; &#xC2DC;&#xAC04;" tabindex="0">
              <button type="button" class="moyo-quick-time-trigger poll-time-trigger" aria-label="&#xB9C8;&#xAC10; &#xC2DC;&#xAC04; &#xC120;&#xD0DD;">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.8v4.6l3 1.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <select id="pollEndHourInput" class="poll-native-time-select" aria-hidden="true" tabindex="-1"></select>
              <select id="pollEndMinuteInput" class="poll-native-time-select" aria-hidden="true" tabindex="-1"></select>
            </div>
          </div>
        </div>
        <div class="poll-form-row"><div class="poll-visibility-row"><div class="poll-visibility-copy"><span class="poll-visibility-title">&#xD22C;&#xD45C; &#xC911; &#xACB0;&#xACFC; &#xACF5;&#xAC1C;</span><span class="poll-visibility-desc">&#xCF1C;&#xBA74; &#xB9C8;&#xAC10; &#xC804;&#xC5D0;&#xB3C4; &#xC120;&#xD0DD;&#xC9C0;&#xBCC4; &#xB4DD;&#xD45C;&#xC218;&#xAC00; &#xACF5;&#xAC1C;&#xB429;&#xB2C8;&#xB2E4;.</span></div><label class="poll-switch" aria-label="&#xD22C;&#xD45C; &#xC911; &#xACB0;&#xACFC; &#xACF5;&#xAC1C;"><input id="pollShowResultsInput" type="checkbox"><span class="poll-switch-track"></span></label></div></div>
        <div class="poll-form-row poll-options-row">
          <div class="form-label-row"><label>&#xC120;&#xD0DD;&#xC9C0;</label><div class="poll-option-toolbar"><div class="global-option-type-switch" role="radiogroup" aria-label="&#xC120;&#xD0DD;&#xC9C0; &#xC720;&#xD615;">
            <label class="poll-type-option" title="&#xD14D;&#xC2A4;&#xD2B8;"><input type="radio" name="pollGlobalOptionType" value="TEXT" checked onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12M12 6v12M8.5 18h7"/></svg><b class="poll-type-text">&#xD14D;&#xC2A4;&#xD2B8;</b></span></label>
            <label class="poll-type-option" title="&#xC77C;&#xC815;"><input type="radio" name="pollGlobalOptionType" value="SCHEDULE" onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="6" width="15" height="13" rx="2.5"/><path d="M8 4v4M16 4v4M4.5 10h15"/></svg><b class="poll-type-text">&#xC77C;&#xC815;</b></span></label>
            <label class="poll-type-option" title="&#xC774;&#xBBF8;&#xC9C0;"><input type="radio" name="pollGlobalOptionType" value="IMAGE" onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2.5"/><circle cx="9" cy="10" r="1.5"/><path d="m6.5 17 4.2-4.2 2.8 2.8 2-2 2 2"/></svg><b class="poll-type-text">&#xC774;&#xBBF8;&#xC9C0;</b></span></label>
            <label class="poll-type-option" title="&#xC74C;&#xC545;"><input type="radio" name="pollGlobalOptionType" value="AUDIO" onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17.2V7.5l8-1.7v9.7"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="15.5" cy="15.8" r="2.5"/></svg><b class="poll-type-text">&#xC74C;&#xC545;</b></span></label>
            <label class="poll-type-option" title="&#xC601;&#xC0C1;"><input type="radio" name="pollGlobalOptionType" value="VIDEO" onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon poll-type-icon--play" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2.5"/><path d="m10 9 5 3-5 3Z"/></svg><b class="poll-type-text">&#xC601;&#xC0C1;</b></span></label>
          </div><button type="button" class="poll-add-option" onclick="addPollOptionRow()" title="&#xC120;&#xD0DD;&#xC9C0; &#xCD94;&#xAC00;" aria-label="&#xC120;&#xD0DD;&#xC9C0; &#xCD94;&#xAC00;">+</button><button type="button" class="poll-remove-last" onclick="removeLastPollOptionRow()" title="&#xB9C8;&#xC9C0;&#xB9C9; &#xC120;&#xD0DD;&#xC9C0; &#xC0AD;&#xC81C;" aria-label="&#xB9C8;&#xC9C0;&#xB9C9; &#xC120;&#xD0DD;&#xC9C0; &#xC0AD;&#xC81C;">&#x2212;</button></div></div>
          <div id="pollOptionInputs" class="poll-option-input-list"></div>
        </div>
        <div class="poll-form-actions"><button type="button" id="pollSubmitButton" class="poll-create-btn" onclick="savePoll()">&#xD22C;&#xD45C; &#xC0DD;&#xC131;</button></div>
      </div>
    </div>
  </div>
<style>

/* ===== common poll form modal: self-contained styles ===== */
.poll-modal{--poll-form-grad:linear-gradient(135deg,#3fd4bf 0%,#4b8df8 54%,#7b63f6 100%)}
body.poll-modal-open{overflow:hidden}
.poll-modal{position:fixed;inset:0;z-index:3000;display:none;align-items:center;justify-content:center;padding:24px}
.poll-modal.open{display:flex}
.poll-modal-backdrop{position:absolute;inset:0;background:rgba(18,29,43,.46);backdrop-filter:blur(4px)}
.poll-modal-dialog{position:relative;z-index:1;width:min(690px,100%);height:min(700px,calc(100dvh - 48px));max-height:calc(100dvh - 48px);overflow:hidden;border:1px solid #e1e7ee;border-radius:20px;background:#fff;box-shadow:0 30px 80px rgba(19,33,50,.22)}
.poll-extend-dialog{width:min(500px,100%)}
.poll-modal-body{display:flex;flex-direction:column;height:100%;min-height:0;padding:26px 28px 24px}
.poll-modal-header{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid #edf1f5}
.poll-modal-header h3{margin:0;color:#1d2a3a;font-size:19px;font-weight:900;letter-spacing:-.035em}
.poll-modal-close{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;border:0;border-radius:50%;background:transparent;color:#75849a;font-size:20px;line-height:1;cursor:pointer;transition:background .15s ease,color .15s ease}
.poll-modal-close:is(:hover,:focus-visible,:active){border-radius:50%;background:#edf2f7;color:#4f6077;outline:none}
.poll-form-row{display:flex;flex-direction:column;gap:9px;margin-bottom:18px}
.poll-form-row>label,.form-label-row>label{color:#42536b;font-size:11.5px;font-weight:900;letter-spacing:-.01em}
.poll-input{width:100%;height:42px;padding:0 12px;border:1px solid #dce4ec;border-radius:11px;background:#fff;color:#28364a;font-size:11.5px;font-weight:700;outline:none;transition:.15s ease}
.poll-input::placeholder{color:#a2adba}
.poll-input:hover{border-color:#cfd9e4}
.poll-input:focus{border-color:#8dbcf0;box-shadow:0 0 0 3px rgba(75,141,248,.09)}
.poll-native-time-select,.poll-date-raw{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important;opacity:0!important;pointer-events:none!important}
.poll-visibility-row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 15px;border:1px solid #e1e7ee;border-radius:13px;background:#fbfcfe}
.poll-visibility-copy{min-width:0}.poll-visibility-title{display:block;color:#33445b;font-size:11.5px;font-weight:900}.poll-visibility-desc{display:block;margin-top:4px;color:#8b98a9;font-size:10px;font-weight:700;line-height:1.5}
.poll-switch{position:relative;display:inline-flex;flex:0 0 auto;width:44px;height:25px}.poll-switch input{position:absolute;opacity:0;pointer-events:none}.poll-switch-track{position:absolute;inset:0;border-radius:999px;background:#dce4ed;cursor:pointer;transition:.18s ease}.poll-switch-track:after{content:"";position:absolute;left:3px;top:3px;width:19px;height:19px;border-radius:50%;background:#fff;box-shadow:0 2px 7px rgba(31,47,67,.18);transition:.18s ease}.poll-switch input:checked+.poll-switch-track{background:var(--poll-form-grad)}.poll-switch input:checked+.poll-switch-track:after{transform:translateX(19px)}.poll-switch input:focus-visible+.poll-switch-track{outline:3px solid rgba(75,141,248,.18);outline-offset:2px}
.form-label-row{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:1px}.poll-option-toolbar{display:flex;align-items:center;gap:7px}.global-option-type-switch+.poll-add-option{margin-left:5px}
.global-option-type-switch{display:grid;grid-template-columns:repeat(5,auto);padding:2px;border:1px solid #dfe6ee;border-radius:11px;background:#f8fafc}.poll-type-option{position:relative}.poll-type-option input{position:absolute;opacity:0;pointer-events:none}.poll-type-option span{display:flex;align-items:center;justify-content:center;height:30px;padding:0 11px;border-radius:8px;background:transparent;color:#7c8ca0;font-size:10px;font-weight:850;cursor:pointer;transition:.15s ease}.poll-type-option input:checked+span{background:#fff;color:#397fcf;box-shadow:0 2px 7px rgba(45,72,105,.08)}.poll-type-option span{gap:5px}.poll-type-text{font:inherit;font-weight:inherit}.poll-type-icon{display:none;width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.poll-type-icon--play path:last-child{fill:currentColor;stroke:none}
.poll-add-option,.poll-remove-last{display:grid;place-items:center;width:34px;height:34px;border:1px solid #dce4ec;border-radius:10px;background:#fff;color:#60718a;font-size:17px;font-weight:800;cursor:pointer;transition:.15s ease}.poll-add-option:hover,.poll-remove-last:hover{border-color:#c5d8ed;background:#f8fbff;color:#397fcf}
.poll-options-row{display:flex;flex:1 1 auto;min-height:0;margin-bottom:10px;overflow:hidden}.poll-options-row .form-label-row{flex:0 0 auto}.poll-option-input-list{display:flex;flex:1 1 auto;min-height:0;flex-direction:column;gap:9px;max-height:none;overflow-y:auto;overflow-x:hidden;padding:1px 5px 8px 0;overscroll-behavior:contain;scrollbar-gutter:stable}.poll-option-input-list::-webkit-scrollbar{width:6px}.poll-option-input-list::-webkit-scrollbar-thumb{background:#d8e0e8;border-radius:999px}
.poll-options-row{max-height:none}.poll-options-row .poll-option-input-list{height:auto}.poll-form-actions{position:relative;z-index:2;background:#fff}

.poll-option-edit-row{display:grid;grid-template-columns:30px minmax(0,1fr);gap:9px;align-items:start}.poll-option-edit-row>.option-number{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:#f1f5fa;color:#6d819b;font-size:10px;font-weight:900;margin-top:7px}.poll-option-edit-main{min-width:0}
/* text/schedule/audio/video share one option index rail; image keeps its card-specific badge */
.poll-option-edit-row:is(.text-mode,.schedule-mode,.audio-mode,.video-mode){grid-template-columns:30px minmax(0,1fr);gap:9px;align-items:start}
.poll-option-edit-row:is(.text-mode,.schedule-mode,.audio-mode,.video-mode)>.option-number{width:26px;height:26px;margin-top:8px;align-self:start;border-radius:50%;background:#f3f6fa;color:#71849c;font-size:10px;font-weight:900}
.poll-option-image-block,.poll-option-audio-block,.poll-option-video-block,.poll-option-schedule-block{display:none}.poll-option-edit-row.image-mode .poll-option-text-input,.poll-option-edit-row.audio-mode .poll-option-text-input,.poll-option-edit-row.video-mode .poll-option-text-input,.poll-option-edit-row.schedule-mode .poll-option-text-input{display:none}.poll-option-edit-row.image-mode .poll-option-image-block,.poll-option-edit-row.audio-mode .poll-option-audio-block,.poll-option-edit-row.video-mode .poll-option-video-block,.poll-option-edit-row.schedule-mode .poll-option-schedule-block{display:block}

.poll-option-edit-row.schedule-mode{align-items:start}.poll-option-schedule-block{width:100%;min-width:0}.poll-schedule-grid{display:grid;grid-template-columns:minmax(176px,1.55fr) minmax(122px,1fr) 14px minmax(122px,1fr);gap:8px;align-items:center}.poll-schedule-field{position:relative;min-width:0}.poll-schedule-field .poll-input{height:42px;padding-right:35px;cursor:pointer}.poll-schedule-field .poll-input[readonly]{background:#fff}.poll-schedule-trigger{position:absolute;right:7px;top:50%;transform:translateY(-50%);display:grid;place-items:center;width:26px;height:26px;border:0;border-radius:8px;background:transparent;color:#7890ad;cursor:pointer}.poll-schedule-trigger:hover{background:#f0f5fb;color:#397fcf}.poll-schedule-trigger svg{width:15px;height:15px}.poll-schedule-sep{display:grid;place-items:center;width:14px;color:#91a0b2;font-size:11px;font-weight:900;line-height:1}.poll-schedule-error{display:none;margin:5px 0 0;color:#e45151;font-size:9.5px;font-weight:800;line-height:1.4}.poll-option-edit-row.schedule-mode.has-schedule-error .poll-schedule-error{display:block}.poll-option-edit-row.schedule-mode.has-schedule-error .poll-schedule-field .poll-input{border-color:#efb1b1;box-shadow:0 0 0 3px rgba(228,81,81,.06)}.poll-option-input-list.schedule-edit-list{align-content:start}.poll-option-input-list.schedule-edit-list.has-scroll{scrollbar-gutter:stable}.poll-option-input-list.schedule-edit-list.has-scroll::-webkit-scrollbar-thumb{background:#cfd9e4}.poll-option-input-list.schedule-edit-list .poll-option-edit-row{flex:0 0 auto}@media(max-width:640px){.poll-schedule-grid{grid-template-columns:1fr 1fr;}.poll-schedule-grid .poll-schedule-date-field{grid-column:1/-1}.poll-schedule-sep{display:none}.poll-option-edit-row.schedule-mode>.option-number{align-self:start;margin-top:8px}}
.poll-option-edit-row.text-mode .poll-option-edit-main{display:flex;align-items:center;min-height:42px}.poll-option-edit-row.text-mode .poll-option-text-input{height:42px;margin:0;padding:0 12px;border-radius:11px;font-size:11.5px}
.poll-file-label,.poll-media-upload{display:flex;align-items:center;justify-content:center;min-height:102px;border:1px dashed #c7d4e2;border-radius:12px;background:#fafcff;cursor:pointer;transition:.15s ease}.poll-file-label:hover,.poll-media-upload:hover{border-color:#9fc6ee;background:#f7fbff}.poll-file-label input,.poll-media-upload input{display:none}.poll-upload-tile-content{text-align:center}.poll-upload-plus{display:block;color:#6685ad;font-size:21px;line-height:1}.poll-upload-tile-content strong,.poll-audio-upload-text{display:block;margin-top:3px;color:#4d617c;font-size:10.5px;font-weight:900}.poll-upload-help,.poll-audio-upload-help{display:block;margin-top:4px;color:#98a5b5;font-size:9.5px;line-height:1.45;text-align:center}
.poll-option-image-frame{position:relative;display:none;margin-top:8px;overflow:hidden;border-radius:11px;border:1px solid #e1e7ee;background:#f7f9fb}.poll-option-image-frame.visible{display:block}.poll-image-preview{display:block;width:100%;max-height:220px;object-fit:contain;background:#f7f9fb}.poll-option-image-remove{position:absolute;right:8px;top:8px;display:grid;place-items:center;width:28px;height:28px;border:1px solid rgba(255,255,255,.8);border-radius:9px;background:rgba(28,39,54,.58);color:#fff;font-size:16px;cursor:pointer}.poll-image-name{display:block;margin-top:6px;color:#8997a8;font-size:9.5px;font-weight:700}
.poll-option-audio-block{display:none}.poll-option-edit-row.audio-mode .poll-option-audio-block{display:grid;grid-template-columns:1fr;gap:8px}.poll-option-audio-block.has-audio .poll-media-upload{min-height:64px}.poll-media-title{margin-top:0}.poll-audio-preview{display:none;width:100%;height:36px}.poll-option-audio-block.has-audio .poll-audio-preview{display:block}.poll-option-video-block .poll-input{width:100%}

/* image option editor: compact MOYO card grid */
.poll-option-input-list.image-edit-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
  flex:1;
  min-height:0;
  max-height:none;
  overflow:auto;
  align-content:start;
  padding:1px 5px 1px 0;
}
.poll-option-input-list.image-edit-grid .poll-option-edit-row{
  position:relative;
  display:block;
  min-width:0;
}
.poll-option-input-list.image-edit-grid .poll-option-edit-row>.option-number{
  position:absolute;
  left:10px;
  top:10px;
  z-index:4;
  display:grid;
  place-items:center;
  width:26px;
  height:26px;
  margin:0;
  border-radius:8px;
  background:rgba(255,255,255,.94);
  color:#5376a4;
  box-shadow:0 4px 12px rgba(23,38,58,.09);
  font-size:10px;
  font-weight:900;
}
.poll-option-input-list.image-edit-grid .poll-option-edit-main{width:100%;min-width:0}
.poll-option-input-list.image-edit-grid .poll-option-image-block{
  position:relative;
  display:block;
  min-width:0;
  overflow:visible;
}
.poll-option-input-list.image-edit-grid .poll-file-label{
  height:188px;
  min-height:188px;
  padding:14px 12px;
  border-color:#cdd9e6;
  border-radius:14px;
  background:#fbfcfe;
}
.poll-option-input-list.image-edit-grid .poll-file-label:hover,
.poll-option-input-list.image-edit-grid .poll-option-image-block.row-dragover .poll-file-label{
  border-color:#91bce8;
  background:#f7fbff;
  box-shadow:0 0 0 3px rgba(75,141,248,.06);
}
.poll-option-input-list.image-edit-grid .poll-option-image-block.has-image .poll-file-label{display:none}
.poll-option-input-list.image-edit-grid .poll-option-image-frame{
  width:100%;
  height:188px;
  min-height:188px;
  margin:0;
  border-radius:14px;
  background:#f5f7fa;
}
.poll-option-input-list.image-edit-grid .poll-option-image-frame.visible{display:block}
.poll-option-input-list.image-edit-grid .poll-image-preview{
  width:100%;
  height:100%;
  max-height:none;
  max-width:100%;
  max-height:100%;
  object-fit:contain!important;
  object-position:center center!important;
}
.poll-option-input-list.image-edit-grid .poll-option-image-remove{
  right:8px;
  top:8px;
  width:27px;
  height:27px;
  border-radius:50%;
}
.poll-option-input-list.image-edit-grid .poll-option-image-remove:hover{background:rgba(28,39,54,.72);transform:scale(1.04)}
.poll-option-input-list.image-edit-grid .poll-option-image-remove:active{background:rgba(28,39,54,.82);transform:scale(.96)}
.poll-option-input-list.image-edit-grid .poll-image-name{
  display:block;
  width:100%;
  height:20px;
  max-width:100%;
  min-width:0;
  margin-top:5px;
  padding:0 2px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  color:#8391a3;
  font-size:9px;
  font-weight:720;
  line-height:20px;
}
.poll-option-input-list.image-edit-grid{padding-bottom:12px;scrollbar-width:thin;scrollbar-color:#dbe4ed transparent}
.poll-option-input-list.image-edit-grid::-webkit-scrollbar{width:4px}
.poll-option-input-list.image-edit-grid::-webkit-scrollbar-track{background:transparent}
.poll-option-input-list.image-edit-grid::-webkit-scrollbar-thumb{background:#dbe4ed;border-radius:999px}
.poll-option-input-list.image-edit-grid .poll-option-edit-row{align-self:start}
@media(max-width:720px){
  .poll-option-input-list.image-edit-grid{grid-template-columns:1fr}
}
.poll-form-actions{display:flex;flex:0 0 auto;gap:8px;margin-top:8px;padding-top:4px}.poll-create-btn{display:flex;align-items:center;justify-content:center;width:100%;height:44px;border:0;border-radius:12px;background:var(--poll-form-grad);color:#fff;font-size:11.5px;font-weight:900;cursor:pointer;box-shadow:0 9px 20px rgba(75,141,248,.18);transition:.15s ease}.poll-create-btn:hover{transform:translateY(-1px);box-shadow:0 12px 24px rgba(75,141,248,.22)}
.poll-static-value{display:flex;align-items:center;min-height:42px;padding:0 12px;border-radius:11px;background:#f6f8fa;color:#6d7a8a;font-size:11px;font-weight:780}
@media(max-width:680px){.poll-modal{padding:10px}.poll-modal-dialog{height:calc(100dvh - 20px);max-height:calc(100dvh - 20px)}.poll-modal-body{padding:20px 16px}.form-label-row{align-items:flex-start;flex-direction:column}.poll-option-toolbar{width:100%;justify-content:space-between}.global-option-type-switch{grid-template-columns:repeat(4,1fr);flex:1}.poll-type-option span{padding:0 5px}.poll-option-input-list{max-height:none}}
/* poll deadline picker: reuse MOYO quick-create interaction language */
.poll-deadline-grid--moyo{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(180px,.65fr);gap:10px;align-items:center}
.poll-date-control,.poll-time-control{position:relative;min-width:0}
.poll-date-display,.poll-time-display{width:100%;height:42px;padding-right:42px;font-variant-numeric:tabular-nums;cursor:pointer}
.poll-time-display{padding-left:58px}
.poll-date-trigger svg,.poll-time-trigger svg{width:17px;height:17px;display:block}
.moyo-quick-date-trigger,.moyo-quick-time-trigger{position:absolute;top:50%;right:10px;transform:translateY(-50%);width:26px;height:26px;border:0;border-radius:9px;background:transparent;color:#24415f;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.moyo-quick-date-trigger:hover,.moyo-quick-time-trigger:hover{background:#eef5ff;color:#2f6dff}
.moyo-quick-time-meridiem{position:absolute;left:13px;top:50%;transform:translateY(-50%);z-index:1;padding:2px 7px;border-radius:999px;font-size:11px;font-weight:680;letter-spacing:-.03em;pointer-events:none}
.moyo-quick-time-meridiem.is-am{background:#e9fbf7;color:#0f9f8f}.moyo-quick-time-meridiem.is-pm{background:#eef4ff;color:#245eea}
.moyo-quick-picker-menu{position:fixed;z-index:10060;border:1px solid rgba(126,164,255,.28);border-radius:17px;background:#fff;box-shadow:0 14px 28px rgba(30,64,122,.12);padding:10px;color:#1f2c43;overflow:hidden}
.moyo-quick-picker-menu[hidden]{display:none!important}.moyo-quick-date-picker-menu{width:248px}.moyo-quick-time-picker-menu{width:268px}
.moyo-quick-date-picker-head,.moyo-quick-time-picker-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}
.moyo-quick-date-picker-title,.moyo-quick-time-picker-title{font-size:13px;font-weight:900;letter-spacing:-.03em;color:#0f1e33}
.moyo-quick-date-picker-nav{display:inline-flex;gap:4px}.moyo-quick-date-picker-nav button,.moyo-quick-time-picker-now{border:1px solid #d7e4f5;background:rgba(255,255,255,.78);color:#55708f;font-weight:740;cursor:pointer}
.moyo-quick-date-picker-nav button{width:25px;height:25px;border-radius:999px}.moyo-quick-time-picker-now{height:28px;padding:0 9px;border-radius:10px;font-size:12px}
.moyo-quick-date-picker-nav button:hover,.moyo-quick-time-picker-now:hover{border-color:#9fc0ff;background:#f3f7ff;color:#2563eb}
.moyo-quick-date-picker-weekdays,.moyo-quick-date-picker-days{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}.moyo-quick-date-picker-weekdays{margin-bottom:5px}
.moyo-quick-date-picker-weekdays span{height:20px;display:flex;align-items:center;justify-content:center;color:#7c8aa0;font-size:11px;font-weight:900}.moyo-quick-date-picker-weekdays span:first-child{color:#ff6b87}.moyo-quick-date-picker-weekdays span:last-child{color:#4f7cff}
.moyo-quick-date-picker-day{height:27px;border:1px solid transparent;border-radius:10px;background:transparent;color:#1f2c43;font-size:12px;font-weight:720;cursor:pointer}.moyo-quick-date-picker-day:nth-child(7n+1){color:#ff5d7a}.moyo-quick-date-picker-day:nth-child(7n){color:#4f7cff}.moyo-quick-date-picker-day:hover{border-color:#aac7ff;background:#f5f8ff;color:#2563eb}.moyo-quick-date-picker-day.is-muted{color:#b1bdca!important}.moyo-quick-date-picker-day.is-today{border-color:#64d6ca;color:#0f9f8f;background:#eefcf9}.moyo-quick-date-picker-day.is-selected{border-color:transparent;background:#5d7cff;color:#fff!important;box-shadow:0 7px 14px rgba(79,124,255,.18)}.moyo-quick-date-picker-day:disabled{color:#ccd3db!important;cursor:not-allowed;background:transparent!important;box-shadow:none!important}
.moyo-quick-date-picker-foot{display:flex;justify-content:flex-end;margin-top:10px}.moyo-quick-date-picker-today{height:25px;padding:0 9px;border:1px solid #d7e4f5;border-radius:999px;background:rgba(255,255,255,.78);color:#55708f;font-size:11px;font-weight:740;cursor:pointer}
.moyo-quick-time-picker-ampm{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-bottom:9px}.moyo-quick-time-picker-ampm button,.moyo-quick-time-picker-grid button{height:30px;border:1px solid #dbe6f5;border-radius:10px;background:#fff;color:#334155;font-size:12px;font-weight:720;cursor:pointer}.moyo-quick-time-picker-ampm button:hover,.moyo-quick-time-picker-grid button:hover{border-color:#aac7ff;background:#f5f8ff;color:#2563eb}.moyo-quick-time-picker-ampm button[data-meridiem="AM"]{background:#fbfffe}.moyo-quick-time-picker-ampm button[data-meridiem="PM"]{background:#fbfcff}.moyo-quick-time-picker-ampm button[data-meridiem="AM"].is-selected{border-color:#5ad0c0;background:#e9fbf7;color:#0f9f8f}.moyo-quick-time-picker-ampm button[data-meridiem="PM"].is-selected{border-color:#5d86ff;background:#eef4ff;color:#245eea}.moyo-quick-time-picker-grid button.is-selected{border-color:#2f6dff;background:#2f6dff;color:#fff}.moyo-quick-time-picker-section{margin-top:8px}.moyo-quick-time-picker-label{margin-bottom:5px;color:#68778d;font-size:11px;font-weight:720}.moyo-quick-time-picker-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:5px}
/* option row alignment: number chip and text input share one center line */
.poll-option-input-list .poll-option-edit-row.text-mode{align-items:center!important;}
.poll-option-input-list .poll-option-edit-row.text-mode>.option-number{margin-top:0!important;align-self:center;}
.poll-option-input-list .poll-option-edit-row.text-mode .poll-option-edit-main{display:flex;align-items:center;min-height:42px;}
.poll-option-input-list .poll-option-edit-row.text-mode .poll-option-text-input{margin:0;}

/* audio option editor: compact track-style rows; two defaults fit before scrolling */
.poll-option-input-list .poll-option-edit-row.audio-mode{
  grid-template-columns:30px minmax(0,1fr);
  gap:9px;
  align-items:start;
}
.poll-option-input-list .poll-option-edit-row.audio-mode>.option-number{
  margin-top:8px!important;
  align-self:start;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-edit-main{min-width:0}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-audio-block{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(150px,190px);
  gap:8px 10px;
  align-items:center;
  min-width:0;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-media-upload{
  min-height:42px;
  height:42px;
  padding:0 12px;
  border-radius:11px;
  flex-direction:row;
  gap:7px;
  justify-content:flex-start;
  overflow:hidden;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-upload-text{
  display:inline;
  margin:0;
  flex:0 0 auto;
  font-size:10.5px;
  white-space:nowrap;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-upload-help{
  display:block;
  min-width:0;
  margin:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  text-align:left;
  font-size:9.5px;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-media-title{
  height:42px;
  margin:0;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-preview{
  grid-column:1 / -1;
  width:100%;
  height:34px;
  margin:0;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-audio-block.has-audio .poll-media-upload{
  min-height:42px;
  height:42px;
}
@media(max-width:680px){
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-audio-block{grid-template-columns:1fr}
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-preview{grid-column:auto}
}

@media(max-width:720px){.poll-deadline-grid--moyo{grid-template-columns:1fr}.poll-time-control{min-width:0}}

/* ===== poll form mobile final regression (360-430px) ===== */
@media(max-width:680px){
  .poll-modal{padding:8px}
  /* Mobile: fit the dialog to its content; cap it to the viewport instead of forcing full height. */
  .poll-modal-dialog{width:100%;height:auto;max-height:calc(100dvh - 16px);border-radius:17px}
  .poll-modal-body{height:auto;max-height:calc(100dvh - 16px);padding:17px 14px 14px;overflow:hidden}
  .poll-modal-header{flex:0 0 auto;margin-bottom:16px;padding-bottom:13px}
  .poll-modal-header h3{font-size:18px}
  .poll-modal-close{width:32px;height:32px;background:transparent!important;box-shadow:none}
  .poll-modal-close:not(:hover):not(:focus-visible):not(:active){background:transparent!important}

  .poll-form-row{gap:7px;margin-bottom:13px}
  .poll-input{height:40px}
  .poll-visibility-row{gap:12px;padding:11px 12px}
  .poll-visibility-desc{font-size:9.5px}

  /* Only the option area scrolls once its content grows beyond the mobile cap. */
  .poll-options-row{flex:0 1 auto;min-height:0;max-height:min(38dvh,320px);margin-bottom:7px;overflow:hidden}
  .poll-options-row .form-label-row{gap:8px}
  .form-label-row{align-items:stretch;flex-direction:column}
  .poll-option-toolbar{display:flex;width:100%;flex-wrap:nowrap;align-items:center;justify-content:flex-start;gap:6px}
  .global-option-type-switch{grid-template-columns:repeat(5,minmax(0,1fr));flex:1 1 auto;width:auto;min-width:0}
  .poll-type-option{min-width:0}
  .poll-type-option span{min-width:0;height:32px;padding:0 3px;font-size:9.5px;white-space:nowrap}
  .global-option-type-switch+.poll-add-option{margin-left:2px}
  .poll-add-option,.poll-remove-last{flex:0 0 32px;width:32px;height:32px}

  .poll-option-input-list{flex:0 1 auto;min-height:0;max-height:min(38dvh,320px);padding-right:2px;overflow-y:auto;overflow-x:hidden;scrollbar-gutter:auto}
  .poll-option-input-list.image-edit-grid{max-height:min(44dvh,360px)}
  .poll-option-edit-row:is(.text-mode,.schedule-mode,.audio-mode,.video-mode){grid-template-columns:27px minmax(0,1fr);gap:7px}
  .poll-option-edit-row:is(.text-mode,.schedule-mode,.audio-mode,.video-mode)>.option-number{width:25px;height:25px;font-size:9.5px}

  .poll-schedule-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:7px}
  .poll-schedule-grid .poll-schedule-date-field{grid-column:1/-1}
  .poll-schedule-sep{display:none}
  .poll-schedule-field .poll-input{height:40px;padding-left:10px;padding-right:31px;font-size:10.5px}
  .poll-schedule-trigger{right:4px;width:25px;height:25px}
  .poll-schedule-error{font-size:9px}

  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-audio-block{grid-template-columns:1fr}
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-media-upload,
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-media-title{height:40px;min-height:40px}
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-preview{grid-column:auto;min-width:0}

  .poll-option-input-list.image-edit-grid{grid-template-columns:1fr;gap:10px}
  .poll-option-input-list.image-edit-grid .poll-file-label,
  .poll-option-input-list.image-edit-grid .poll-option-image-frame{height:168px;min-height:168px}

  .poll-form-actions{flex:0 0 auto;margin-top:6px;padding-top:5px;background:#fff}
  .poll-create-btn{height:42px}

  .poll-deadline-grid--moyo{grid-template-columns:1fr;gap:7px}
  .poll-date-display,.poll-time-display{height:40px}
  .moyo-quick-picker-menu{max-width:calc(100vw - 20px)}
  .moyo-quick-date-picker-menu{width:min(248px,calc(100vw - 20px))}
  .moyo-quick-time-picker-menu{width:min(268px,calc(100vw - 20px))}
}
@media(max-width:480px){
  .poll-option-toolbar{gap:5px}
  .global-option-type-switch{padding:2px;gap:0}
  .poll-type-option span{height:32px;padding:0}
  .poll-type-option .poll-type-text{display:none}
  .poll-type-option .poll-type-icon{display:block}
  .poll-add-option,.poll-remove-last{flex-basis:32px;width:32px;height:32px}
}
@media(max-width:390px){
  .poll-modal-body{padding:15px 12px 12px}
  .poll-modal-header{margin-bottom:14px}
  .poll-type-option span{font-size:9px;padding:0 2px}
  .poll-visibility-row{padding:10px 11px}
  .poll-option-input-list.image-edit-grid .poll-file-label,
  .poll-option-input-list.image-edit-grid .poll-option-image-frame{height:154px;min-height:154px}
}

</style>
<script>
(function(){
  const WEEKDAYS=['\uC77C','\uC6D4','\uD654','\uC218','\uBAA9','\uAE08','\uD1A0'];
  const MINUTES=[0,5,10,15,20,25,30,35,40,45,50,55];
  const pad=n=>String(n).padStart(2,'0');
  let dateMenu=null,timeMenu=null,dateView=null,timeState=null;
  function parseDate(v){const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(v||''));if(!m)return null;const d=new Date(+m[1],+m[2]-1,+m[3]);if(d.getFullYear()!=+m[1]||d.getMonth()!=+m[2]-1||d.getDate()!=+m[3])return null;return d}
  function formatDate(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}
  function today(){const d=new Date();d.setHours(0,0,0,0);return d}
  function syncDateDisplay(){const raw=document.getElementById('pollEndDateInput'),display=document.getElementById('pollEndDateDisplay');if(!raw||!display)return;const d=parseDate(raw.value);display.value=d?raw.value+' ('+WEEKDAYS[d.getDay()]+')':''}
  function ensureDateMenu(){if(dateMenu)return dateMenu;dateMenu=document.createElement('div');dateMenu.className='moyo-quick-picker-menu moyo-quick-date-picker-menu';dateMenu.hidden=true;dateMenu.addEventListener('click',e=>{e.stopPropagation();const b=e.target.closest('button');if(!b)return;if(b.dataset.nav){dateView.setMonth(dateView.getMonth()+Number(b.dataset.nav));renderDate();return}if(b.dataset.date){const raw=document.getElementById('pollEndDateInput');raw.value=b.dataset.date;raw.dispatchEvent(new Event('change',{bubbles:true}));syncDateDisplay();closeAll();return}if(b.dataset.action==='today'){const raw=document.getElementById('pollEndDateInput');raw.value=formatDate(today());raw.dispatchEvent(new Event('change',{bubbles:true}));syncDateDisplay();closeAll()}});document.body.appendChild(dateMenu);return dateMenu}
  function renderDate(){const menu=ensureDateMenu(),raw=document.getElementById('pollEndDateInput'),selected=parseDate(raw.value),first=new Date(dateView.getFullYear(),dateView.getMonth(),1),start=new Date(dateView.getFullYear(),dateView.getMonth(),1-first.getDay()),min=today();let days='';for(let i=0;i<42;i++){const d=new Date(start);d.setDate(start.getDate()+i);d.setHours(0,0,0,0);const val=formatDate(d),muted=d.getMonth()!==dateView.getMonth(),disabled=d<min,isToday=val===formatDate(min),isSel=selected&&val===formatDate(selected);days+='<button type="button" class="moyo-quick-date-picker-day'+(muted?' is-muted':'')+(isToday?' is-today':'')+(isSel?' is-selected':'')+'" data-date="'+val+'"'+(disabled?' disabled':'')+'>'+d.getDate()+'</button>'}menu.innerHTML='<div class="moyo-quick-date-picker-head"><div class="moyo-quick-date-picker-title">'+dateView.getFullYear()+'\uB144 '+(dateView.getMonth()+1)+'\uC6D4</div><div class="moyo-quick-date-picker-nav"><button type="button" data-nav="-1">\u2039</button><button type="button" data-nav="1">\u203A</button></div></div><div class="moyo-quick-date-picker-weekdays">'+WEEKDAYS.map(x=>'<span>'+x+'</span>').join('')+'</div><div class="moyo-quick-date-picker-days">'+days+'</div><div class="moyo-quick-date-picker-foot"><button type="button" class="moyo-quick-date-picker-today" data-action="today">\uC624\uB298</button></div>'}
  function position(menu,field,w,h){const r=field.getBoundingClientRect();let left=Math.min(Math.max(10,r.left),window.innerWidth-w-10);let top=r.bottom+3;if(top+h>window.innerHeight-10)top=Math.max(10,r.top-h-3);menu.style.left=left+'px';menu.style.top=top+'px'}
  function openDate(){closeAll();const raw=document.getElementById('pollEndDateInput'),d=parseDate(raw.value)||today();dateView=new Date(d.getFullYear(),d.getMonth(),1);renderDate();const menu=ensureDateMenu();position(menu,document.querySelector('.poll-date-control'),248,288);menu.hidden=false}
  function currentTimeFromSelects(){const h=document.getElementById('pollEndHourInput'),m=document.getElementById('pollEndMinuteInput');return{hour:Number(h&&h.value||18),minute:Number(m&&m.value||0)}}
  function syncTimeDisplay(){const v=currentTimeFromSelects(),input=document.getElementById('pollEndTimeDisplay'),chip=document.getElementById('pollEndTimeMeridiem');if(!input||!chip)return;const pm=v.hour>=12;input.value=pad(v.hour%12||12)+':'+pad(v.minute);chip.textContent=pm?'\uC624\uD6C4':'\uC624\uC804';chip.classList.toggle('is-am',!pm);chip.classList.toggle('is-pm',pm)}
  function ensureTimeMenu(){if(timeMenu)return timeMenu;timeMenu=document.createElement('div');timeMenu.className='moyo-quick-picker-menu moyo-quick-time-picker-menu';timeMenu.hidden=true;timeMenu.addEventListener('click',e=>{e.stopPropagation();const b=e.target.closest('button');if(!b)return;if(b.dataset.action==='now'){const n=new Date(),rounded=Math.round(n.getMinutes()/5)*5;timeState={meridiem:n.getHours()>=12?'PM':'AM',hour12:n.getHours()%12||12,minute:rounded===60?0:rounded};if(rounded===60){const h=(n.getHours()+1)%24;timeState.meridiem=h>=12?'PM':'AM';timeState.hour12=h%12||12}}if(b.dataset.meridiem)timeState.meridiem=b.dataset.meridiem;if(b.dataset.hour)timeState.hour12=Number(b.dataset.hour);if(b.dataset.minute)timeState.minute=Number(b.dataset.minute);applyTimeState();renderTime()});document.body.appendChild(timeMenu);return timeMenu}
  function applyTimeState(){let h=(timeState.hour12%12)+(timeState.meridiem==='PM'?12:0);const hs=document.getElementById('pollEndHourInput'),ms=document.getElementById('pollEndMinuteInput');if(hs){hs.value=pad(h);hs.dispatchEvent(new Event('change',{bubbles:true}))}if(ms){ms.value=pad(timeState.minute);ms.dispatchEvent(new Event('change',{bubbles:true}))}syncTimeDisplay()}
  function renderTime(){const menu=ensureTimeMenu(),hours=Array.from({length:12},(_,i)=>i+1).map(h=>'<button type="button" data-hour="'+h+'" class="'+(timeState.hour12===h?'is-selected':'')+'">'+pad(h)+'</button>').join(''),mins=MINUTES.map(m=>'<button type="button" data-minute="'+m+'" class="'+(timeState.minute===m?'is-selected':'')+'">'+pad(m)+'</button>').join('');menu.innerHTML='<div class="moyo-quick-time-picker-head"><div class="moyo-quick-time-picker-title">\uC2DC\uAC04 \uC120\uD0DD</div><button type="button" class="moyo-quick-time-picker-now" data-action="now">\uD604\uC7AC \uC2DC\uAC04</button></div><div class="moyo-quick-time-picker-ampm"><button type="button" data-meridiem="AM" class="'+(timeState.meridiem==='AM'?'is-selected':'')+'">\uC624\uC804</button><button type="button" data-meridiem="PM" class="'+(timeState.meridiem==='PM'?'is-selected':'')+'">\uC624\uD6C4</button></div><div class="moyo-quick-time-picker-section"><div class="moyo-quick-time-picker-label">\uC2DC</div><div class="moyo-quick-time-picker-grid">'+hours+'</div></div><div class="moyo-quick-time-picker-section"><div class="moyo-quick-time-picker-label">\uBD84 \u00B7 5\uBD84 \uB2E8\uC704</div><div class="moyo-quick-time-picker-grid">'+mins+'</div></div>'}
  function openTime(){closeAll();const v=currentTimeFromSelects();timeState={meridiem:v.hour>=12?'PM':'AM',hour12:v.hour%12||12,minute:Math.round(v.minute/5)*5%60};renderTime();const menu=ensureTimeMenu();position(menu,document.querySelector('.poll-time-control'),268,276);menu.hidden=false}
  function closeAll(){if(dateMenu)dateMenu.hidden=true;if(timeMenu)timeMenu.hidden=true}
  function bind(){const raw=document.getElementById('pollEndDateInput'),disp=document.getElementById('pollEndDateDisplay'),dateTrig=document.querySelector('.poll-date-trigger'),timeDisp=document.getElementById('pollEndTimeDisplay'),timeTrig=document.querySelector('.poll-time-trigger'),modal=document.getElementById('pollFormModal');if(!raw||!disp)return;disp.addEventListener('click',openDate);disp.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openDate()}});dateTrig&&dateTrig.addEventListener('click',e=>{e.stopPropagation();openDate()});timeDisp&&timeDisp.addEventListener('click',openTime);timeDisp&&timeDisp.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openTime()}});timeTrig&&timeTrig.addEventListener('click',e=>{e.stopPropagation();openTime()});raw.addEventListener('change',syncDateDisplay);['pollEndHourInput','pollEndMinuteInput'].forEach(id=>{const el=document.getElementById(id);if(el)el.addEventListener('change',syncTimeDisplay)});document.addEventListener('click',e=>{if(!e.target.closest('.moyo-quick-picker-menu')&&!e.target.closest('.poll-date-control')&&!e.target.closest('.poll-time-control'))closeAll()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&((dateMenu&&!dateMenu.hidden)||(timeMenu&&!timeMenu.hidden))){e.preventDefault();e.stopPropagation();closeAll()}});window.addEventListener('resize',closeAll);if(modal&&window.MutationObserver)new MutationObserver(()=>{if(modal.getAttribute('aria-hidden')==='false'){requestAnimationFrame(()=>{syncDateDisplay();syncTimeDisplay()})}else closeAll()}).observe(modal,{attributes:true,attributeFilter:['aria-hidden']});syncDateDisplay();syncTimeDisplay()}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
  window.syncPollDeadlinePicker=function(){syncDateDisplay();syncTimeDisplay()};
})();
</script>


