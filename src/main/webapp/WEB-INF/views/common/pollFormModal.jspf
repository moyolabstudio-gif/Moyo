  <div id="pollFormModal" class="poll-modal" aria-hidden="true" inert>
    <div class="poll-modal-backdrop" onclick="closePollFormModal()"></div>
    <div class="poll-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="pollFormTitle">
      <div class="poll-modal-body">
        <div class="poll-modal-header"><h3 id="pollFormTitle">&#xD22C;&#xD45C; &#xB9CC;&#xB4E4;&#xAE30;</h3><button type="button" class="poll-modal-close" onclick="closePollFormModal()" aria-label="&#xB2EB;&#xAE30;">&#xD7;</button></div>
        <div class="poll-form-row"><label>&#xC9C8;&#xBB38;</label><input id="pollQuestionInput" class="poll-input" placeholder="&#xC608;: &#xD68C;&#xC758; &#xC2DC;&#xAC04;&#xC740; &#xC5B8;&#xC81C;&#xAC00; &#xC88B;&#xC744;&#xAE4C;&#xC694;?"></div>
        <div class="poll-form-row"><label>&#xD22C;&#xD45C; &#xB9C8;&#xAC10;</label>
          <div class="poll-deadline-grid poll-deadline-grid--moyo">
            <div class="poll-date-control moyo-quick-date-field">
              <input id="pollEndDateInput" type="text" class="poll-date-raw moyo-quick-date-input" inputmode="numeric" autocomplete="off" placeholder="YYYY-MM-DD" data-poll-quick-date hidden>
              <input id="pollEndDateDisplay" type="text" class="poll-input poll-date-display" readonly aria-label="&#xB9C8;&#xAC10; &#xB0A0;&#xC9DC;" tabindex="0">
              <button type="button" class="moyo-quick-date-trigger poll-date-trigger" data-poll-date-target="pollEndDateInput" aria-label="&#xB9C8;&#xAC10; &#xB0A0;&#xC9DC; &#xC120;&#xD0DD;">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M8 3.8v3.4M16 3.8v3.4M4 9.2h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </button>
            </div>
            <div class="poll-time-control moyo-quick-time-field">
              <span id="pollEndTimeMeridiem" class="moyo-quick-time-meridiem is-pm">&#xC624;&#xD6C4;</span>
              <input id="pollEndTimeDisplay" type="text" class="poll-input moyo-quick-time-text poll-time-display" readonly value="06:00" aria-label="&#xB9C8;&#xAC10; &#xC2DC;&#xAC04;" tabindex="0">
              <button type="button" class="moyo-quick-time-trigger poll-time-trigger" aria-label="&#xB9C8;&#xAC10; &#xC2DC;&#xAC04; &#xC120;&#xD0DD;">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.8v4.6l3 1.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <select id="pollEndHourInput" class="poll-native-time-select" aria-hidden="true" tabindex="-1"></select>
              <select id="pollEndMinuteInput" class="poll-native-time-select" aria-hidden="true" tabindex="-1"></select>
            </div>
          </div>
        </div>
        <div class="poll-form-row"><div class="poll-visibility-row"><div class="poll-visibility-copy"><span class="poll-visibility-title">&#xD22C;&#xD45C; &#xC911; &#xACB0;&#xACFC; &#xACF5;&#xAC1C;</span><span class="poll-visibility-desc">&#xCF1C;&#xBA74; &#xB9C8;&#xAC10; &#xC804;&#xC5D0;&#xB3C4; &#xC120;&#xD0DD;&#xC9C0;&#xBCC4; &#xB4DD;&#xD45C;&#xC218;&#xAC00; &#xACF5;&#xAC1C;&#xB429;&#xB2C8;&#xB2E4;.</span></div><label class="poll-switch" aria-label="&#xD22C;&#xD45C; &#xC911; &#xACB0;&#xACFC; &#xACF5;&#xAC1C;"><input id="pollShowResultsInput" type="checkbox"><span class="poll-switch-track"></span></label></div></div>
        <div class="poll-form-row poll-options-row">
          <div class="form-label-row"><label>&#xC120;&#xD0DD;&#xC9C0;</label><div class="poll-option-toolbar"><div class="global-option-type-switch" role="radiogroup" aria-label="&#xC120;&#xD0DD;&#xC9C0; &#xC720;&#xD615;">
            <label class="poll-type-option" title="&#xD14D;&#xC2A4;&#xD2B8;"><input type="radio" name="pollGlobalOptionType" value="TEXT" checked onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12M12 6v12M8.5 18h7"/></svg><b class="poll-type-text">&#xD14D;&#xC2A4;&#xD2B8;</b></span></label>
            <label class="poll-type-option" title="&#xC77C;&#xC815;"><input type="radio" name="pollGlobalOptionType" value="SCHEDULE" onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="6" width="15" height="13" rx="2.5"/><path d="M8 4v4M16 4v4M4.5 10h15"/></svg><b class="poll-type-text">&#xC77C;&#xC815;</b></span></label>
            <label class="poll-type-option" title="&#xC774;&#xBBF8;&#xC9C0;"><input type="radio" name="pollGlobalOptionType" value="IMAGE" onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2.5"/><circle cx="9" cy="10" r="1.5"/><path d="m6.5 17 4.2-4.2 2.8 2.8 2-2 2 2"/></svg><b class="poll-type-text">&#xC774;&#xBBF8;&#xC9C0;</b></span></label>
            <label class="poll-type-option" title="&#xC74C;&#xC545;"><input type="radio" name="pollGlobalOptionType" value="AUDIO" onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17.2V7.5l8-1.7v9.7"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="15.5" cy="15.8" r="2.5"/></svg><b class="poll-type-text">&#xC74C;&#xC545;</b></span></label>
            <label class="poll-type-option" title="&#xC601;&#xC0C1;"><input type="radio" name="pollGlobalOptionType" value="VIDEO" onchange="switchGlobalPollOptionType(this.value)"><span><svg class="poll-type-icon poll-type-icon--play" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2.5"/><path d="m10 9 5 3-5 3Z"/></svg><b class="poll-type-text">&#xC601;&#xC0C1;</b></span></label>
          </div><button type="button" class="poll-add-option" onclick="addPollOptionRow()" title="&#xC120;&#xD0DD;&#xC9C0; &#xCD94;&#xAC00;" aria-label="&#xC120;&#xD0DD;&#xC9C0; &#xCD94;&#xAC00;">+</button><button type="button" class="poll-remove-last" onclick="removeLastPollOptionRow()" title="&#xB9C8;&#xC9C0;&#xB9C9; &#xC120;&#xD0DD;&#xC9C0; &#xC0AD;&#xC81C;" aria-label="&#xB9C8;&#xC9C0;&#xB9C9; &#xC120;&#xD0DD;&#xC9C0; &#xC0AD;&#xC81C;">&#x2212;</button></div></div>
          <div id="pollOptionInputs" class="poll-option-input-list"></div>
        </div>
        <div class="poll-form-actions"><button type="button" id="pollSubmitButton" class="poll-create-btn" onclick="savePoll()">&#xD22C;&#xD45C; &#xC0DD;&#xC131;</button></div>
      </div>
    </div>
  </div>
<style>

/* ===== common poll form modal: self-contained styles ===== */
.poll-modal{--poll-form-grad:linear-gradient(135deg,#3fd4bf 0%,#4b8df8 54%,#7b63f6 100%)}
body.poll-modal-open{overflow:hidden}
.poll-modal{position:fixed;inset:0;z-index:3000;display:none;align-items:center;justify-content:center;padding:24px}
.poll-modal.open{display:flex}
.poll-modal-backdrop{position:absolute;inset:0;background:rgba(18,29,43,.46);backdrop-filter:blur(4px)}
.poll-modal-dialog{position:relative;z-index:1;width:min(690px,100%);height:min(700px,calc(100dvh - 48px));max-height:calc(100dvh - 48px);overflow:hidden;border:1px solid #e1e7ee;border-radius:20px;background:#fff;box-shadow:0 30px 80px rgba(19,33,50,.22)}
.poll-extend-dialog{width:min(500px,100%)}
.poll-modal-body{display:flex;flex-direction:column;height:100%;min-height:0;padding:26px 28px 24px}
.poll-modal-header{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid #edf1f5}
.poll-modal-header h3{margin:0;color:#1d2a3a;font-size:19px;font-weight:900;letter-spacing:-.035em}
.poll-modal-close{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;border:0;border-radius:50%;background:transparent;color:#75849a;font-size:20px;line-height:1;cursor:pointer;transition:background .15s ease,color .15s ease}
.poll-modal-close:is(:hover,:focus-visible,:active){border-radius:50%;background:#edf2f7;color:#4f6077;outline:none}
.poll-form-row{display:flex;flex-direction:column;gap:9px;margin-bottom:18px}
.poll-form-row>label,.form-label-row>label{color:#42536b;font-size:11.5px;font-weight:900;letter-spacing:-.01em}
.poll-input{width:100%;height:42px;padding:0 12px;border:1px solid #dce4ec;border-radius:11px;background:#fff;color:#28364a;font-size:11.5px;font-weight:700;outline:none;transition:.15s ease}
.poll-input::placeholder{color:#a2adba}
.poll-input:hover{border-color:#cfd9e4}
.poll-input:focus{border-color:#8dbcf0;box-shadow:0 0 0 3px rgba(75,141,248,.09)}
.poll-native-time-select,.poll-date-raw{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important;opacity:0!important;pointer-events:none!important}
.poll-visibility-row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 15px;border:1px solid #e1e7ee;border-radius:13px;background:#fbfcfe}
.poll-visibility-copy{min-width:0}.poll-visibility-title{display:block;color:#33445b;font-size:11.5px;font-weight:900}.poll-visibility-desc{display:block;margin-top:4px;color:#8b98a9;font-size:10px;font-weight:700;line-height:1.5}
.poll-switch{position:relative;display:inline-flex;flex:0 0 auto;width:44px;height:25px}.poll-switch input{position:absolute;opacity:0;pointer-events:none}.poll-switch-track{position:absolute;inset:0;border-radius:999px;background:#dce4ed;cursor:pointer;transition:.18s ease}.poll-switch-track:after{content:"";position:absolute;left:3px;top:3px;width:19px;height:19px;border-radius:50%;background:#fff;box-shadow:0 2px 7px rgba(31,47,67,.18);transition:.18s ease}.poll-switch input:checked+.poll-switch-track{background:var(--poll-form-grad)}.poll-switch input:checked+.poll-switch-track:after{transform:translateX(19px)}.poll-switch input:focus-visible+.poll-switch-track{outline:3px solid rgba(75,141,248,.18);outline-offset:2px}
.form-label-row{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:1px}.poll-option-toolbar{display:flex;align-items:center;gap:7px}.global-option-type-switch+.poll-add-option{margin-left:5px}
.global-option-type-switch{display:grid;grid-template-columns:repeat(5,auto);padding:2px;border:1px solid #dfe6ee;border-radius:11px;background:#f8fafc}.poll-type-option{position:relative}.poll-type-option input{position:absolute;opacity:0;pointer-events:none}.poll-type-option span{display:flex;align-items:center;justify-content:center;height:30px;padding:0 11px;border-radius:8px;background:transparent;color:#7c8ca0;font-size:10px;font-weight:850;cursor:pointer;transition:.15s ease}.poll-type-option input:checked+span{background:#fff;color:#397fcf;box-shadow:0 2px 7px rgba(45,72,105,.08)}.poll-type-option span{gap:5px}.poll-type-text{font:inherit;font-weight:inherit}.poll-type-icon{display:none;width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.poll-type-icon--play path:last-child{fill:currentColor;stroke:none}
.poll-add-option,.poll-remove-last{display:grid;place-items:center;width:34px;height:34px;border:1px solid #dce4ec;border-radius:10px;background:#fff;color:#60718a;font-size:17px;font-weight:800;cursor:pointer;transition:.15s ease}.poll-add-option:hover,.poll-remove-last:hover{border-color:#c5d8ed;background:#f8fbff;color:#397fcf}
.poll-options-row{display:flex;flex:1 1 auto;min-height:0;margin-bottom:10px;overflow:hidden}.poll-options-row .form-label-row{flex:0 0 auto}.poll-option-input-list{display:flex;flex:1 1 auto;min-height:0;flex-direction:column;gap:9px;max-height:none;overflow-y:auto;overflow-x:hidden;padding:1px 5px 8px 0;overscroll-behavior:contain;scrollbar-gutter:stable}.poll-option-input-list::-webkit-scrollbar{width:6px}.poll-option-input-list::-webkit-scrollbar-thumb{background:#d8e0e8;border-radius:999px}
.poll-options-row{max-height:none}.poll-options-row .poll-option-input-list{height:auto}.poll-form-actions{position:relative;z-index:2;background:#fff}

.poll-option-edit-row{display:grid;grid-template-columns:30px minmax(0,1fr);gap:9px;align-items:start}.poll-option-edit-row>.option-number{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:#f1f5fa;color:#6d819b;font-size:10px;font-weight:900;margin-top:7px}.poll-option-edit-main{min-width:0}
/* text/schedule/audio/video share one option index rail; image keeps its card-specific badge */
.poll-option-edit-row:is(.text-mode,.schedule-mode,.audio-mode,.video-mode){grid-template-columns:30px minmax(0,1fr);gap:9px;align-items:start}
.poll-option-edit-row:is(.text-mode,.schedule-mode,.audio-mode,.video-mode)>.option-number{width:26px;height:26px;margin-top:8px;align-self:start;border-radius:50%;background:#f3f6fa;color:#71849c;font-size:10px;font-weight:900}
.poll-option-image-block,.poll-option-audio-block,.poll-option-video-block,.poll-option-schedule-block{display:none}.poll-option-edit-row.image-mode .poll-option-text-input,.poll-option-edit-row.audio-mode .poll-option-text-input,.poll-option-edit-row.video-mode .poll-option-text-input,.poll-option-edit-row.schedule-mode .poll-option-text-input{display:none}.poll-option-edit-row.image-mode .poll-option-image-block,.poll-option-edit-row.audio-mode .poll-option-audio-block,.poll-option-edit-row.video-mode .poll-option-video-block,.poll-option-edit-row.schedule-mode .poll-option-schedule-block{display:block}

.poll-option-edit-row.schedule-mode{align-items:start}.poll-option-schedule-block{width:100%;min-width:0}.poll-schedule-grid{display:grid;grid-template-columns:minmax(176px,1.55fr) minmax(122px,1fr) 14px minmax(122px,1fr);gap:8px;align-items:center}.poll-schedule-field{position:relative;min-width:0}.poll-schedule-field .poll-input{height:42px;padding-right:35px;cursor:pointer}.poll-schedule-field .poll-input[readonly]{background:#fff}.poll-schedule-trigger{position:absolute;right:7px;top:50%;transform:translateY(-50%);display:grid;place-items:center;width:26px;height:26px;border:0;border-radius:8px;background:transparent;color:#7890ad;cursor:pointer}.poll-schedule-trigger:hover{background:#f0f5fb;color:#397fcf}.poll-schedule-trigger svg{width:15px;height:15px}.poll-schedule-sep{display:grid;place-items:center;width:14px;color:#91a0b2;font-size:11px;font-weight:900;line-height:1}.poll-schedule-error{display:none;margin:5px 0 0;color:#e45151;font-size:9.5px;font-weight:800;line-height:1.4}.poll-option-edit-row.schedule-mode.has-schedule-error .poll-schedule-error{display:block}.poll-option-edit-row.schedule-mode.has-schedule-error .poll-schedule-field .poll-input{border-color:#efb1b1;box-shadow:0 0 0 3px rgba(228,81,81,.06)}.poll-option-input-list.schedule-edit-list{align-content:start}.poll-option-input-list.schedule-edit-list.has-scroll{scrollbar-gutter:stable}.poll-option-input-list.schedule-edit-list.has-scroll::-webkit-scrollbar-thumb{background:#cfd9e4}.poll-option-input-list.schedule-edit-list .poll-option-edit-row{flex:0 0 auto}@media(max-width:640px){.poll-schedule-grid{grid-template-columns:1fr 1fr;}.poll-schedule-grid .poll-schedule-date-field{grid-column:1/-1}.poll-schedule-sep{display:none}.poll-option-edit-row.schedule-mode>.option-number{align-self:start;margin-top:8px}}
.poll-option-edit-row.text-mode .poll-option-edit-main{display:flex;align-items:center;min-height:42px}.poll-option-edit-row.text-mode .poll-option-text-input{height:42px;margin:0;padding:0 12px;border-radius:11px;font-size:11.5px}
.poll-file-label,.poll-media-upload{display:flex;align-items:center;justify-content:center;min-height:102px;border:1px dashed #c7d4e2;border-radius:12px;background:#fafcff;cursor:pointer;transition:.15s ease}.poll-file-label:hover,.poll-media-upload:hover{border-color:#9fc6ee;background:#f7fbff}.poll-file-label input,.poll-media-upload input{display:none}.poll-upload-tile-content{text-align:center}.poll-upload-plus{display:block;color:#6685ad;font-size:21px;line-height:1}.poll-upload-tile-content strong,.poll-audio-upload-text{display:block;margin-top:3px;color:#4d617c;font-size:10.5px;font-weight:900}.poll-upload-help,.poll-audio-upload-help{display:block;margin-top:4px;color:#98a5b5;font-size:9.5px;line-height:1.45;text-align:center}
.poll-option-image-frame{position:relative;display:none;margin-top:8px;overflow:hidden;border-radius:11px;border:1px solid #e1e7ee;background:#f7f9fb}.poll-option-image-frame.visible{display:block}.poll-image-preview{display:block;width:100%;max-height:220px;object-fit:contain;background:#f7f9fb}.poll-option-image-remove{position:absolute;right:8px;top:8px;display:grid;place-items:center;width:28px;height:28px;border:1px solid rgba(255,255,255,.8);border-radius:9px;background:rgba(28,39,54,.58);color:#fff;font-size:16px;cursor:pointer}.poll-image-name{display:block;margin-top:6px;color:#8997a8;font-size:9.5px;font-weight:700}
.poll-option-audio-block{display:none}.poll-option-edit-row.audio-mode .poll-option-audio-block{display:grid;grid-template-columns:1fr;gap:8px}.poll-option-audio-block.has-audio .poll-media-upload{min-height:64px}.poll-media-title{margin-top:0}.poll-audio-preview{display:none;width:100%;height:36px}.poll-option-audio-block.has-audio .poll-audio-preview{display:block}.poll-option-video-block .poll-input{width:100%}

/* image option editor: compact MOYO card grid */
.poll-option-input-list.image-edit-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
  flex:1;
  min-height:0;
  max-height:none;
  overflow:auto;
  align-content:start;
  padding:1px 5px 1px 0;
}
.poll-option-input-list.image-edit-grid .poll-option-edit-row{
  position:relative;
  display:block;
  min-width:0;
}
.poll-option-input-list.image-edit-grid .poll-option-edit-row>.option-number{
  position:absolute;
  left:10px;
  top:10px;
  z-index:4;
  display:grid;
  place-items:center;
  width:26px;
  height:26px;
  margin:0;
  border-radius:8px;
  background:rgba(255,255,255,.94);
  color:#5376a4;
  box-shadow:0 4px 12px rgba(23,38,58,.09);
  font-size:10px;
  font-weight:900;
}
.poll-option-input-list.image-edit-grid .poll-option-edit-main{width:100%;min-width:0}
.poll-option-input-list.image-edit-grid .poll-option-image-block{
  position:relative;
  display:block;
  min-width:0;
  overflow:visible;
}
.poll-option-input-list.image-edit-grid .poll-file-label{
  height:188px;
  min-height:188px;
  padding:14px 12px;
  border-color:#cdd9e6;
  border-radius:14px;
  background:#fbfcfe;
}
.poll-option-input-list.image-edit-grid .poll-file-label:hover,
.poll-option-input-list.image-edit-grid .poll-option-image-block.row-dragover .poll-file-label{
  border-color:#91bce8;
  background:#f7fbff;
  box-shadow:0 0 0 3px rgba(75,141,248,.06);
}
.poll-option-input-list.image-edit-grid .poll-option-image-block.has-image .poll-file-label{display:none}
.poll-option-input-list.image-edit-grid .poll-option-image-frame{
  width:100%;
  height:188px;
  min-height:188px;
  margin:0;
  border-radius:14px;
  background:#f5f7fa;
}
.poll-option-input-list.image-edit-grid .poll-option-image-frame.visible{display:block}
.poll-option-input-list.image-edit-grid .poll-image-preview{
  width:100%;
  height:100%;
  max-height:none;
  max-width:100%;
  max-height:100%;
  object-fit:contain!important;
  object-position:center center!important;
}
.poll-option-input-list.image-edit-grid .poll-option-image-remove{
  right:8px;
  top:8px;
  width:27px;
  height:27px;
  border-radius:50%;
}
.poll-option-input-list.image-edit-grid .poll-option-image-remove:hover{background:rgba(28,39,54,.72);transform:scale(1.04)}
.poll-option-input-list.image-edit-grid .poll-option-image-remove:active{background:rgba(28,39,54,.82);transform:scale(.96)}
.poll-option-input-list.image-edit-grid .poll-image-name{
  display:block;
  width:100%;
  height:20px;
  max-width:100%;
  min-width:0;
  margin-top:5px;
  padding:0 2px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  color:#8391a3;
  font-size:9px;
  font-weight:720;
  line-height:20px;
}
.poll-option-input-list.image-edit-grid{padding-bottom:12px;scrollbar-width:thin;scrollbar-color:#dbe4ed transparent}
.poll-option-input-list.image-edit-grid::-webkit-scrollbar{width:4px}
.poll-option-input-list.image-edit-grid::-webkit-scrollbar-track{background:transparent}
.poll-option-input-list.image-edit-grid::-webkit-scrollbar-thumb{background:#dbe4ed;border-radius:999px}
.poll-option-input-list.image-edit-grid .poll-option-edit-row{align-self:start}
@media(max-width:720px){
  .poll-option-input-list.image-edit-grid{grid-template-columns:1fr}
}
.poll-form-actions{display:flex;flex:0 0 auto;gap:8px;margin-top:8px;padding-top:4px}.poll-create-btn{display:flex;align-items:center;justify-content:center;width:100%;height:44px;border:0;border-radius:12px;background:var(--poll-form-grad);color:#fff;font-size:11.5px;font-weight:900;cursor:pointer;box-shadow:0 9px 20px rgba(75,141,248,.18);transition:.15s ease}.poll-create-btn:hover{transform:translateY(-1px);box-shadow:0 12px 24px rgba(75,141,248,.22)}
.poll-static-value{display:flex;align-items:center;min-height:42px;padding:0 12px;border-radius:11px;background:#f6f8fa;color:#6d7a8a;font-size:11px;font-weight:780}
@media(max-width:680px){.poll-modal{padding:10px}.poll-modal-dialog{height:calc(100dvh - 20px);max-height:calc(100dvh - 20px)}.poll-modal-body{padding:20px 16px}.form-label-row{align-items:flex-start;flex-direction:column}.poll-option-toolbar{width:100%;justify-content:space-between}.global-option-type-switch{grid-template-columns:repeat(4,1fr);flex:1}.poll-type-option span{padding:0 5px}.poll-option-input-list{max-height:none}}
/* poll deadline picker: reuse MOYO quick-create interaction language */
.poll-deadline-grid--moyo{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(180px,.65fr);gap:10px;align-items:center}
.poll-date-control,.poll-time-control{position:relative;min-width:0}
.poll-date-display,.poll-time-display{width:100%;height:42px;padding-right:42px;font-variant-numeric:tabular-nums;cursor:pointer}
.poll-time-display{padding-left:58px}
.poll-date-trigger svg,.poll-time-trigger svg{width:17px;height:17px;display:block}
.moyo-quick-date-trigger,.moyo-quick-time-trigger{position:absolute;top:50%;right:10px;transform:translateY(-50%);width:26px;height:26px;border:0;border-radius:9px;background:transparent;color:#24415f;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.moyo-quick-date-trigger:hover,.moyo-quick-time-trigger:hover{background:#eef5ff;color:#2f6dff}
.moyo-quick-time-meridiem{position:absolute;left:13px;top:50%;transform:translateY(-50%);z-index:1;padding:2px 7px;border-radius:999px;font-size:11px;font-weight:680;letter-spacing:-.03em;pointer-events:none}
.moyo-quick-time-meridiem.is-am{background:#e9fbf7;color:#0f9f8f}.moyo-quick-time-meridiem.is-pm{background:#eef4ff;color:#245eea}
.moyo-quick-picker-menu{position:fixed;z-index:10060;border:1px solid rgba(126,164,255,.28);border-radius:17px;background:#fff;box-shadow:0 14px 28px rgba(30,64,122,.12);padding:10px;color:#1f2c43;overflow:hidden}
body.poll-embed-create > .poll-picker-portal{visibility:visible!important}
.moyo-quick-picker-menu[hidden]{display:none!important}.moyo-quick-date-picker-menu{width:248px}.moyo-quick-time-picker-menu{width:268px}
.moyo-quick-date-picker-head,.moyo-quick-time-picker-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}
.moyo-quick-date-picker-title,.moyo-quick-time-picker-title{font-size:13px;font-weight:900;letter-spacing:-.03em;color:#0f1e33}
.moyo-quick-date-picker-nav{display:inline-flex;gap:4px}.moyo-quick-date-picker-nav button,.moyo-quick-time-picker-now{border:1px solid #d7e4f5;background:rgba(255,255,255,.78);color:#55708f;font-weight:740;cursor:pointer}
.moyo-quick-date-picker-nav button{width:25px;height:25px;padding:0;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;line-height:1}.moyo-quick-date-picker-nav button span{display:block;line-height:1;transform:translateY(-1px)}.moyo-quick-time-picker-now{height:28px;padding:0 9px;border-radius:10px;font-size:12px}
.moyo-quick-date-picker-nav button:hover,.moyo-quick-time-picker-now:hover{border-color:#9fc0ff;background:#f3f7ff;color:#2563eb}
.moyo-quick-date-picker-weekdays,.moyo-quick-date-picker-days{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}.moyo-quick-date-picker-weekdays{margin-bottom:5px}
.moyo-quick-date-picker-weekdays span{height:20px;display:flex;align-items:center;justify-content:center;color:#7c8aa0;font-size:11px;font-weight:900}.moyo-quick-date-picker-weekdays span:first-child{color:#ff6b87}.moyo-quick-date-picker-weekdays span:last-child{color:#4f7cff}
.moyo-quick-date-picker-day{height:27px;border:1px solid transparent;border-radius:10px;background:transparent;color:#1f2c43;font-size:12px;font-weight:720;cursor:pointer}.moyo-quick-date-picker-day:nth-child(7n+1){color:#ff5d7a}.moyo-quick-date-picker-day:nth-child(7n){color:#4f7cff}.moyo-quick-date-picker-day:hover{border-color:#aac7ff;background:#f5f8ff;color:#2563eb}.moyo-quick-date-picker-day.is-muted{color:#b1bdca!important}.moyo-quick-date-picker-day.is-today{border-color:#64d6ca;color:#0f9f8f;background:#eefcf9}.moyo-quick-date-picker-day.is-selected{border-color:transparent;background:#5d7cff;color:#fff!important;box-shadow:0 7px 14px rgba(79,124,255,.18)}.moyo-quick-date-picker-day:disabled{color:#ccd3db!important;cursor:not-allowed;background:transparent!important;box-shadow:none!important}
.moyo-quick-date-picker-foot{display:flex;justify-content:flex-end;margin-top:10px}.moyo-quick-date-picker-today{height:25px;padding:0 9px;border:1px solid #d7e4f5;border-radius:999px;background:rgba(255,255,255,.78);color:#55708f;font-size:11px;font-weight:740;cursor:pointer}.moyo-quick-date-picker-today:disabled{opacity:.42;cursor:not-allowed;background:#f5f7fa;color:#9aa8b8}
.moyo-quick-time-picker-ampm{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-bottom:9px}.moyo-quick-time-picker-ampm button,.moyo-quick-time-picker-grid button{height:30px;border:1px solid #dbe6f5;border-radius:10px;background:#fff;color:#334155;font-size:12px;font-weight:720;cursor:pointer}.moyo-quick-time-picker-ampm button:hover,.moyo-quick-time-picker-grid button:hover{border-color:#aac7ff;background:#f5f8ff;color:#2563eb}.moyo-quick-time-picker-ampm button[data-meridiem="AM"]{background:#fbfffe}.moyo-quick-time-picker-ampm button[data-meridiem="PM"]{background:#fbfcff}.moyo-quick-time-picker-ampm button[data-meridiem="AM"].is-selected{border-color:#5ad0c0;background:#e9fbf7;color:#0f9f8f}.moyo-quick-time-picker-ampm button[data-meridiem="PM"].is-selected{border-color:#5d86ff;background:#eef4ff;color:#245eea}.moyo-quick-time-picker-grid button.is-selected{border-color:#2f6dff;background:#2f6dff;color:#fff}.moyo-quick-time-picker-section{margin-top:8px}.moyo-quick-time-picker-label{margin-bottom:5px;color:#68778d;font-size:11px;font-weight:720}.moyo-quick-time-picker-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:5px}
/* option row alignment: number chip and text input share one center line */
.poll-option-input-list .poll-option-edit-row.text-mode{align-items:center!important;}
.poll-option-input-list .poll-option-edit-row.text-mode>.option-number{margin-top:0!important;align-self:center;}
.poll-option-input-list .poll-option-edit-row.text-mode .poll-option-edit-main{display:flex;align-items:center;min-height:42px;}
.poll-option-input-list .poll-option-edit-row.text-mode .poll-option-text-input{margin:0;}

/* audio option editor: compact track-style rows; two defaults fit before scrolling */
.poll-option-input-list .poll-option-edit-row.audio-mode{
  grid-template-columns:30px minmax(0,1fr);
  gap:9px;
  align-items:start;
}
.poll-option-input-list .poll-option-edit-row.audio-mode>.option-number{
  margin-top:8px!important;
  align-self:start;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-edit-main{min-width:0}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-audio-block{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(150px,190px);
  gap:8px 10px;
  align-items:center;
  min-width:0;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-media-upload{
  min-height:42px;
  height:42px;
  padding:0 12px;
  border-radius:11px;
  flex-direction:row;
  gap:7px;
  justify-content:flex-start;
  overflow:hidden;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-upload-text{
  display:inline;
  margin:0;
  flex:0 0 auto;
  font-size:10.5px;
  white-space:nowrap;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-upload-help{
  display:block;
  min-width:0;
  margin:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  text-align:left;
  font-size:9.5px;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-media-title{
  height:42px;
  margin:0;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-preview{
  grid-column:1 / -1;
  width:100%;
  height:34px;
  margin:0;
}
.poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-audio-block.has-audio .poll-media-upload{
  min-height:42px;
  height:42px;
}
@media(max-width:680px){
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-audio-block{grid-template-columns:1fr}
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-preview{grid-column:auto}
}

@media(max-width:720px){.poll-deadline-grid--moyo{grid-template-columns:1fr}.poll-time-control{min-width:0}}

/* ===== poll form mobile final regression (360-430px) ===== */
@media(max-width:680px){
  .poll-modal{padding:8px}
  /* Mobile: fit the dialog to its content; cap it to the viewport instead of forcing full height. */
  .poll-modal-dialog{width:100%;height:auto;max-height:calc(100dvh - 16px);border-radius:17px}
  .poll-modal-body{height:auto;max-height:calc(100dvh - 16px);padding:17px 14px 14px;overflow:hidden}
  .poll-modal-header{flex:0 0 auto;margin-bottom:16px;padding-bottom:13px}
  .poll-modal-header h3{font-size:18px}
  .poll-modal-close{width:32px;height:32px;background:transparent!important;box-shadow:none}
  .poll-modal-close:not(:hover):not(:focus-visible):not(:active){background:transparent!important}

  .poll-form-row{gap:7px;margin-bottom:13px}
  .poll-input{height:40px}
  .poll-visibility-row{gap:12px;padding:11px 12px}
  .poll-visibility-desc{font-size:9.5px}

  /* Only the option area scrolls once its content grows beyond the mobile cap. */
  .poll-options-row{flex:0 1 auto;min-height:0;max-height:min(38dvh,320px);margin-bottom:7px;overflow:hidden}
  .poll-options-row .form-label-row{gap:8px}
  .form-label-row{align-items:stretch;flex-direction:column}
  .poll-option-toolbar{display:flex;width:100%;flex-wrap:nowrap;align-items:center;justify-content:flex-start;gap:6px}
  .global-option-type-switch{grid-template-columns:repeat(5,minmax(0,1fr));flex:1 1 auto;width:auto;min-width:0}
  .poll-type-option{min-width:0}
  .poll-type-option span{min-width:0;height:32px;padding:0 3px;font-size:9.5px;white-space:nowrap}
  .global-option-type-switch+.poll-add-option{margin-left:2px}
  .poll-add-option,.poll-remove-last{flex:0 0 32px;width:32px;height:32px}

  .poll-option-input-list{flex:0 1 auto;min-height:0;max-height:min(38dvh,320px);padding-right:2px;overflow-y:auto;overflow-x:hidden;scrollbar-gutter:auto}
  .poll-option-input-list.image-edit-grid{max-height:min(44dvh,360px)}
  .poll-option-edit-row:is(.text-mode,.schedule-mode,.audio-mode,.video-mode){grid-template-columns:27px minmax(0,1fr);gap:7px}
  .poll-option-edit-row:is(.text-mode,.schedule-mode,.audio-mode,.video-mode)>.option-number{width:25px;height:25px;font-size:9.5px}

  .poll-schedule-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:7px}
  .poll-schedule-grid .poll-schedule-date-field{grid-column:1/-1}
  .poll-schedule-sep{display:none}
  .poll-schedule-field .poll-input{height:40px;padding-left:10px;padding-right:31px;font-size:10.5px}
  .poll-schedule-trigger{right:4px;width:25px;height:25px}
  .poll-schedule-error{font-size:9px}

  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-option-audio-block{grid-template-columns:1fr}
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-media-upload,
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-media-title{height:40px;min-height:40px}
  .poll-option-input-list .poll-option-edit-row.audio-mode .poll-audio-preview{grid-column:auto;min-width:0}

  .poll-option-input-list.image-edit-grid{grid-template-columns:1fr;gap:10px}
  .poll-option-input-list.image-edit-grid .poll-file-label,
  .poll-option-input-list.image-edit-grid .poll-option-image-frame{height:168px;min-height:168px}

  .poll-form-actions{flex:0 0 auto;margin-top:6px;padding-top:5px;background:#fff}
  .poll-create-btn{height:42px}

  .poll-deadline-grid--moyo{grid-template-columns:1fr;gap:7px}
  .poll-date-display,.poll-time-display{height:40px}
  .moyo-quick-picker-menu{max-width:calc(100vw - 20px)}
  .moyo-quick-date-picker-menu{width:min(248px,calc(100vw - 20px))}
  .moyo-quick-time-picker-menu{width:min(268px,calc(100vw - 20px))}
}
@media(max-width:480px){
  .poll-option-toolbar{gap:5px}
  .global-option-type-switch{padding:2px;gap:0}
  .poll-type-option span{height:32px;padding:0}
  .poll-type-option .poll-type-text{display:none}
  .poll-type-option .poll-type-icon{display:block}
  .poll-add-option,.poll-remove-last{flex-basis:32px;width:32px;height:32px}
}
@media(max-width:390px){
  .poll-modal-body{padding:15px 12px 12px}
  .poll-modal-header{margin-bottom:14px}
  .poll-type-option span{font-size:9px;padding:0 2px}
  .poll-visibility-row{padding:10px 11px}
  .poll-option-input-list.image-edit-grid .poll-file-label,
  .poll-option-input-list.image-edit-grid .poll-option-image-frame{height:154px;min-height:154px}
}

</style>
<script>
/* ===== common poll form controls: deadline + schedule option pickers ===== */
(function(){
  'use strict';

  const WEEKDAYS=['\uC77C','\uC6D4','\uD654','\uC218','\uBAA9','\uAE08','\uD1A0'];
  const MINUTES=[0,5,10,15,20,25,30,35,40,45,50,55];
  const pad=n=>String(n).padStart(2,'0');
  const state={dateMenu:null,timeMenu:null,dateView:null,timeState:null,target:null,kind:null,bound:false};

  function modal(){return document.getElementById('pollFormModal')}
  function parseDate(value){
    const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value||''));
    if(!m)return null;
    const d=new Date(Number(m[1]),Number(m[2])-1,Number(m[3]));
    if(d.getFullYear()!==Number(m[1])||d.getMonth()!==Number(m[2])-1||d.getDate()!==Number(m[3]))return null;
    d.setHours(0,0,0,0);
    return d;
  }
  function formatDate(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}
  function today(){const d=new Date();d.setHours(0,0,0,0);return d}
  function sameDate(a,b){return !!(a&&b&&a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate())}
  function roundUpToFive(date){
    const d=new Date(date);
    d.setSeconds(0,0);
    const rem=d.getMinutes()%5;
    if(rem)d.setMinutes(d.getMinutes()+(5-rem));
    return d;
  }
  function formatDateLabel(value){const d=parseDate(value);return d?value+' ('+WEEKDAYS[d.getDay()]+')':String(value||'')}
  function formatTimeLabel(value){
    const m=/^(\d{2}):(\d{2})$/.exec(String(value||''));
    if(!m)return '';
    const h=Number(m[1]),min=Number(m[2]);
    return (h>=12?'\uC624\uD6C4 ':'\uC624\uC804 ')+pad(h%12||12)+':'+pad(min);
  }
  function getDeadlineParts(){
    const date=document.getElementById('pollEndDateInput')?.value||'';
    const hour=document.getElementById('pollEndHourInput')?.value||'';
    const minute=document.getElementById('pollEndMinuteInput')?.value||'';
    return {date,hour,minute};
  }
  function getDeadlineDateTime(){
    const v=getDeadlineParts();
    if(!v.date||v.hour===''||v.minute==='')return null;
    const d=new Date(v.date+'T'+v.hour+':'+v.minute+':00');
    return Number.isNaN(d.getTime())?null:d;
  }
  function isDeadlineInPast(){
    const deadline=getDeadlineDateTime();
    return !!(deadline&&deadline.getTime()<=Date.now());
  }
  function ensureSelectOptions(){
    const hour=document.getElementById('pollEndHourInput');
    const minute=document.getElementById('pollEndMinuteInput');
    if(hour&&hour.options.length!==24){
      const current=hour.value;
      hour.innerHTML=Array.from({length:24},(_,h)=>'<option value="'+pad(h)+'">'+pad(h)+'</option>').join('');
      hour.value=/^\d{2}$/.test(current)?current:'18';
    }
    if(minute&&minute.options.length!==12){
      const current=minute.value;
      minute.innerHTML=MINUTES.map(m=>'<option value="'+pad(m)+'">'+pad(m)+'</option>').join('');
      minute.value=MINUTES.includes(Number(current))?pad(Number(current)):'00';
    }
  }
  function syncDeadlineDisplay(){
    ensureSelectOptions();
    const raw=document.getElementById('pollEndDateInput');
    const dateDisplay=document.getElementById('pollEndDateDisplay');
    if(raw&&dateDisplay)dateDisplay.value=formatDateLabel(raw.value);
    const parts=getDeadlineParts();
    const timeDisplay=document.getElementById('pollEndTimeDisplay');
    const meridiem=document.getElementById('pollEndTimeMeridiem');
    if(timeDisplay&&meridiem&&parts.hour!==''){
      const h=Number(parts.hour),m=Number(parts.minute||0),pm=h>=12;
      timeDisplay.value=pad(h%12||12)+':'+pad(m);
      meridiem.textContent=pm?'\uC624\uD6C4':'\uC624\uC804';
      meridiem.classList.toggle('is-am',!pm);
      meridiem.classList.toggle('is-pm',pm);
    }
  }
  function initializeDeadline(force){
    ensureSelectOptions();
    const raw=document.getElementById('pollEndDateInput');
    const hour=document.getElementById('pollEndHourInput');
    const minute=document.getElementById('pollEndMinuteInput');
    if(!raw||!hour||!minute)return;
    if(force||!parseDate(raw.value)){
      const d=today();d.setDate(d.getDate()+1);
      raw.value=formatDate(d);
    }
    if(force||!/^\d{2}$/.test(hour.value))hour.value='18';
    if(force||!/^\d{2}$/.test(minute.value))minute.value='00';
    syncDeadlineDisplay();
  }
  function emitDeadlineChange(source){
    if(source)source.dispatchEvent(new Event('change',{bubbles:true}));
    syncDeadlineDisplay();
  }
  function emitScheduleChange(input){
    if(!input)return;
    input.dispatchEvent(new CustomEvent('moyo:poll-schedule-change',{bubbles:true,detail:{
      kind:input.classList.contains('poll-schedule-date')?'date':'time',
      value:input.dataset.value||''
    }}));
  }
  function setScheduleDate(input,value,opts){
    if(!input)return;
    input.dataset.value=value||'';
    input.value=value?formatDateLabel(value):'';
    if(!opts||opts.emit!==false)emitScheduleChange(input);
  }
  function setScheduleTime(input,value,opts){
    if(!input)return;
    const m=/^(\d{2}):(\d{2})$/.exec(String(value||''));
    if(!m){input.dataset.value='';input.value='';if(!opts||opts.emit!==false)emitScheduleChange(input);return}
    const h=Number(m[1]),min=Number(m[2]);
    const normalized=pad(h)+':'+pad(min);
    input.dataset.value=normalized;
    input.value=formatTimeLabel(normalized);
    if(!opts||opts.emit!==false)emitScheduleChange(input);
  }
  function makePortal(className){
    const el=document.createElement('div');
    el.className='moyo-quick-picker-menu poll-picker-portal '+className;
    el.hidden=true;
    document.body.appendChild(el);
    return el;
  }
  function ensureDateMenu(){
    if(state.dateMenu&&state.dateMenu.isConnected)return state.dateMenu;
    state.dateMenu=makePortal('moyo-quick-date-picker-menu');
    state.dateMenu.addEventListener('click',function(e){
      e.preventDefault();e.stopPropagation();
      const b=e.target.closest('button');if(!b)return;
      if(state.kind==='schedule-date'&&!state.target)return;
      if(b.dataset.nav){state.dateView.setMonth(state.dateView.getMonth()+Number(b.dataset.nav));renderDateMenu();return}
      let value=b.dataset.date||'';
      if(b.dataset.action==='today')value=formatDate(today());
      if(!value)return;
      const picked=parseDate(value),min=minDateForCurrentKind();
      if(!picked||(min&&picked<min))return;
      if(state.kind==='deadline-date'){
        const raw=document.getElementById('pollEndDateInput');raw.value=value;emitDeadlineChange(raw);
      }else if(state.kind==='schedule-date'){
        setScheduleDate(state.target,value);
      }
      closePickers();
    });
    return state.dateMenu;
  }
  function minDateForCurrentKind(){
    if(state.kind==='deadline-date')return today();
    if(state.kind==='schedule-date'){
      const deadline=getDeadlineDateTime();
      if(deadline){const d=new Date(deadline);d.setHours(0,0,0,0);return d}
    }
    return null;
  }
  function selectedDateForCurrentKind(){
    if(state.kind==='deadline-date')return parseDate(document.getElementById('pollEndDateInput')?.value||'');
    if(state.kind==='schedule-date')return parseDate(state.target?.dataset.value||'');
    return null;
  }
  function renderDateMenu(){
    const menu=ensureDateMenu();
    const selected=selectedDateForCurrentKind();
    const min=minDateForCurrentKind();
    const first=new Date(state.dateView.getFullYear(),state.dateView.getMonth(),1);
    const start=new Date(state.dateView.getFullYear(),state.dateView.getMonth(),1-first.getDay());
    let days='';
    for(let i=0;i<42;i++){
      const d=new Date(start);d.setDate(start.getDate()+i);d.setHours(0,0,0,0);
      const val=formatDate(d),muted=d.getMonth()!==state.dateView.getMonth(),disabled=!!(min&&d<min),isToday=val===formatDate(today()),isSelected=!!(selected&&val===formatDate(selected));
      days+='<button type="button" class="moyo-quick-date-picker-day'+(muted?' is-muted':'')+(isToday?' is-today':'')+(isSelected?' is-selected':'')+'" data-date="'+val+'"'+(disabled?' disabled':'')+'>'+d.getDate()+'</button>';
    }
    const todayDisabled=!!(min&&today()<min);
    menu.innerHTML='<div class="moyo-quick-date-picker-head"><div class="moyo-quick-date-picker-title">'+state.dateView.getFullYear()+'\uB144 '+(state.dateView.getMonth()+1)+'\uC6D4</div><div class="moyo-quick-date-picker-nav"><button type="button" data-nav="-1"><span>\u2039</span></button><button type="button" data-nav="1"><span>\u203A</span></button></div></div><div class="moyo-quick-date-picker-weekdays">'+WEEKDAYS.map(x=>'<span>'+x+'</span>').join('')+'</div><div class="moyo-quick-date-picker-days">'+days+'</div><div class="moyo-quick-date-picker-foot"><button type="button" class="moyo-quick-date-picker-today" data-action="today"'+(todayDisabled?' disabled':'')+'>\uC624\uB298</button></div>';
  }
  function ensureTimeMenu(){
    if(state.timeMenu&&state.timeMenu.isConnected)return state.timeMenu;
    state.timeMenu=makePortal('moyo-quick-time-picker-menu');
    state.timeMenu.addEventListener('click',function(e){
      e.preventDefault();e.stopPropagation();
      const b=e.target.closest('button');if(!b)return;
      if(state.kind==='schedule-time'&&!state.target)return;
      const action=b.dataset.action||'';
      if(action==='now'){
        const n=roundUpToFive(new Date());
        state.timeState={meridiem:n.getHours()>=12?'PM':'AM',hour12:n.getHours()%12||12,minute:n.getMinutes()};
      }
      if(b.dataset.meridiem)state.timeState.meridiem=b.dataset.meridiem;
      if(b.dataset.hour)state.timeState.hour12=Number(b.dataset.hour);
      if(b.dataset.minute)state.timeState.minute=Number(b.dataset.minute);
      applyCurrentTime();
      if(action==='now'||b.dataset.minute){closePickers();return}
      renderTimeMenu();
    });
    return state.timeMenu;
  }
  function currentTimeValue(){
    if(state.kind==='deadline-time'){
      const v=getDeadlineParts();return pad(Number(v.hour||18))+':'+pad(Number(v.minute||0));
    }
    return String(state.target?.dataset.value||'09:00');
  }
  function applyCurrentTime(){
    const h=(state.timeState.hour12%12)+(state.timeState.meridiem==='PM'?12:0);
    const value=pad(h)+':'+pad(state.timeState.minute);
    if(state.kind==='deadline-time'){
      ensureSelectOptions();
      const hour=document.getElementById('pollEndHourInput'),minute=document.getElementById('pollEndMinuteInput');
      if(hour)hour.value=pad(h);
      if(minute)minute.value=pad(state.timeState.minute);
      emitDeadlineChange(minute||hour);
    }else if(state.kind==='schedule-time'){
      setScheduleTime(state.target,value);
    }
  }
  function renderTimeMenu(){
    const menu=ensureTimeMenu();
    const hours=Array.from({length:12},(_,i)=>i+1).map(h=>'<button type="button" data-hour="'+h+'" class="'+(state.timeState.hour12===h?'is-selected':'')+'">'+pad(h)+'</button>').join('');
    const mins=MINUTES.map(m=>'<button type="button" data-minute="'+m+'" class="'+(state.timeState.minute===m?'is-selected':'')+'">'+pad(m)+'</button>').join('');
    menu.innerHTML='<div class="moyo-quick-time-picker-head"><div class="moyo-quick-time-picker-title">\uC2DC\uAC04 \uC120\uD0DD</div><button type="button" class="moyo-quick-time-picker-now" data-action="now">\uD604\uC7AC \uC2DC\uAC04</button></div><div class="moyo-quick-time-picker-ampm"><button type="button" data-meridiem="AM" class="'+(state.timeState.meridiem==='AM'?'is-selected':'')+'">\uC624\uC804</button><button type="button" data-meridiem="PM" class="'+(state.timeState.meridiem==='PM'?'is-selected':'')+'">\uC624\uD6C4</button></div><div class="moyo-quick-time-picker-section"><div class="moyo-quick-time-picker-label">\uC2DC</div><div class="moyo-quick-time-picker-grid">'+hours+'</div></div><div class="moyo-quick-time-picker-section"><div class="moyo-quick-time-picker-label">\uBD84 \u00B7 5\uBD84 \uB2E8\uC704</div><div class="moyo-quick-time-picker-grid">'+mins+'</div></div>';
  }
  function position(menu,anchor,w,h){
    if(!menu||!anchor)return;
    const r=anchor.getBoundingClientRect();
    const width=menu.offsetWidth||w,height=menu.offsetHeight||h;
    const maxLeft=Math.max(10,window.innerWidth-width-10);
    let left=Math.min(Math.max(10,r.left),maxLeft),top=r.bottom+5;
    if(top+height>window.innerHeight-10)top=Math.max(10,r.top-height-5);
    menu.style.left=left+'px';menu.style.top=top+'px';
  }
  function closePickers(){
    if(state.dateMenu)state.dateMenu.hidden=true;
    if(state.timeMenu)state.timeMenu.hidden=true;
    state.target=null;state.kind=null;
  }
  function openDate(kind,input,anchor){
    closePickers();
    state.kind=kind;state.target=input||null;
    const current=kind==='deadline-date'?parseDate(document.getElementById('pollEndDateInput')?.value||''):parseDate(input?.dataset.value||'');
    const base=current||minDateForCurrentKind()||today();
    state.dateView=new Date(base.getFullYear(),base.getMonth(),1);
    renderDateMenu();
    const menu=ensureDateMenu();menu.hidden=false;position(menu,anchor||input,248,288);
  }
  function openTime(kind,input,anchor){
    closePickers();
    state.kind=kind;state.target=input||null;
    const raw=currentTimeValue(),m=/^(\d{2}):(\d{2})$/.exec(raw),h=m?Number(m[1]):9,min=m?Number(m[2]):0;
    state.timeState={meridiem:h>=12?'PM':'AM',hour12:h%12||12,minute:MINUTES.includes(min)?min:Math.floor(min/5)*5};
    renderTimeMenu();
    const menu=ensureTimeMenu();menu.hidden=false;position(menu,anchor||input,268,276);
  }

  // ===== common poll form: option editor state + UI =====
  window.globalOptionType=window.globalOptionType||'TEXT';
  let returnFocus=null;
  const escapeFormHtml=value=>String(value==null?'':value).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));

const SCHEDULE_OPTION_PREFIX='@MOYO_SCHEDULE@|';

function parseScheduleOptionText(value){
    const text=String(value||'');
    if(!text.startsWith(SCHEDULE_OPTION_PREFIX))return null;
    const parts=text.substring(SCHEDULE_OPTION_PREFIX.length).split('|');
    if(parts.length<3)return null;
    return {date:parts[0]||'',startTime:parts[1]||'',endTime:parts[2]||''};
}
function serializeScheduleOption(date,startTime,endTime){
    return SCHEDULE_OPTION_PREFIX+date+'|'+startTime+'|'+endTime;
}
function formatScheduleDateLabel(value){
    return window.MoyoPollFormPicker?window.MoyoPollFormPicker.formatDateLabel(value):String(value||'');
}
function formatScheduleOptionLabel(value,index){
    const schedule=parseScheduleOptionText(value);
    if(!schedule)return String(value||('\uD6C4\uBCF4 '+(index+1)));
    return formatScheduleDateLabel(schedule.date)+' \u00B7 '+schedule.startTime+' ~ '+schedule.endTime;
}
function markScheduleRowEdited(input){
    const row=input&&input.closest?input.closest('.poll-option-edit-row.schedule-mode'):null;
    if(row)row.dataset.scheduleUserEdited='true';
}
function setScheduleDateValue(input,value,markEdited){
    if(!input)return;
    if(markEdited!==false)markScheduleRowEdited(input);
    if(window.MoyoPollFormPicker)window.MoyoPollFormPicker.setScheduleDate(input,value,{emit:markEdited!==false});
    else{input.dataset.value=value||'';input.value=value||'';}
    validateScheduleRow(input.closest('.poll-option-edit-row'));
}
function setScheduleTimeValue(input,value,markEdited){
    if(!input)return;
    if(markEdited!==false)markScheduleRowEdited(input);
    if(window.MoyoPollFormPicker)window.MoyoPollFormPicker.setScheduleTime(input,value,{emit:markEdited!==false});
    else{input.dataset.value=value||'';input.value=value||'';}
    validateScheduleRow(input.closest('.poll-option-edit-row'));
}
function pollDeadlineDateTime(){
    if(window.MoyoPollFormPicker)return window.MoyoPollFormPicker.getDeadlineDateTime();
    const date=document.getElementById('pollEndDateInput')?.value||'',hour=document.getElementById('pollEndHourInput')?.value||'',minute=document.getElementById('pollEndMinuteInput')?.value||'';
    if(!date||hour===''||minute==='')return null;
    const dt=new Date(date+'T'+hour+':'+minute+':00');
    return Number.isNaN(dt.getTime())?null:dt;
}
function scheduleStartDateTime(row){
    if(!row)return null;
    const date=row.querySelector('.poll-schedule-date')?.dataset.value||'';
    const time=row.querySelector('.poll-schedule-start')?.dataset.value||'';
    if(!date||!time)return null;
    const dt=new Date(date+'T'+time+':00');
    return Number.isNaN(dt.getTime())?null:dt;
}
function scheduleDefaultWindow(){
    const deadline=pollDeadlineDateTime();
    const base=deadline?new Date(deadline):new Date();
    if(!deadline){base.setDate(base.getDate()+1);base.setHours(18,0,0,0);}

    let start=new Date(base.getTime()+60*60*1000);
    start.setSeconds(0,0);
    const rem=start.getMinutes()%5;
    if(rem)start.setMinutes(start.getMinutes()+(5-rem));

    // common poll form option UI
    let end=new Date(start.getTime()+60*60*1000);
    if(end.getDate()!==start.getDate()||end.getMonth()!==start.getMonth()||end.getFullYear()!==start.getFullYear()){
        start=new Date(start);
        start.setDate(start.getDate()+1);
        start.setHours(9,0,0,0);
        end=new Date(start.getTime()+60*60*1000);
    }

    return {
        date:formatDate(start),
        startTime:String(start.getHours()).padStart(2,'0')+':'+String(start.getMinutes()).padStart(2,'0'),
        endTime:String(end.getHours()).padStart(2,'0')+':'+String(end.getMinutes()).padStart(2,'0')
    };
}
function applyScheduleDefaultWindow(row){
    if(!row)return;
    const values=scheduleDefaultWindow();
    row.dataset.scheduleUserEdited='false';
    setScheduleDateValue(row.querySelector('.poll-schedule-date'),values.date,false);
    setScheduleTimeValue(row.querySelector('.poll-schedule-start'),values.startTime,false);
    setScheduleTimeValue(row.querySelector('.poll-schedule-end'),values.endTime,false);
    row.dataset.scheduleUserEdited='false';
}
function refreshUntouchedScheduleDefaults(){
    document.querySelectorAll('#pollOptionInputs .poll-option-edit-row.schedule-mode').forEach(function(row){
        if(row.dataset.scheduleUserEdited!=='true')applyScheduleDefaultWindow(row);
    });
}
function handlePollDeadlineChange(){
    refreshUntouchedScheduleDefaults();
    validateAllScheduleRows();
}
function validateScheduleRow(row){
    if(!row||!row.classList.contains('schedule-mode'))return true;
    const start=row.querySelector('.poll-schedule-start')?.dataset.value||'';
    const end=row.querySelector('.poll-schedule-end')?.dataset.value||'';
    const error=row.querySelector('.poll-schedule-error');
    let message='';
    if(start&&end&&start>=end){
        message='\uC885\uB8CC \uC2DC\uAC04\uC740 \uC2DC\uC791 \uC2DC\uAC04\uBCF4\uB2E4 \uB2A6\uC5B4\uC57C \uD569\uB2C8\uB2E4.';
    }else{
        const deadline=pollDeadlineDateTime();
        const scheduleStart=scheduleStartDateTime(row);
        if(deadline&&scheduleStart&&scheduleStart<=deadline){
            message='\uD6C4\uBCF4 \uC77C\uC815\uC740 \uD22C\uD45C \uB9C8\uAC10 \uC774\uD6C4\uB85C \uC124\uC815\uD574\uC8FC\uC138\uC694.';
        }
    }
    row.classList.toggle('has-schedule-error',!!message);
    if(error)error.textContent=message;
    return !message;
}
function validateAllScheduleRows(){
    let valid=true;
    document.querySelectorAll('#pollOptionInputs .poll-option-edit-row.schedule-mode').forEach(function(row){
        if(!validateScheduleRow(row))valid=false;
    });
    return valid;
}
// common poll form option UI

function addPollOptionRow(initialData){
    const list=document.getElementById('pollOptionInputs');
    const row=document.createElement('div');
    const text=initialData?(initialData.text||initialData.TEXT||''):'';
    const imagePath=initialData?(initialData.imagePath||initialData.IMAGE_PATH||''):'';
    const storedType=initialData
        ? String(initialData.optionType||initialData.OPTION_TYPE||'').toUpperCase()
        : '';

    // common poll form option UI
    if(initialData && ['SCHEDULE','IMAGE','AUDIO','VIDEO'].includes(storedType)){ window.globalOptionType=storedType; } else if(initialData && imagePath){ window.globalOptionType='IMAGE'; }

    row.className='poll-option-edit-row '+window.globalOptionType.toLowerCase()+'-mode';
    row.dataset.optionId=initialData?(initialData.optionId||initialData.OPTION_ID||''):'';
    row.dataset.existingImagePath=imagePath||'';
    row.innerHTML=
        '<span class="option-number"></span>'+
        '<div class="poll-option-edit-main">'+
            '<input class="poll-input poll-option-text-input" placeholder="\uC120\uD0DD\uC9C0 \uB0B4\uC6A9" value="'+escapeFormHtml(window.globalOptionType==='TEXT'?text:'')+'">'+
            '<div class="poll-option-schedule-block"><div class="poll-schedule-grid">'+
              '<div class="poll-schedule-field poll-schedule-date-field"><input type="text" class="poll-input poll-schedule-date" readonly placeholder="\uB0A0\uC9DC \uC120\uD0DD" tabindex="0" aria-label="\uC77C\uC815 \uB0A0\uC9DC"><button type="button" class="poll-schedule-trigger" aria-label="\uB0A0\uC9DC \uC120\uD0DD"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M8 3.8v3.4M16 3.8v3.4M4 9.2h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button></div>'+
              '<div class="poll-schedule-field"><input type="text" class="poll-input poll-schedule-start" readonly placeholder="\uC2DC\uC791 \uC2DC\uAC04" tabindex="0" aria-label="\uC2DC\uC791 \uC2DC\uAC04"><button type="button" class="poll-schedule-trigger" aria-label="\uC2DC\uC791 \uC2DC\uAC04 \uC120\uD0DD"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.8v4.6l3 1.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button></div>'+
              '<span class="poll-schedule-sep">~</span>'+
              '<div class="poll-schedule-field"><input type="text" class="poll-input poll-schedule-end" readonly placeholder="\uC885\uB8CC \uC2DC\uAC04" tabindex="0" aria-label="\uC885\uB8CC \uC2DC\uAC04"><button type="button" class="poll-schedule-trigger" aria-label="\uC885\uB8CC \uC2DC\uAC04 \uC120\uD0DD"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.8v4.6l3 1.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button></div>'+
            '</div><div class="poll-schedule-error" role="status" aria-live="polite"></div></div>'+
            '<div class="poll-option-image-block'+(window.globalOptionType==='IMAGE'&&imagePath?' has-image':'')+'">'+
                '<label class="poll-file-label">'+
                    '<div class="poll-upload-tile-content">'+
                        '<span class="poll-upload-plus">\uFF0B</span>'+ 
                        '<strong>\uC774\uBBF8\uC9C0 \uC120\uD0DD</strong>'+ 
                        '<span class="poll-upload-help">\uD074\uB9AD\uD558\uAC70\uB098 \uC774\uBBF8\uC9C0\uB97C<br>\uB4DC\uB798\uADF8\uD558\uC138\uC694</span>'+ 
                    '</div>'+ 
                    '<input type="file" class="poll-option-image-input" accept="image/*" multiple onchange="handlePollOptionImageChange(this)">'+
                '</label>'+
                '<div class="poll-option-image-frame'+(window.globalOptionType==='IMAGE'&&imagePath?' visible':'')+'">'+
                    '<img class="poll-image-preview" '+(window.globalOptionType==='IMAGE'&&imagePath?'src="'+escapeFormHtml(imagePath)+'"':'')+' alt="\uBBF8\uB9AC\uBCF4\uAE30">'+
                    '<button type="button" class="poll-option-image-remove" onclick="removePollOptionImage(this)" aria-label="\uC774\uBBF8\uC9C0 \uC81C\uAC70">\u00D7</button>'+
                '</div>'+
                '<span class="poll-image-name">\uC774\uBBF8\uC9C0 \uC5C6\uC74C</span>'+
            '</div>'+
            '<div class="poll-option-audio-block">'+
              '<label class="poll-media-upload"><span class="poll-audio-upload-text">\uFF0B \uC74C\uC545 \uD30C\uC77C \uC120\uD0DD</span><span class="poll-audio-upload-help">\uD074\uB9AD\uD558\uAC70\uB098 \uD30C\uC77C\uC744 \uB4DC\uB798\uADF8\uD558\uC138\uC694</span><input type="file" class="poll-option-audio-input" accept="audio/*" multiple onchange="handlePollOptionAudioChange(this)"></label>'+
              '<input class="poll-input poll-media-title" placeholder="\uC74C\uC545 \uC81C\uBAA9" value="">'+
              '<audio class="poll-audio-preview" controls preload="metadata"></audio>'+
            '</div>'+
            '<div class="poll-option-video-block">'+
              '<input class="poll-input poll-video-url" placeholder="YouTube, Vimeo \uB610\uB294 \uC9C1\uC811 \uC7AC\uC0DD \uAC00\uB2A5\uD55C \uC601\uC0C1 URL" value="">'+
            '</div>'+
        '</div>';

    list.appendChild(row);
    if(window.globalOptionType==='SCHEDULE'){
        const schedule=parseScheduleOptionText(text);
        if(schedule){
            row.dataset.scheduleUserEdited='true';
            setScheduleDateValue(row.querySelector('.poll-schedule-date'),schedule.date,false);
            setScheduleTimeValue(row.querySelector('.poll-schedule-start'),schedule.startTime,false);
            setScheduleTimeValue(row.querySelector('.poll-schedule-end'),schedule.endTime,false);
            row.dataset.scheduleUserEdited='true';
        }else{
            applyScheduleDefaultWindow(row);
        }
    }
    if(window.globalOptionType==='AUDIO' && initialData){
        const title=row.querySelector('.poll-option-audio-block .poll-media-title'); if(title)title.value=text||'';
        const audio=row.querySelector('.poll-audio-preview'); if(audio&&imagePath){audio.src=imagePath;audio.style.display='block';}
        const uploadText=row.querySelector('.poll-audio-upload-text'); if(uploadText&&text)uploadText.textContent=text;
        const audioBlock=row.querySelector('.poll-option-audio-block'); if(audioBlock)audioBlock.classList.toggle('has-audio',!!imagePath);
    }
    if(window.globalOptionType==='VIDEO' && initialData){
        const url=row.querySelector('.poll-video-url'); if(url)url.value=imagePath||'';
    }
    initializeOptionRowDrop(row);
    initializeAudioOptionRowDrop(row);
    updateOptionRows();
}

function updateImageEditorLayout(){
    const isImage=window.globalOptionType==='IMAGE';
    const isSchedule=window.globalOptionType==='SCHEDULE';
    const list=document.getElementById('pollOptionInputs');
    const dialog=document.querySelector('#pollFormModal .poll-modal-dialog');
    if(list){
        list.classList.toggle('image-edit-grid',isImage);
        list.classList.toggle('schedule-edit-list',isSchedule);
        if(!isSchedule)list.classList.remove('has-scroll');
    }
    if(dialog){
        dialog.classList.toggle('image-edit-mode',isImage);
        dialog.classList.toggle('text-edit-mode',!isImage);
    }
}

function applyGlobalOptionType(type,clearIncompatibleInputs){
    window.globalOptionType=['SCHEDULE','IMAGE','AUDIO','VIDEO'].includes(type)?type:'TEXT';
    updateImageEditorLayout();

    const input=document.querySelector('input[name="pollGlobalOptionType"][value="'+window.globalOptionType+'"]');
    if(input)input.checked=true;

    document.querySelectorAll('.poll-option-edit-row').forEach(function(row){
        row.classList.remove('text-mode','schedule-mode','image-mode','audio-mode','video-mode');
        row.classList.add(window.globalOptionType.toLowerCase()+'-mode');
        if(window.globalOptionType==='SCHEDULE'){
            const dateInput=row.querySelector('.poll-schedule-date');
            const startInput=row.querySelector('.poll-schedule-start');
            const endInput=row.querySelector('.poll-schedule-end');
            if(!dateInput?.dataset.value||!startInput?.dataset.value||!endInput?.dataset.value)applyScheduleDefaultWindow(row);
        }

        if(!clearIncompatibleInputs)return;
        if(window.globalOptionType==='TEXT'){
            const fileInput=row.querySelector('.poll-option-image-input');
            if(fileInput)fileInput.value='';
            row.dataset.existingImagePath='';
            removePollOptionImageFromRow(row);
        }else{
            const textInput=row.querySelector('.poll-option-text-input');
            if(textInput)textInput.value='';
        }
    });
}

function switchGlobalPollOptionType(type){
    applyGlobalOptionType(type,true);
}

function setGlobalOptionType(type){
    applyGlobalOptionType(type,false);
}

function removeLastPollOptionRow(){
    const rows=document.querySelectorAll('.poll-option-edit-row');
    if(rows.length<=2){alert('\uC120\uD0DD\uC9C0\uB294 \uCD5C\uC18C 2\uAC1C\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.');return;}
    rows[rows.length-1].remove();
    updateOptionRows();
}

function updateOptionRows(){
    const rows=Array.from(document.querySelectorAll('.poll-option-edit-row'));
    rows.forEach(function(row,index){
        row.querySelector('.option-number').innerText=index+1;
        if(window.globalOptionType==='SCHEDULE')validateScheduleRow(row);
    });
    const list=document.getElementById('pollOptionInputs');
    if(list&&window.globalOptionType==='SCHEDULE')list.classList.toggle('has-scroll',rows.length>2);
    const minus=document.querySelector('.poll-remove-last');
    if(minus)minus.disabled=rows.length<=2;
}




function initializeOptionRowDrop(row){
    const block=row.querySelector('.poll-option-image-block');
    if(!block)return;

    ['dragenter','dragover'].forEach(function(name){
        block.addEventListener(name,function(event){
            if(window.globalOptionType!=='IMAGE')return;
            event.preventDefault();
            event.stopPropagation();
            block.classList.add('row-dragover');
        });
    });

    ['dragleave','drop'].forEach(function(name){
        block.addEventListener(name,function(event){
            if(window.globalOptionType!=='IMAGE')return;
            event.preventDefault();
            event.stopPropagation();
            block.classList.remove('row-dragover');
        });
    });

    block.addEventListener('drop',function(event){
        if(window.globalOptionType!=='IMAGE')return;
        const files=Array.from(event.dataTransfer.files||[]).filter(function(item){
            return item.type&&item.type.startsWith('image/');
        });
        if(files.length===0){alert('\uC774\uBBF8\uC9C0 \uD30C\uC77C\uB9CC \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.');return;}
        assignImageFilesFromRow(row,files);
    });
}

function getLastPollOptionRow(){
    const rows=document.querySelectorAll('.poll-option-edit-row');
    return rows.length ? rows[rows.length-1] : null;
}

function isPollOptionRowEmpty(row){
    if(!row)return false;
    const input=row.querySelector('.poll-option-image-input');
    return !(input&&input.files&&input.files[0]) && !(row.dataset.existingImagePath||'');
}

function appendEmptyPollOptionRow(){
    addPollOptionRow();
    return getLastPollOptionRow();
}

function assignImageFilesFromRow(startRow,files){
    const images=files.filter(function(file){return file.type&&file.type.startsWith('image/');});
    if(images.length===0){alert('\uC774\uBBF8\uC9C0 \uD30C\uC77C\uB9CC \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.');return;}

    setGlobalOptionType('IMAGE');
    const allRows=Array.from(document.querySelectorAll('.poll-option-edit-row'));
    const startIndex=Math.max(0,allRows.indexOf(startRow));
    const targets=[];

    // common poll form option UI
    // common poll form option UI
    targets.push(startRow||allRows[0]||appendEmptyPollOptionRow());
    allRows.slice(startIndex+1).forEach(function(row){
        if(isPollOptionRowEmpty(row))targets.push(row);
    });

    while(targets.length<images.length){
        targets.push(appendEmptyPollOptionRow());
    }

    images.forEach(function(file,index){setFileToOptionRow(targets[index],file);});
    updateOptionRows();
}


function setFileToOptionRow(row,file){
    if(!row||!file)return;
    const input=row.querySelector('.poll-option-image-input');
    if(!input)return;

    const transfer=new DataTransfer();
    transfer.items.add(file);
    input.files=transfer.files;
    handlePollOptionImageChange(input);
}

function handlePollOptionImageChange(input){
    const selectedFiles=Array.from(input.files||[]).filter(function(file){
        return file.type&&file.type.startsWith('image/');
    });
    const row=input.closest('.poll-option-edit-row');

    // common poll form option UI
    if(selectedFiles.length>1){
        assignImageFilesFromRow(row,selectedFiles);
        return;
    }

    const file=selectedFiles[0];
    const block=row.querySelector('.poll-option-image-block');
    const frame=row.querySelector('.poll-option-image-frame');
    const preview=row.querySelector('.poll-image-preview');
    const name=row.querySelector('.poll-image-name');

    if(preview.dataset.objectUrl){
        URL.revokeObjectURL(preview.dataset.objectUrl);
        delete preview.dataset.objectUrl;
    }

    if(!file){
        removePollOptionImageFromRow(row);
        return;
    }

    const objectUrl=URL.createObjectURL(file);
    preview.src=objectUrl;
    preview.dataset.objectUrl=objectUrl;
    frame.classList.add('visible');
    block.classList.add('has-image');
    name.innerText=file.name||'\uC774\uBBF8\uC9C0 \uC120\uD0DD\uB428';
    row.dataset.existingImagePath='';
}

function removePollOptionImage(button){
    const row=button.closest('.poll-option-edit-row');
    removePollOptionImageFromRow(row);
}

function removePollOptionImageFromRow(row){
    const block=row.querySelector('.poll-option-image-block');
    const frame=row.querySelector('.poll-option-image-frame');
    const preview=row.querySelector('.poll-image-preview');
    const fileInput=row.querySelector('.poll-option-image-input');
    const name=row.querySelector('.poll-image-name');

    if(preview.dataset.objectUrl){
        URL.revokeObjectURL(preview.dataset.objectUrl);
        delete preview.dataset.objectUrl;
    }

    preview.removeAttribute('src');
    frame.classList.remove('visible');
    block.classList.remove('has-image');
    fileInput.value='';
    name.innerText='\uC774\uBBF8\uC9C0 \uC5C6\uC74C';
    row.dataset.existingImagePath='';
}

function audioTitleFromFileName(name){
    return String(name||'').replace(/\.[^.]+$/,'').trim();
}

function isAudioOptionRowEmpty(row){
    if(!row)return false;
    const input=row.querySelector('.poll-option-audio-input');
    return !(input&&input.files&&input.files[0]) && !(row.dataset.existingImagePath||'');
}

function setAudioFileToOptionRow(row,file){
    if(!row||!file)return;
    const input=row.querySelector('.poll-option-audio-input');
    if(!input)return;
    const transfer=new DataTransfer();
    transfer.items.add(file);
    input.files=transfer.files;
    previewSinglePollAudio(input,file);
}

function previewSinglePollAudio(input,file){
    const block=input.closest('.poll-option-audio-block');
    const audio=block.querySelector('.poll-audio-preview');
    const title=block.querySelector('.poll-media-title');
    if(audio.dataset.objectUrl){URL.revokeObjectURL(audio.dataset.objectUrl);delete audio.dataset.objectUrl;}
    if(!file){audio.removeAttribute('src');audio.style.display='none';return;}
    const objectUrl=URL.createObjectURL(file);
    audio.src=objectUrl;
    audio.dataset.objectUrl=objectUrl;
    audio.style.display='block';
    if(title) title.value=audioTitleFromFileName(file.name);
    const uploadText=block.querySelector('.poll-audio-upload-text');
    if(uploadText) uploadText.textContent=file.name;
    block.classList.add('has-audio');
}

function assignAudioFilesFromRow(startRow,files){
    const audios=files.filter(function(file){return file.type&&file.type.startsWith('audio/');});
    if(audios.length===0){alert('\uC74C\uC545 \uD30C\uC77C\uB9CC \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.');return;}
    setGlobalOptionType('AUDIO');
    const allRows=Array.from(document.querySelectorAll('.poll-option-edit-row'));
    const startIndex=Math.max(0,allRows.indexOf(startRow));
    const targets=[];
    targets.push(startRow||allRows[0]||appendEmptyPollOptionRow());
    allRows.slice(startIndex+1).forEach(function(row){if(isAudioOptionRowEmpty(row))targets.push(row);});
    while(targets.length<audios.length)targets.push(appendEmptyPollOptionRow());
    audios.forEach(function(file,index){setAudioFileToOptionRow(targets[index],file);});
    updateOptionRows();
}

function handlePollOptionAudioChange(input){
    const files=Array.from(input.files||[]).filter(function(file){return file.type&&file.type.startsWith('audio/');});
    const row=input.closest('.poll-option-edit-row');
    if(files.length>1){assignAudioFilesFromRow(row,files);return;}
    previewSinglePollAudio(input,files[0]);
}

function initializeAudioOptionRowDrop(row){
    const block=row.querySelector('.poll-option-audio-block');
    if(!block)return;
    ['dragenter','dragover'].forEach(function(name){
        block.addEventListener(name,function(event){
            if(window.globalOptionType!=='AUDIO')return;
            event.preventDefault();event.stopPropagation();block.classList.add('audio-dragover');
        });
    });
    ['dragleave','drop'].forEach(function(name){
        block.addEventListener(name,function(event){
            if(window.globalOptionType!=='AUDIO')return;
            event.preventDefault();event.stopPropagation();block.classList.remove('audio-dragover');
        });
    });
    block.addEventListener('drop',function(event){
        if(window.globalOptionType!=='AUDIO')return;
        const files=Array.from(event.dataTransfer.files||[]).filter(function(file){return file.type&&file.type.startsWith('audio/');});
        if(files.length===0){alert('\uC74C\uC545 \uD30C\uC77C\uB9CC \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.');return;}
        assignAudioFilesFromRow(row,files);
    });
}


  function resetForm(){
    const title=document.getElementById('pollFormTitle');
    const submit=document.getElementById('pollSubmitButton');
    const question=document.getElementById('pollQuestionInput');
    const show=document.getElementById('pollShowResultsInput');
    const list=document.getElementById('pollOptionInputs');
    if(title)title.textContent='\uD22C\uD45C \uB9CC\uB4E4\uAE30';
    if(submit)submit.textContent='\uD22C\uD45C \uC0DD\uC131';
    if(question)question.value='';
    if(show)show.checked=false;
    if(list)list.innerHTML='';
    setGlobalOptionType('TEXT');
    addPollOptionRow();
    addPollOptionRow();
    initializeDeadline(true);
    closePickers();
  }

  function openForm(){
    const root=modal();if(!root)return;
    initializeFormOnce();
    returnFocus=document.activeElement instanceof HTMLElement?document.activeElement:null;
    root.inert=false;
    root.classList.add('open');
    root.setAttribute('aria-hidden','false');
    document.body.classList.add('poll-modal-open');
    updateImageEditorLayout();
    syncDeadlineDisplay();
    window.setTimeout(function(){
      const first=root.querySelector('#pollQuestionInput, button, input, select');
      if(first instanceof HTMLElement)first.focus();
    },0);
  }

  function closeForm(){
    const root=modal();if(!root)return;
    const focusTarget=returnFocus;returnFocus=null;
    const focused=document.activeElement;
    if(focused instanceof HTMLElement&&root.contains(focused))focused.blur();
    closePickers();
    root.classList.remove('open');
    root.inert=true;
    root.setAttribute('aria-hidden','true');
    document.body.classList.remove('poll-modal-open');
    window.setTimeout(function(){
      if(focusTarget instanceof HTMLElement&&document.contains(focusTarget)&&typeof focusTarget.focus==='function')focusTarget.focus();
    },0);
  }

  function initializeFormOnce(){
    const list=document.getElementById('pollOptionInputs');
    if(list&&!list.children.length){
      addPollOptionRow();
      addPollOptionRow();
    }
  }

  function bind(){
    if(state.bound)return;state.bound=true;
    const root=modal();if(!root)return;
    initializeDeadline(false);
    initializeFormOnce();
    root.addEventListener('click',function(e){
      const scheduleField=e.target.closest('.poll-schedule-field');
      if(scheduleField&&root.contains(scheduleField)){
        const input=scheduleField.querySelector('.poll-schedule-date,.poll-schedule-start,.poll-schedule-end');
        if(input){
          e.preventDefault();e.stopPropagation();
          if(input.classList.contains('poll-schedule-date'))openDate('schedule-date',input,input);
          else openTime('schedule-time',input,input);
          return;
        }
      }
      const dateControl=e.target.closest('.poll-date-control');
      if(dateControl&&root.contains(dateControl)){e.preventDefault();e.stopPropagation();openDate('deadline-date',null,dateControl);return}
      const timeControl=e.target.closest('.poll-time-control');
      if(timeControl&&root.contains(timeControl)){e.preventDefault();e.stopPropagation();openTime('deadline-time',null,timeControl);return}
    });
    root.addEventListener('keydown',function(e){
      if(e.key!=='Enter'&&e.key!==' ')return;
      if(e.target.matches('.poll-schedule-date,.poll-schedule-start,.poll-schedule-end')){
        e.preventDefault();e.stopPropagation();
        if(e.target.classList.contains('poll-schedule-date'))openDate('schedule-date',e.target,e.target);else openTime('schedule-time',e.target,e.target);
      }else if(e.target.id==='pollEndDateDisplay'){
        e.preventDefault();openDate('deadline-date',null,e.target.closest('.poll-date-control')||e.target);
      }else if(e.target.id==='pollEndTimeDisplay'){
        e.preventDefault();openTime('deadline-time',null,e.target.closest('.poll-time-control')||e.target);
      }
    });
    ['pollEndDateInput','pollEndHourInput','pollEndMinuteInput'].forEach(id=>{
      const el=document.getElementById(id);if(el)el.addEventListener('change',function(){syncDeadlineDisplay();handlePollDeadlineChange();});
    });
    root.addEventListener('moyo:poll-schedule-change',function(e){
      const input=e.target;
      if(!input||!input.matches||!input.matches('.poll-schedule-date,.poll-schedule-start,.poll-schedule-end'))return;
      markScheduleRowEdited(input);
      validateScheduleRow(input.closest('.poll-option-edit-row'));
    });
    document.addEventListener('click',function(e){
      if(!e.target.closest('.poll-picker-portal')&&!e.target.closest('#pollFormModal .poll-date-control')&&!e.target.closest('#pollFormModal .poll-time-control')&&!e.target.closest('#pollFormModal .poll-schedule-field'))closePickers();
    });
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&((state.dateMenu&&!state.dateMenu.hidden)||(state.timeMenu&&!state.timeMenu.hidden))){e.preventDefault();e.stopPropagation();closePickers()}},true);
    document.addEventListener('keydown',function(e){
      if(e.key!=='Escape')return;
      const pickerOpen=(state.dateMenu&&!state.dateMenu.hidden)||(state.timeMenu&&!state.timeMenu.hidden);
      if(pickerOpen)return;
      const root=modal();if(root&&root.classList.contains('open'))closeForm();
    });
    window.addEventListener('resize',closePickers);
    document.addEventListener('scroll',function(){
      if((state.dateMenu&&!state.dateMenu.hidden)||(state.timeMenu&&!state.timeMenu.hidden))closePickers();
    },true);
    if(window.MutationObserver)new MutationObserver(function(){
      if(root.getAttribute('aria-hidden')==='false'&&root.classList.contains('open'))requestAnimationFrame(syncDeadlineDisplay);else closePickers();
    }).observe(root,{attributes:true,attributeFilter:['aria-hidden','class']});
  }


  // ===== standalone create support for workspace/project main widgets =====
  let standaloneCreateConfig=null;

  function configureStandaloneCreate(config){
    config=config||{};
    standaloneCreateConfig={
      scope:String(config.scope||'WORKSPACE').toUpperCase()==='PROJECT'?'PROJECT':'WORKSPACE',
      wsId:String(config.wsId||''),
      projId:String(config.projId||''),
      contextPath:String(config.contextPath||'').replace(/\/$/,''),
      onCreated:typeof config.onCreated==='function'?config.onCreated:null
    };
  }

  function apiPath(path){
    const base=standaloneCreateConfig&&standaloneCreateConfig.contextPath?standaloneCreateConfig.contextPath:'';
    return base+path;
  }

  async function uploadStandaloneImage(file){
    const fd=new FormData();fd.append('image',file);
    const res=await fetch(apiPath('/api/polls/option-image'),{method:'POST',body:fd});
    const data=await res.json().catch(function(){return null;});
    if(!res.ok||!data||data.success===false)throw new Error(data&&data.message?data.message:'image upload failed');
    return data.imagePath;
  }

  async function uploadStandaloneAudio(file){
    const fd=new FormData();fd.append('media',file);
    const res=await fetch(apiPath('/api/polls/option-media'),{method:'POST',body:fd});
    const data=await res.json().catch(function(){return null;});
    if(!res.ok||!data||data.success===false)throw new Error(data&&data.message?data.message:'audio upload failed');
    return data.mediaPath;
  }

  async function submitStandaloneCreate(){
    const cfg=standaloneCreateConfig;
    if(!cfg){
      console.error('[MOYO] poll create context is not configured.');
      return;
    }
    const question=(document.getElementById('pollQuestionInput')?.value||'').trim();
    const deadline=getDeadlineDateTime();
    if(!question){alert('\uC9C8\uBB38\uC744 \uC785\uB825\uD574\uC8FC\uC138\uC694.');return;}
    if(!deadline){alert('\uD22C\uD45C \uB9C8\uAC10 \uB0A0\uC9DC\uC640 \uC2DC\uAC04\uC744 \uD655\uC778\uD574\uC8FC\uC138\uC694.');return;}
    if(deadline.getTime()<=Date.now()){alert('\uD22C\uD45C \uB9C8\uAC10\uC740 \uD604\uC7AC \uC2DC\uAC04 \uC774\uD6C4\uB85C \uC124\uC815\uD574\uC8FC\uC138\uC694.');return;}
    if(!validateAllScheduleRows()){alert('\uC77C\uC815 \uC120\uD0DD\uC9C0\uC758 \uB0A0\uC9DC\uC640 \uC2DC\uAC04\uC744 \uD655\uC778\uD574\uC8FC\uC138\uC694.');return;}

    const type=window.globalOptionType||'TEXT';
    const rows=Array.from(document.querySelectorAll('#pollOptionInputs .poll-option-edit-row'));
    const options=[];
    try{
      for(const row of rows){
        if(type==='SCHEDULE'){
          const date=row.querySelector('.poll-schedule-date')?.dataset.value||'';
          const startTime=row.querySelector('.poll-schedule-start')?.dataset.value||'';
          const endTime=row.querySelector('.poll-schedule-end')?.dataset.value||'';
          if(!date&&!startTime&&!endTime)continue;
          if(!date||!startTime||!endTime){alert('\uC77C\uC815 \uC120\uD0DD\uC9C0\uC758 \uB0A0\uC9DC\uC640 \uC2DC\uAC04\uC744 \uBAA8\uB450 \uC120\uD0DD\uD574\uC8FC\uC138\uC694.');return;}
          if(!validateScheduleRow(row)){alert(row.querySelector('.poll-schedule-error')?.textContent||'\uC77C\uC815 \uC120\uD0DD\uC9C0\uB97C \uD655\uC778\uD574\uC8FC\uC138\uC694.');return;}
          options.push({optionType:'SCHEDULE',scheduleDate:date,startTime:startTime,endTime:endTime,text:serializeScheduleOption(date,startTime,endTime),imagePath:null});
        }else if(type==='IMAGE'){
          const input=row.querySelector('.poll-option-image-input');
          const file=input&&input.files?input.files[0]:null;
          let imagePath=row.dataset.existingImagePath||'';
          if(file)imagePath=await uploadStandaloneImage(file);
          if(!imagePath)continue;
          options.push({optionType:'IMAGE',text:file&&file.name?file.name:'\uC774\uBBF8\uC9C0 \uC120\uD0DD\uC9C0',imagePath:imagePath});
        }else if(type==='AUDIO'){
          const input=row.querySelector('.poll-option-audio-input');
          const file=input&&input.files?input.files[0]:null;
          let mediaPath=row.dataset.existingImagePath||'';
          if(file)mediaPath=await uploadStandaloneAudio(file);
          if(!mediaPath)continue;
          const title=(row.querySelector('.poll-option-audio-block .poll-media-title')?.value||'').trim()||(file?audioTitleFromFileName(file.name):'\uC74C\uC545 \uC120\uD0DD\uC9C0');
          options.push({optionType:'AUDIO',text:title,imagePath:mediaPath});
        }else if(type==='VIDEO'){
          const url=(row.querySelector('.poll-video-url')?.value||'').trim();
          if(!url)continue;
          options.push({optionType:'VIDEO',text:'\uC601\uC0C1 '+(options.length+1),imagePath:url});
        }else{
          const text=(row.querySelector('.poll-option-text-input')?.value||'').trim();
          if(!text)continue;
          options.push({optionType:'TEXT',text:text,imagePath:null});
        }
      }

      if(options.length<2){alert('\uC120\uD0DD\uC9C0\uB294 2\uAC1C \uC774\uC0C1 \uC785\uB825\uD574\uC8FC\uC138\uC694.');return;}

      const endDate=document.getElementById('pollEndDateInput')?.value||'';
      const endHour=document.getElementById('pollEndHourInput')?.value||'';
      const endMinute=document.getElementById('pollEndMinuteInput')?.value||'';
      const body={
        scope:cfg.scope,
        wsId:cfg.wsId,
        question:question,
        endDt:endDate+' '+endHour+':'+endMinute,
        showResultsYn:document.getElementById('pollShowResultsInput')?.checked?'Y':'N',
        options:options
      };
      if(cfg.scope==='PROJECT')body.projId=cfg.projId;

      const submit=document.getElementById('pollSubmitButton');
      if(submit)submit.disabled=true;
      const res=await fetch(apiPath('/api/polls/create'),{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify(body)
      });
      const raw=await res.text();
      let data=null;try{data=raw?JSON.parse(raw):null;}catch(ignore){}
      if(!res.ok||!data||data.success===false)throw new Error(data&&data.message?data.message:'poll create failed');

      const callback=cfg.onCreated;
      resetForm();
      closeForm();
      standaloneCreateConfig=null;
      if(callback)callback(data.pollId||null,data);
      document.dispatchEvent(new CustomEvent('moyo:poll-created',{detail:{pollId:data.pollId||null,scope:cfg.scope,wsId:cfg.wsId,projId:cfg.projId}}));
    }catch(err){
      console.error(err);
      alert('\uD22C\uD45C \uC0DD\uC131 \uC911 \uC624\uB958\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4.');
    }finally{
      const submit=document.getElementById('pollSubmitButton');
      if(submit)submit.disabled=false;
    }
  }

  window.MoyoPollFormPicker={
    init:initializeDeadline,
    sync:syncDeadlineDisplay,
    close:closePickers,
    getDeadlineDateTime:getDeadlineDateTime,
    isDeadlineInPast:isDeadlineInPast,
    formatDate:formatDate,
    formatDateLabel:formatDateLabel,
    setScheduleDate:setScheduleDate,
    setScheduleTime:setScheduleTime
  };
  window.MoyoPollForm={
    open:openForm,
    close:closeForm,
    reset:resetForm,
    configureCreate:configureStandaloneCreate,
    submitCreate:submitStandaloneCreate,
    getOptionType:function(){return window.globalOptionType||'TEXT';},
    setOptionType:setGlobalOptionType,
    addOption:addPollOptionRow,
    removeLastOption:removeLastPollOptionRow,
    validateScheduleRow:validateScheduleRow,
    validateAllSchedules:validateAllScheduleRows,
    serializeScheduleOption:serializeScheduleOption,
    formatScheduleOptionLabel:formatScheduleOptionLabel,
    getDeadlineDateTime:getDeadlineDateTime
  };
  if(typeof window.savePoll!=='function')window.savePoll=submitStandaloneCreate;
  window.openPollFormModal=openForm;
  window.closePollFormModal=closeForm;
  window.initializeDeadlineDefaults=function(){initializeDeadline(true);};
  window.pollDeadlineDateTime=getDeadlineDateTime;
  window.parseScheduleOptionText=parseScheduleOptionText;
  window.serializeScheduleOption=serializeScheduleOption;
  window.formatScheduleDateLabel=formatScheduleDateLabel;
  window.formatScheduleOptionLabel=formatScheduleOptionLabel;
  window.setScheduleDateValue=setScheduleDateValue;
  window.setScheduleTimeValue=setScheduleTimeValue;
  window.validateScheduleRow=validateScheduleRow;
  window.validateAllScheduleRows=validateAllScheduleRows;
  window.addPollOptionRow=addPollOptionRow;
  window.switchGlobalPollOptionType=switchGlobalPollOptionType;
  window.setGlobalOptionType=setGlobalOptionType;
  window.removeLastPollOptionRow=removeLastPollOptionRow;
  window.updateOptionRows=updateOptionRows;
  window.handlePollOptionImageChange=handlePollOptionImageChange;
  window.removePollOptionImage=removePollOptionImage;
  window.handlePollOptionAudioChange=handlePollOptionAudioChange;
  window.audioTitleFromFileName=audioTitleFromFileName;
  window.syncPollDeadlinePicker=syncDeadlineDisplay;
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
})();
</script>


