<%@ page pageEncoding="UTF-8" %>
<section class="profile-tab-section profile-tab-section--photos">

    <c:choose>
        <c:when test="${photosPublic eq 'N'}">
            <div class="profile-tab-card profile-empty-state is-private">
                <span>🔒</span>
                <strong>사진 정보를 공개하지 않았어요</strong>
                <p>공개 설정을 변경하면 프로필에 다시 표시됩니다.</p>
            </div>
        </c:when>
        <c:when test="${not empty profilePublicPhotos}">
            <div class="profile-photo-grid profile-photo-grid--clean">
                <c:forEach var="post" items="${profilePublicPhotos}">
                    <c:set var="postId" value="${empty post.postId ? post['POST_ID'] : post.postId}" />
                    <c:set var="coverPath" value="${empty post.coverPath ? post['COVER_PATH'] : post.coverPath}" />
                    <c:set var="postTitle" value="${empty post.title ? post['TITLE'] : post.title}" />
                    <c:set var="creatorName" value="${empty post.creatorName ? post['CREATOR_NAME'] : post.creatorName}" />
                    <c:set var="photoCount" value="${empty post.photoCount ? post['PHOTO_COUNT'] : post.photoCount}" />
                    <c:set var="likeCount" value="${empty post.likeCount ? post['LIKE_COUNT'] : post.likeCount}" />
                    <c:set var="commentCount" value="${empty post.commentCount ? post['COMMENT_COUNT'] : post.commentCount}" />
                    <c:set var="likedByMe" value="${empty post.likedByMe ? post['LIKED_BY_ME'] : post.likedByMe}" />
                    <c:set var="collectedByMe" value="${empty post.collectedByMe ? post['COLLECTED_BY_ME'] : post.collectedByMe}" />
                    <c:set var="postOwnerId" value="${empty post.createdBy ? post['CREATED_BY'] : post.createdBy}" />
                    <c:set var="createdAt" value="${empty post.createdAt ? post['CREATED_AT'] : post.createdAt}" />
                    <article class="profile-photo-card profile-photo-card--post profile-photo-card--square" data-open-photo-post-detail="${postId}" data-post-id="${postId}" role="button" tabindex="0" aria-label="공개 사진 상세 보기">
                        <span class="profile-photo-thumb">
                            <c:choose>
                                <c:when test="${not empty coverPath}">
                                    <c:choose>
                                        <c:when test="${fn:startsWith(coverPath, 'http')}">
                                            <img src="${coverPath}" alt="공개 사진" loading="lazy" onerror="this.closest('.profile-photo-thumb').classList.add('is-empty'); this.remove();">
                                        </c:when>
                                        <c:when test="${fn:startsWith(coverPath, '/')}">
                                            <img src="${pageContext.request.contextPath}${coverPath}" alt="공개 사진" loading="lazy" onerror="this.closest('.profile-photo-thumb').classList.add('is-empty'); this.remove();">
                                        </c:when>
                                        <c:otherwise>
                                            <img src="${pageContext.request.contextPath}/${coverPath}" alt="공개 사진" loading="lazy" onerror="this.closest('.profile-photo-thumb').classList.add('is-empty'); this.remove();">
                                        </c:otherwise>
                                    </c:choose>
                                </c:when>
                                <c:otherwise>
                                    <span class="profile-photo-fallback">📷</span>
                                </c:otherwise>
                            </c:choose>

                            <c:if test="${photoCount gt 1}">
                                <span class="profile-photo-count" aria-label="사진 ${photoCount}장"><i class="fa-regular fa-images"></i><c:out value="${photoCount}" /></span>
                            </c:if>

                            <span class="profile-photo-moyo-badge" aria-label="MOYO 공개">
                                <img src="${pageContext.request.contextPath}/brand/moyo_mark.png" alt="" loading="lazy">
                            </span>

                            <span class="profile-photo-hover" aria-hidden="true">
                                <span class="profile-photo-hover-main">
                                    <strong><c:out value="${empty creatorName ? displayName : creatorName}" /></strong>
                                    <span class="profile-photo-date"><c:out value="${createdAt}" /></span>
                                    <c:if test="${not empty postTitle}">
                                        <span class="profile-photo-sub"><c:out value="${postTitle}" /></span>
                                    </c:if>
                                    <span class="profile-photo-actions">
                                        <button type="button" class="profile-photo-action ${likedByMe eq 1 ? 'is-liked' : ''}" data-profile-photo-like="${postId}" aria-label="좋아요">
                                            <i class="fa-solid fa-heart"></i><span data-profile-photo-like-count><c:out value="${empty likeCount ? 0 : likeCount}" /></span>
                                        </button>
                                        <button type="button" class="profile-photo-action" data-profile-photo-comment="${postId}" aria-label="댓글 보기">
                                            <i class="fa-solid fa-comment"></i><span data-profile-photo-comment-count><c:out value="${empty commentCount ? 0 : commentCount}" /></span>
                                        </button>
                                        <button type="button" class="profile-photo-action" data-profile-photo-share="${postId}" aria-label="공유">
                                            <i class="fa-regular fa-paper-plane"></i>
                                        </button>
                                        <c:if test="${postOwnerId ne sessionScope.user.userId}">
                                            <button type="button" class="profile-photo-action profile-photo-action--collect ${collectedByMe eq 1 ? 'is-collected' : ''}" data-profile-photo-collect="${postId}" aria-label="담기" aria-pressed="${collectedByMe eq 1 ? 'true' : 'false'}">
                                                <i class="${collectedByMe eq 1 ? 'fa-solid' : 'fa-regular'} fa-bookmark"></i>
                                            </button>
                                        </c:if>
                                    </span>
                                </span>
                            </span>
                        </span>
                    </article>
                </c:forEach>
            </div>
        </c:when>
        <c:otherwise>
            <div class="profile-tab-card profile-empty-state">
                <span>📷</span>
                <strong>아직 공개한 사진이 없어요</strong>
                <p>MOYO에 공개한 사진이 여기에 표시됩니다.</p>
            </div>
        </c:otherwise>
    </c:choose>
</section>
