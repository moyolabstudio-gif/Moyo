<%@ page pageEncoding="UTF-8" %>
<section class="profile-tab-section profile-tab-section--calendar">

    <div data-profile-live-region="calendar">
    <c:choose>
        <c:when test="${calendarPublic eq 'N' or not calendarVisible}">
            <div class="profile-tab-card profile-empty-state is-private">
                <span>🔒</span>
                <strong>일정 정보를 공개하지 않았어요</strong>
                <p>공개 설정을 변경하면 프로필에 다시 표시됩니다.</p>
            </div>
        </c:when>
        <c:when test="${not empty profilePublicSchedules}">
            <div class="profile-tab-card profile-tab-card--list profile-calendar-card">
                <div class="profile-calendar-list">
                    <c:forEach var="event" items="${profilePublicSchedules}">
                        <c:set var="hasValidStart" value="${not empty event.startDt and fn:length(event.startDt) ge 16}" />
                        <c:set var="hasValidEnd" value="${not empty event.endDt and fn:length(event.endDt) ge 16}" />
                        <c:set var="eventStartDate" value="${hasValidStart ? fn:substring(event.startDt, 0, 10) : ''}" />
                        <c:set var="eventEndDate" value="${hasValidEnd ? fn:substring(event.endDt, 0, 10) : eventStartDate}" />
                        <c:set var="eventMultiDay" value="${hasValidStart and hasValidEnd and eventStartDate ne eventEndDate}" />
                        <c:set var="eventAllDay" value="${event.allDay eq 'Y' or (hasValidStart and hasValidEnd and fn:substring(event.startDt, 11, 16) eq '00:00' and fn:substring(event.endDt, 11, 16) eq '23:59')}" />
                        <c:url var="profileCalendarHref" value="/calendar">
                            <c:param name="scope" value="${isOwnerProfile ? 'PRIVATE' : 'FRIEND'}" />
                            <c:param name="calendarContext" value="PERSONAL" />
                            <c:if test="${not isOwnerProfile}">
                                <c:param name="friendId" value="${profileOwnerIdValue}" />
                            </c:if>
                            <c:param name="viewEventId" value="${event.id}" />
                        </c:url>
                        <a class="profile-calendar-row" href="${profileCalendarHref}" data-open-calendar-event-preview="${event.id}" data-preview-source="profile">
                            <span class="profile-calendar-date">
                                <c:choose>
                                    <c:when test="${hasValidStart}">
                                        <strong><c:out value="${fn:substring(event.startDt, 8, 10)}" /></strong>
                                        <small><c:out value="${fn:substring(event.startDt, 5, 7)}" />월</small>
                                    </c:when>
                                    <c:otherwise>
                                        <strong>--</strong>
                                        <small>일정</small>
                                    </c:otherwise>
                                </c:choose>
                            </span>
                            <span class="profile-calendar-text">
                                <strong><c:out value="${empty event.title ? '제목 없는 일정' : event.title}" /></strong>
                                <small>
                                    <c:choose>
                                        <c:when test="${not hasValidStart}">시간 정보 없음</c:when>
                                        <c:when test="${eventMultiDay and eventAllDay}">
                                            <c:out value="${fn:substring(event.startDt, 5, 10)}" /> - <c:out value="${fn:substring(event.endDt, 5, 10)}" /> · 종일
                                        </c:when>
                                        <c:when test="${eventMultiDay}">
                                            <c:out value="${fn:substring(event.startDt, 5, 10)}" /> <c:out value="${fn:substring(event.startDt, 11, 16)}" />
                                            - <c:out value="${fn:substring(event.endDt, 5, 10)}" /> <c:out value="${fn:substring(event.endDt, 11, 16)}" />
                                        </c:when>
                                        <c:when test="${eventAllDay}">종일</c:when>
                                        <c:otherwise>
                                            <c:out value="${fn:substring(event.startDt, 11, 16)}" />
                                            <c:if test="${hasValidEnd}"> - <c:out value="${fn:substring(event.endDt, 11, 16)}" /></c:if>
                                        </c:otherwise>
                                    </c:choose>
                                    <c:if test="${event.isRecurring eq 'Y'}"> · 반복</c:if>
                                    <c:if test="${event.isLunar eq 'Y'}"> · 음력</c:if>
                                    <c:if test="${event.recordEnabledYn eq 'Y'}"> · 기록</c:if>
                                </small>
                            </span>
                            <span class="profile-calendar-link">보기</span>
                        </a>
                    </c:forEach>
                </div>
            </div>
        </c:when>
        <c:otherwise>
            <div class="profile-tab-card profile-empty-state">
                <span>📅</span>
                <strong>공개된 일정이 없어요</strong>
                <p>MOYO에 공개한 일정이 있으면 여기에 표시됩니다.</p>
            </div>
        </c:otherwise>
    </c:choose>
    </div>
</section>
