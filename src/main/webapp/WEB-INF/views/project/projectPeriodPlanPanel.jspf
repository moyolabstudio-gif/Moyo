<%@ page pageEncoding="UTF-8" %>
<section id="ganttPlanPanel" class="project-plan-panel" data-plan-panel="GANTT" hidden>
    <div class="project-timeline-header">
        <div class="project-timeline-title-wrap">
            <h3>기간별 계획</h3>
            <p>여러 날에 걸친 큰 흐름을 날짜별로 정리합니다.</p>
        </div>
        <div class="project-plan-header-actions">
        <c:if test="${isPersonalProject or canManageProject eq true}">
            <div class="project-plan-scale-control">
                <button type="button" id="ganttScaleButton" class="project-plan-settings-btn"
                        onclick="toggleGanttScaleMenu(event)" aria-haspopup="menu" aria-expanded="false"
                        aria-label="기간별 계획 표시 단위 변경">
                    <span id="ganttScaleButtonLabel">일 단위</span>
                    <i class="fa-solid fa-chevron-down project-plan-settings-chevron" aria-hidden="true"></i>
                </button>
                <div id="ganttScaleMenu" class="project-plan-scale-menu" role="menu" hidden>
                    <button type="button" role="menuitemradio" data-gantt-scale="DAY" onclick="changeGanttScale('DAY')">일 단위</button>
                    <button type="button" role="menuitemradio" data-gantt-scale="WEEK" onclick="changeGanttScale('WEEK')">주 단위</button>
                    <button type="button" role="menuitemradio" data-gantt-scale="MONTH" onclick="changeGanttScale('MONTH')">월 단위</button>
                </div>
            </div>
        </c:if>
            <label class="project-plan-calendar-toggle" for="showPeriodPlanOnCalendar">
                <input type="checkbox" id="showPeriodPlanOnCalendar" onchange="saveSingleProjectPlanCalendarPref('PERIOD', this.checked)">
                <span>달력에 표시</span>
            </label>
        </div>
    </div>
    <div id="projectGanttPreview" class="gantt-box" aria-live="polite" aria-busy="true">
        <div class="gantt-empty">기간별 계획을 불러오는 중...</div>
    </div>
</section>
