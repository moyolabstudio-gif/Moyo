<%@ page pageEncoding="UTF-8" %>
<section id="timeSchedulePanel" class="project-plan-panel" data-plan-panel="TIME_SCHEDULE" hidden>
    <div class="project-timeline-header time-plan-header">
        <div class="project-timeline-title-wrap time-plan-header__copy">
            <h3>시간별 계획표</h3>
            <p>여행이나 행사처럼 특정 날짜의 일정을 시간순으로 정리합니다.</p>
        </div>
        <div class="project-plan-header-actions time-plan-header__actions">
            <span id="timePlanRangeSummary" class="time-plan-range-summary" hidden></span>
            <c:if test="${isPersonalProject or canManageProject eq true}">
                <button type="button" id="timePlanRangeBtn" onclick="openTimePlanRangeModal()" class="project-plan-secondary-btn time-plan-range-btn" hidden>
                    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                    <span>기간 설정</span>
                </button>
            </c:if>
            <label class="project-plan-calendar-toggle" for="showTimeScheduleDawn">
                <input type="checkbox" id="showTimeScheduleDawn" onchange="saveTimeScheduleDawnPreference(this.checked)">
                <span>새벽 시간 보기</span>
            </label>
            <label class="project-plan-calendar-toggle" for="showTimePlanOnCalendar">
                <input type="checkbox" id="showTimePlanOnCalendar" onchange="saveSingleProjectPlanCalendarPref('TIME', this.checked)">
                <span>달력에 표시</span>
            </label>
        </div>
    </div>
    <div id="projectTimeSchedulePreview" class="gantt-box time-schedule-mode" aria-live="polite" aria-busy="true">
        <div class="gantt-empty">시간별 계획표를 불러오는 중...</div>
    </div>
</section>
