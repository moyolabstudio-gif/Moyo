<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.springboot.project.dao.IcsDAO">

    <select id="findCsByUserId" resultType="com.springboot.project.dto.csDTO">
        SELECT 
            CS_ID AS csId,
            USER_ID AS userId,
            EXT_KEY AS extKey,
            CS_STATUS AS csStatus
        FROM CS_LOGS
        WHERE USER_ID = #{userId}
        ORDER BY CS_ID DESC
    </select>

</mapper>
