<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context"
                    name="LOG_DIR"
                    source="moyo.log.dir"
                    defaultValue="C:/MoyoLab.Studio/logs"/>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}:%-3relative] [%thread] %-5level %logger{48} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Local: 개발 콘솔 + 보안 감사 로그를 확실히 콘솔에 출력 -->
    <springProfile name="local">
        <logger name="com.springboot.project" level="INFO"/>

        <logger name="com.springboot.project.config.security.SecurityAuditLogger"
                level="INFO"
                additivity="false">
            <appender-ref ref="console"/>
        </logger>

        <logger name="com.springboot.project.service.EmailVerificationService"
                level="ERROR"
                additivity="false">
            <appender-ref ref="console"/>
        </logger>

        <logger name="jdbc" level="OFF"/>
        <logger name="jdbc.sqlonly" level="OFF"/>
        <logger name="jdbc.sqltiming" level="DEBUG"/>
        <logger name="jdbc.resultset" level="OFF"/>
        <logger name="jdbc.resultsettable" level="DEBUG"/>
        <logger name="jdbc.connection" level="OFF"/>

        <root level="OFF">
            <appender-ref ref="console"/>
        </root>
    </springProfile>

    <!-- Production: SQL 디버그 차단 + 일반 로그/보안 감사 로그 파일 분리 -->
    <springProfile name="prod">

        <appender name="rollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/moyo.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/moyo.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>20MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%thread] %-5level %logger{48} - %msg%n</pattern>
            </encoder>
        </appender>

        <appender name="securityAuditFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/security-audit.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/security-audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>20MB</maxFileSize>
                <maxHistory>90</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] %-5level %msg%n</pattern>
            </encoder>
        </appender>

        <logger name="com.springboot.project" level="INFO"/>

        <logger name="com.springboot.project.config.security.SecurityAuditLogger"
                level="INFO"
                additivity="false">
            <appender-ref ref="securityAuditFile"/>
        </logger>

        <logger name="jdbc" level="OFF"/>
        <logger name="jdbc.sqlonly" level="OFF"/>
        <logger name="jdbc.sqltiming" level="OFF"/>
        <logger name="jdbc.resultset" level="OFF"/>
        <logger name="jdbc.resultsettable" level="OFF"/>
        <logger name="jdbc.connection" level="OFF"/>

        <root level="WARN">
            <appender-ref ref="console"/>
            <appender-ref ref="rollingFile"/>
        </root>
    </springProfile>

</configuration>
