# Copy this file to:
#   config/application-local-secret.properties
# The copied file is ignored by Git.
#
# You may alternatively set the equivalent MOYO_* environment variables.

spring.datasource.password=YOUR_LOCAL_DB_PASSWORD

# Optional local SMTP settings:
# spring.mail.username=YOUR_LOCAL_SMTP_ACCOUNT
# spring.mail.password=YOUR_LOCAL_SMTP_APP_PASSWORD
# moyo.mail.from=YOUR_FROM_ADDRESS

# Public Data Portal holiday API key
moyo.calendar.holiday-service-key=YOUR_HOLIDAY_SERVICE_KEY
